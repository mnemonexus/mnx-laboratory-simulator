{
  "format": "lab-experiment",
  "formatVersion": "0.1",
  "id": "chem19-acid-base-titration",
  "version": "1.0.0",
  "title": "{{title}}",
  "language": "en-GB",
  "requires": {
    "framework": ">=0.1",
    "capabilities": [
      {
        "technique": "core:titrate-to-endpoint"
      },
      {
        "technique": "core:prepare-burette"
      }
    ]
  },
  "summary": "{{summary}}",
  "briefing": "Rinse and fill the burette, pipette 25.0 mL of the sample into a conical flask, add three drops of {{indicatorName}}, and titrate until {{endDescription}}. A rough titration shows where the end point is; then titrate accurately, dropwise near the end, until at least two titres agree within 0.10 mL, and average the titres that agree. {{ratioNote}}",
  "context": {
    "intendedContexts": [
      "practical-session",
      "lecture-introduction",
      "assessment"
    ],
    "audience": {
      "level": "{{level}}",
      "disciplines": [
        "chemistry"
      ]
    },
    "keywords": [
      "titration",
      "burette",
      "pipette",
      "indicator",
      "neutralisation",
      "end point",
      "volumetric analysis"
    ],
    "topics": [
      "Titration",
      "Acids and bases"
    ],
    "concepts": [
      {
        "id": "equivalence",
        "label": "Equivalence point and end point"
      },
      {
        "id": "indicators",
        "label": "Choosing an indicator"
      },
      {
        "id": "concordance",
        "label": "Concordant titres"
      }
    ],
    "objectives": [
      {
        "id": "o-burette",
        "kind": "skill",
        "statement": "Fill, read and use a burette to a dropwise end point",
        "skills": [
          "core:burette-technique",
          "core:titration"
        ]
      },
      {
        "id": "o-pipette",
        "kind": "skill",
        "statement": "Measure an aliquot with a volumetric pipette"
      },
      {
        "id": "o-dilute",
        "kind": "skill",
        "statement": "Dilute a sample accurately in a volumetric flask"
      },
      {
        "id": "o-conc",
        "kind": "analysis",
        "statement": "Calculate the sample's concentration from concordant titres",
        "goal": "g-conc"
      },
      {
        "id": "o-indicator",
        "kind": "reasoning",
        "statement": "Explain the choice of indicator",
        "goal": "g-indicator"
      }
    ],
    "curricula": [
      "GCSE",
      "A level",
      "IB",
      "AP",
      "BTEC",
      "T Level"
    ]
  },
  "parameters": {
    "title": {
      "default": "Titrating a strong acid with a strong base"
    },
    "summary": {
      "default": "Find the concentration of hydrochloric acid by titration with standard sodium hydroxide, using phenolphthalein."
    },
    "level": {
      "default": "ages-14-16"
    },
    "analyte": {
      "default": "core:hydrochloric-acid"
    },
    "analyteLabel": {
      "default": "Hydrochloric acid, about 0.1 M"
    },
    "analyteConc": {
      "default": "0.085..0.115 mol/L"
    },
    "titrantSubstance": {
      "default": "core:sodium-hydroxide"
    },
    "titrantName": {
      "default": "sodium hydroxide"
    },
    "titrantLabel": {
      "default": "Sodium hydroxide, 0.1000 M (standard)"
    },
    "titrantConc": {
      "default": "0.1000 mol/L"
    },
    "indicatorPrep": {
      "default": "core:phenolphthalein-indicator"
    },
    "indicatorName": {
      "default": "phenolphthalein"
    },
    "endColour": {
      "default": "pink"
    },
    "endDescription": {
      "default": "the indicator just turns pink"
    },
    "ratio": {
      "default": 1,
      "description": "Moles of titrant per mole of the sample's acid or base"
    },
    "ratioNote": {
      "default": "Hydrochloric acid and sodium hydroxide react 1 : 1."
    },
    "dilution": {
      "default": 1
    },
    "indicatorReason": {
      "default": "any"
    },
    "watch": {
      "default": "solution"
    },
    "indicatorOptions": {
      "default": [
        {
          "id": "basic-end",
          "label": "The equivalence point is alkaline (the salt of a weak acid), and it changes colour between pH 8 and 10"
        },
        {
          "id": "acidic-end",
          "label": "The equivalence point is acidic (the salt of a weak base), and it changes colour between pH 3 and 4.5"
        },
        {
          "id": "any",
          "label": "The pH changes very steeply through both indicators' ranges at the equivalence point, so either would do"
        }
      ]
    }
  },
  "materials": {
    "supplies": [
      {
        "id": "sample",
        "label": "{{analyteLabel}}",
        "contains": [
          {
            "substance": "{{analyte}}",
            "conc": {
              "vary": "{{analyteConc}}"
            }
          }
        ],
        "solvent": "core:water",
        "amount": "250 mL",
        "container": "core:reagent-bottle-250ml"
      },
      {
        "id": "titrant",
        "label": "{{titrantLabel}}",
        "contains": [
          {
            "substance": "{{titrantSubstance}}",
            "conc": "{{titrantConc}}"
          }
        ],
        "solvent": "core:water",
        "amount": "500 mL",
        "container": "core:reagent-bottle-1l"
      },
      {
        "id": "indicator",
        "label": "{{indicatorName}} indicator",
        "preparation": "{{indicatorPrep}}",
        "amount": "10 mL",
        "container": "core:conical-tube-15ml"
      },
      {
        "id": "water",
        "label": "Deionised water",
        "preparation": "core:water-deionised",
        "amount": "1 L",
        "container": "core:reagent-bottle-1l"
      }
    ]
  },
  "equipment": {
    "roles": [
      {
        "id": "burette",
        "requires": {
          "class": "core:burette-50ml-class-a"
        }
      },
      {
        "id": "pipette25",
        "requires": {
          "class": "core:volumetric-pipette-25ml"
        }
      }
    ]
  },
  "procedure": {
    "fidelity": "prescribed-tolerant",
    "steps": [
      {
        "id": "fill",
        "kind": "technique",
        "ref": "core:prepare-burette",
        "title": "Fill the burette with {{titrantName}}",
        "params": {
          "burette": "burette",
          "titrant": "titrant",
          "volume": "48 mL"
        },
        "objectives": [
          "o-burette"
        ]
      },
      {
        "id": "dilute",
        "kind": "group",
        "title": "Dilute the sample {{dilution}} times",
        "when": "{{dilution}} > 1",
        "objectives": [
          "o-dilute"
        ],
        "steps": [
          {
            "id": "flask",
            "kind": "operation",
            "ref": "core:fetch",
            "params": {
              "equipment": "core:volumetric-flask-250ml",
              "id": "diluted",
              "label": "Diluted sample"
            }
          },
          {
            "id": "portion",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "sample",
              "destination": "diluted",
              "volume": "=250 mL / {{dilution}}",
              "tool": "pipette25"
            }
          },
          {
            "id": "make-up",
            "kind": "operation",
            "ref": "core:make-up-to-mark",
            "params": {
              "container": "diluted",
              "solvent": "water"
            }
          },
          {
            "id": "stopper",
            "kind": "operation",
            "ref": "core:close",
            "params": {
              "container": "diluted"
            }
          },
          {
            "id": "invert",
            "kind": "operation",
            "ref": "core:mix",
            "params": {
              "container": "diluted",
              "method": "invert",
              "cycles": 10
            }
          },
          {
            "id": "unstopper",
            "kind": "operation",
            "ref": "core:open",
            "params": {
              "container": "diluted"
            }
          }
        ]
      },
      {
        "id": "rough",
        "kind": "group",
        "title": "Rough titration",
        "steps": [
          {
            "id": "rough-flask",
            "kind": "operation",
            "ref": "core:fetch",
            "params": {
              "equipment": "core:conical-flask-250ml",
              "id": "flask-rough",
              "label": "Rough"
            }
          },
          {
            "id": "rough-aliquot",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "=if({{dilution}} > 1, 'diluted', 'sample')",
              "destination": "flask-rough",
              "volume": "25 mL",
              "tool": "pipette25"
            }
          },
          {
            "id": "rough-indicator",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "indicator",
              "destination": "flask-rough",
              "volume": "100 uL"
            }
          },
          {
            "id": "rough-start",
            "kind": "operation",
            "ref": "core:read-volume",
            "params": {
              "container": "burette"
            }
          },
          {
            "id": "rough-titrate",
            "kind": "technique",
            "ref": "core:titrate-to-endpoint",
            "params": {
              "burette": "burette",
              "flask": "flask-rough",
              "endColour": "{{endColour}}",
              "watch": "{{watch}}"
            }
          },
          {
            "id": "rough-end",
            "kind": "operation",
            "ref": "core:read-volume",
            "params": {
              "container": "burette"
            }
          },
          {
            "id": "rough-titre",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "rough-titre",
              "value": "=quantity(rough-end.out.value) - quantity(rough-start.out.value)"
            }
          }
        ]
      },
      {
        "id": "accurate",
        "kind": "group",
        "title": "Three accurate titrations",
        "forEach": {
          "var": "n",
          "in": "=[1, 2, 3]"
        },
        "let": {
          "flask": "='flask-' + text(n)"
        },
        "steps": [
          {
            "id": "get-flask",
            "kind": "operation",
            "ref": "core:fetch",
            "params": {
              "equipment": "core:conical-flask-250ml",
              "id": "=flask",
              "label": "='Titration ' + text(count(recorded('titre')) + 1)"
            }
          },
          {
            "id": "aliquot",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "=if({{dilution}} > 1, 'diluted', 'sample')",
              "destination": "=flask",
              "volume": "25 mL",
              "tool": "pipette25"
            },
            "objectives": [
              "o-pipette"
            ]
          },
          {
            "id": "indicator-in",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "indicator",
              "destination": "=flask",
              "volume": "100 uL"
            }
          },
          {
            "id": "refill",
            "kind": "technique",
            "ref": "core:prepare-burette",
            "when": "volume(burette) < 30 mL",
            "params": {
              "burette": "burette",
              "titrant": "titrant",
              "volume": "=48 mL - volume(burette)"
            }
          },
          {
            "id": "start",
            "kind": "operation",
            "ref": "core:read-volume",
            "params": {
              "container": "burette"
            }
          },
          {
            "id": "titrate",
            "kind": "technique",
            "ref": "core:titrate-to-endpoint",
            "objectives": [
              "o-burette"
            ],
            "params": {
              "burette": "burette",
              "flask": "=flask",
              "endColour": "{{endColour}}",
              "watch": "{{watch}}",
              "approx": "=first(recorded('rough-titre'))"
            }
          },
          {
            "id": "end",
            "kind": "operation",
            "ref": "core:read-volume",
            "params": {
              "container": "burette"
            }
          },
          {
            "id": "titre",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "titre",
              "value": "=quantity(end.out.value) - quantity(start.out.value)"
            }
          }
        ]
      },
      {
        "id": "extra",
        "kind": "group",
        "title": "More titrations until two agree within 0.10 mL",
        "when": "!concordant(recorded('titre'), 0.10 mL, 2)",
        "repeat": {
          "until": "concordant(recorded('titre'), 0.10 mL, 2)",
          "max": 3
        },
        "let": {
          "flask": "='flask-' + text(count(recorded('titre')) + 1)"
        },
        "steps": [
          {
            "id": "x-get-flask",
            "kind": "operation",
            "ref": "core:fetch",
            "params": {
              "equipment": "core:conical-flask-250ml",
              "id": "=flask",
              "label": "='Titration ' + text(count(recorded('titre')) + 1)"
            }
          },
          {
            "id": "x-aliquot",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "=if({{dilution}} > 1, 'diluted', 'sample')",
              "destination": "=flask",
              "volume": "25 mL",
              "tool": "pipette25"
            },
            "objectives": [
              "o-pipette"
            ]
          },
          {
            "id": "x-indicator-in",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "indicator",
              "destination": "=flask",
              "volume": "100 uL"
            }
          },
          {
            "id": "x-refill",
            "kind": "technique",
            "ref": "core:prepare-burette",
            "when": "volume(burette) < 30 mL",
            "params": {
              "burette": "burette",
              "titrant": "titrant",
              "volume": "=48 mL - volume(burette)"
            }
          },
          {
            "id": "x-start",
            "kind": "operation",
            "ref": "core:read-volume",
            "params": {
              "container": "burette"
            }
          },
          {
            "id": "x-titrate",
            "kind": "technique",
            "ref": "core:titrate-to-endpoint",
            "objectives": [
              "o-burette"
            ],
            "params": {
              "burette": "burette",
              "flask": "=flask",
              "endColour": "{{endColour}}",
              "watch": "{{watch}}",
              "approx": "=first(recorded('rough-titre'))"
            }
          },
          {
            "id": "x-end",
            "kind": "operation",
            "ref": "core:read-volume",
            "params": {
              "container": "burette"
            }
          },
          {
            "id": "x-titre",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "titre",
              "value": "=quantity(x-end.out.value) - quantity(x-start.out.value)"
            }
          }
        ]
      },
      {
        "id": "mean-titre",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "mean-titre",
          "value": "=concordantMean(recorded('titre'), 0.10 mL, 2)"
        },
        "objectives": [
          "o-conc"
        ]
      },
      {
        "id": "report",
        "kind": "operation",
        "ref": "core:compute",
        "title": "The sample's concentration",
        "objectives": [
          "o-conc"
        ],
        "params": {
          "expression": "c * t / ratio / v * d",
          "values": {
            "c": "{{titrantConc}}",
            "t": "=first(recorded('mean-titre'))",
            "ratio": "{{ratio}}",
            "v": "25 mL",
            "d": "{{dilution}}"
          },
          "field": "conc",
          "report": {
            "quantity": "conc",
            "sample": "sample"
          }
        }
      },
      {
        "id": "indicator-choice",
        "kind": "decision",
        "objectives": [
          "o-indicator"
        ],
        "prompt": "Why is {{indicatorName}} a suitable indicator here?",
        "options": "{{indicatorOptions}}",
        "correctWhen": "'{{indicatorReason}}'"
      }
    ]
  },
  "goals": {
    "predicates": [
      {
        "id": "g-conc",
        "statement": "The sample's concentration is within 1 % of the truth",
        "check": "within(reported(conc, 'sample'), truth(conc, 'sample', '{{analyte}}'), 1%)"
      },
      {
        "id": "g-concordant",
        "statement": "At least two titres agree within 0.10 mL",
        "check": "concordant(recorded('titre'), 0.10 mL, 2)"
      },
      {
        "id": "g-indicator",
        "statement": "The indicator choice is explained",
        "check": "decision('indicator-choice') == '{{indicatorReason}}'"
      }
    ],
    "expectedObservations": [
      {
        "id": "e-end",
        "statement": "Each accurate titration stops at the first permanent end-point colour",
        "check": "all(n in [1, 2, 3]: if('{{watch}}' == 'precipitate', mentions(precipitateColour('flask-' + text(n)), '{{endColour}}'), colour('flask-' + text(n)) == '{{endColour}}'))",
        "source": "reference-standard"
      },
      {
        "id": "e-titre",
        "statement": "Titres are between 10 and 40 mL",
        "check": "all(recorded('titre'), it > 10 mL && it < 40 mL)",
        "source": "simulation-derived"
      }
    ]
  },
  "variants": [
    {
