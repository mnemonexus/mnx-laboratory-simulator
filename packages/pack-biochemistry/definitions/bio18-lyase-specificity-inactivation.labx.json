{
  "format": "lab-experiment",
  "formatVersion": "0.1",
  "id": "bio18-lyase-specificity-inactivation",
  "version": "1.0.0",
  "title": "A body-odour enzyme: substrate preference and a time-dependent inhibitor",
  "language": "en-GB",
  "requires": {
    "framework": ">=0.1",
    "capabilities": [
      {
        "operation": "core:measure"
      },
      {
        "operation": "core:fit"
      }
    ]
  },
  "summary": "Follow a skin bacterium's C-S β-lyase with Ellman's reagent: Michaelis–Menten series on two S-substituted cysteines give each one's kcat/Km, and pre-incubating the enzyme with L-cycloserine shows activity lost with time.",
  "briefing": "The lyase cleaves S-substituted cysteines to pyruvate, ammonia and a thiol; the thiol cuts DTNB to yellow TNB²⁻ (ε412 = 14,150 M⁻¹cm⁻¹), so ΔA412 per minute over 14,150 is the rate in M/min. kcat = Vmax / [E] (0.125 µM in each assay) and kcat/Km measures how well the enzyme uses a substrate at low concentration. For cycloserine, pre-incubate the enzyme with it, then dilute samples twenty-fold into assays: the cycloserine left is too little to compete, so any loss is enzyme that has been inactivated.",
  "context": {
    "intendedContexts": [
      "practical-session",
      "transferal"
    ],
    "audience": {
      "level": "undergraduate-1",
      "disciplines": [
        "biochemistry"
      ]
    },
    "concepts": [
      {
        "id": "specificity-constant",
        "label": "kcat/Km as a measure of substrate preference"
      },
      {
        "id": "mechanism-based",
        "label": "Time-dependent (mechanism-based) inactivation"
      },
      {
        "id": "ellman",
        "label": "Ellman's assay for thiols"
      }
    ],
    "objectives": [
      {
        "id": "o-kinetics",
        "kind": "skill",
        "statement": "Measure initial rates across a concentration range and fit Km and kcat",
        "skills": [
          "core:micropipetting"
        ],
        "goal": "g-kinetics"
      },
      {
        "id": "o-inhibitor",
        "kind": "skill",
        "statement": "Run a pre-incubation experiment and find the inactivation rate",
        "skills": [
          "core:micropipetting"
        ]
      },
      {
        "id": "o-interpret",
        "kind": "reasoning",
        "statement": "Compare specificity constants and distinguish inactivation from reversible inhibition",
        "goal": "g-interpret"
      }
    ]
  },
  "materials": {
    "supplies": [
      {
        "id": "patb",
        "label": "Lyase (His6-ShPatB), 2.5 µM",
        "preparation": "bio:tris-nacl-ph8",
        "contains": [
          {
            "substance": "bio:his-patb",
            "conc": "2.5 uM"
          }
        ],
        "amount": "1.5 mL",
        "container": "core:microtube-2ml",
        "storage": "0 Cel"
      },
      {
        "id": "dtnb",
        "label": "DTNB, 4 mM",
        "preparation": "bio:tris-nacl-ph8",
        "contains": [
          {
            "substance": "bio:dtnb",
            "conc": "4 mM"
          }
        ],
        "amount": "10 mL",
        "container": "core:conical-tube-15ml"
      },
      {
        "id": "buffer",
        "label": "50 mM Tris-HCl pH 8.0, 50 mM NaCl",
        "preparation": "bio:tris-nacl-ph8",
        "amount": "30 mL",
        "container": "core:conical-tube-50ml"
      },
      {
        "id": "s-benzyl",
        "label": "S-Benzyl-L-cysteine, 10 mM",
        "preparation": "bio:tris-nacl-ph8",
        "contains": [
          {
            "substance": "bio:s-benzyl-l-cysteine",
            "conc": "10 mM"
          }
        ],
        "amount": "5 mL",
        "container": "core:conical-tube-15ml"
      },
      {
        "id": "s-ethyl",
        "label": "S-Ethyl-L-cysteine, 10 mM",
        "preparation": "bio:tris-nacl-ph8",
        "contains": [
          {
            "substance": "bio:s-ethyl-l-cysteine",
            "conc": "10 mM"
          }
        ],
        "amount": "5 mL",
        "container": "core:conical-tube-15ml"
      },
      {
        "id": "cycloserine",
        "label": "L-Cycloserine, 10 mM",
        "preparation": "bio:tris-nacl-ph8",
        "contains": [
          {
            "substance": "bio:l-cycloserine",
            "conc": "10 mM"
          }
        ],
        "amount": "1 mL",
        "container": "core:microtube-1.5ml"
      }
    ]
  },
  "equipment": {
    "roles": [
      {
        "id": "spec",
        "requires": {
          "class": "core:spectrophotometer.visible-single-beam"
