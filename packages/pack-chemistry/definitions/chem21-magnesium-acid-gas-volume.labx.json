    {
      "id": "chem21-molar-volume",
      "title": "The molar volume of a gas",
      "summary": "React weighed pieces of magnesium ribbon with excess acid, collect the hydrogen in a gas syringe and find the volume one mole of gas occupies from the gradient of volume against moles.",
      "briefing": "Each mole of magnesium gives one mole of hydrogen. Weigh three different masses of ribbon by difference, let each react completely, and read the final volume. The gradient of volume against moles of magnesium is the molar volume, about 24 L/mol at room temperature and pressure.",
      "curricula": [
        "GCSE",
        "A level",
        "IB"
      ],
      "values": {
        "runs": "=[['a', 'Flask: 0.030 g magnesium', 'hcl', 50, 0, 0, 0.03], ['b', 'Flask: 0.050 g magnesium', 'hcl', 50, 0, 0, 0.05], ['c', 'Flask: 0.070 g magnesium', 'hcl', 50, 0, 0, 0.07]]",
        "solid": "mg",
        "analysis": [
          {
            "id": "line",
            "kind": "operation",
            "ref": "core:fit",
            "params": {
              "x": "=map(['a', 'b', 'c'], value(first(recorded('mass-' + it)), 'g') / 24.305)",
              "y": "=map(['a', 'b', 'c'], mean(slice(recorded('V-' + it), -4)))",
              "model": "linear",
              "xLabel": "magnesium / mol"
            }
          },
          {
            "id": "vm",
            "kind": "operation",
            "ref": "core:compute",
            "params": {
              "expression": "g / 1000",
              "values": {
                "g": "=line.out.fit.params.slope"
              },
