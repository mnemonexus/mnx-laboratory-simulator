    "skills": [
      "core:incubate"
    ]
  },
  {
    "id": "core:standard-curve-analysis",
    "version": 1,
    "status": "experimental",
    "label": "Standard-curve analysis",
    "mode": "data",
    "description": "Subtract the blank, average replicates, fit the standards, and read the unknowns from the fit (corrected for dilution), flagging any outside the calibrated range.",
    "purposes": [
      "analyse-data.calibration",
      "analyse.protein-concentration",
      "analyse.concentration"
    ],
    "params": {
      "reading": {
        "type": "any",
        "required": true,
        "description": "The plate-read measurement record"
      },
      "layout": {
        "type": "record",
        "required": true
      },
      "standards": {
        "type": "text",
        "required": true,
        "description": "The layout group holding the standards"
      },
      "standardConcs": {
        "type": "list",
        "items": {
          "type": "quantity"
        },
        "required": true
      },
      "unknowns": {
        "type": "list",
        "items": {
          "type": "text"
        },
        "required": true,
        "description": "The layout groups to read from the fit: give each unknown its own group"
      },
      "model": {
        "type": "enum",
        "values": [
          "linear",
          "quadratic"
        ],
        "default": "linear"
      },
      "factors": {
        "type": "record",
        "description": "Dilution factor per layout group (default 1)"
      }
    },
    "steps": [
      {
        "id": "corr",
        "kind": "operation",
        "ref": "core:transform",
        "params": {
          "op": "blank-subtract",
          "input": "=reading",
          "layout": "=layout"
        }
      },
      {
        "id": "avg",
        "kind": "operation",
        "ref": "core:transform",
        "params": {
          "op": "average-replicates",
          "input": "=corr.out.values",
          "layout": "=layout"
        }
      },
      {
        "id": "fit",
        "kind": "operation",
        "ref": "core:fit",
        "params": {
          "x": "=standardConcs",
          "y": "=map(filter(avg.out.groups, group == standards), mean)",
          "model": "=model"
        }
      },
      {
        "id": "interp",
        "kind": "operation",
        "ref": "core:interpolate",
        "params": {
          "fit": "=fit.out.fit",
          "points": "=filter(avg.out.groups, group in unknowns)",
          "factors": "=factors"
        }
      }
    ],
    "outputs": {
      "fit": "=fit.out.fit",
      "results": "=interp.out.results"
    },
    "quality": [
      {
        "id": "blank-used",
        "statement": "The blank was subtracted",
        "check": "corr.out.blankCount > 0",
        "severity": "major",
        "skills": [
          "core:calibration-analysis"
        ],
        "feedbackKind": "measurement"
      },
      {
        "id": "unknowns-found",
        "statement": "Every unknown named was found on the plate",
        "check": "all(u in unknowns: exists(r in interp.out.results: r.group == u))",
        "severity": "major",
        "skills": [
          "core:calibration-analysis"
        ],
        "feedbackKind": "measurement"
      }
    ],
    "skills": [
      "core:standard-curve-analysis",
      "core:calibration-analysis",
      "core:calibration-range"
    ]
  },
  {
    "id": "core:dispose-to-waste",
