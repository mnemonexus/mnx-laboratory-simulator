  "goals": {
    "predicates": [
      {
        "id": "g-shift",
        "statement": "Concentrated acid turns the red-pink solution blue and water turns it pink again; the hot tube is blue and the cold one pink",
        "check": "mentions(first(recorded('start')), 'red') && mentions(first(recorded('with acid')), 'blue') && mentions(first(recorded('with water')), 'pink') && mentions(first(recorded('hot')), 'blue') && mentions(first(recorded('cold')), 'pink')"
      },
      {
        "id": "g-explain",
        "statement": "The sign of ΔH is deduced",
        "check": "decision('why') == 'endo'"
      }
    ],
    "expectedObservations": [
      {
        "id": "e-room",
        "statement": "At room temperature the mixture is in between (violet or purple)",
        "check": "!mentions(first(recorded('room temperature')), 'pink') || mentions(first(recorded('room temperature')), 'violet') || mentions(first(recorded('room temperature')), 'purple')",
        "source": "reference-standard"
      }
