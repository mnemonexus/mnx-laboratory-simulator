{
  "format": "lab-experiment",
  "formatVersion": "0.1",
  "id": "chem27-gravimetry",
  "version": "1.0.0",
  "title": "Preparing an insoluble salt: barium sulfate",
  "language": "en-GB",
  "requires": {
    "framework": ">=0.1",
    "capabilities": [
      {
        "operation": "core:filter"
      },
      {
        "operation": "core:weigh"
      }
    ]
  },
  "summary": "Mix sodium sulfate with excess barium chloride, filter off the white barium sulfate, wash it, dry it and weigh it, and work out the percentage yield (in duplicate).",
  "briefing": "Ba²⁺ + SO₄²⁻ → BaSO₄(s). Barium sulfate is so insoluble that nearly all the sulfate comes out. Filter it through a weighed filter, rinse the beaker onto the filter three times so that none is left behind and the dissolved sodium and barium chlorides are washed out, dry it and weigh it on the filter. 25 mL of 0.100 M sulfate gives at most 2.50 mmol (0.583 g).",
  "context": {
    "intendedContexts": [
      "practical-session",
      "lecture-introduction",
      "assessment"
    ],
    "audience": {
      "level": "{{level}}",
      "disciplines": [
        "chemistry"
      ]
    },
    "keywords": "{{keywords}}",
    "topics": [
      "Salts",
      "Chemical analysis"
    ],
    "curricula": [
      "GCSE",
      "A level",
      "IB",
      "BTEC"
    ],
    "concepts": [
      {
        "id": "gravimetry",
        "label": "Precipitation, filtration and weighing"
      }
    ],
    "objectives": "{{objectives}}"
  },
  "parameters": {
    "sample": {
      "default": {
        "id": "sample",
        "label": "Sodium sulfate, 0.100 M",
        "contains": [
          {
            "substance": "aq:sodium-sulfate",
            "conc": "0.100 mol/L"
          }
        ],
        "solvent": "core:water",
        "amount": "250 mL",
        "container": "core:reagent-bottle-1l"
      }
    },
    "reagent": {
      "default": {
        "id": "reagent",
        "label": "Barium chloride, 0.20 M",
        "contains": [
          {
            "substance": "aq:barium-chloride",
            "conc": "0.20 mol/L"
          }
        ],
        "solvent": "core:water",
        "amount": "250 mL",
        "container": "core:reagent-bottle-1l"
      }
    },
    "acid": {
      "default": {
        "id": "acid",
        "label": "Hydrochloric acid, 1 M",
        "contains": [
          {
            "substance": "aq:hydrochloric-acid",
            "conc": "1 mol/L"
          }
        ],
        "solvent": "core:water",
        "amount": "100 mL",
        "container": "core:reagent-bottle-1l"
      }
    },
    "reagentVolume": {
      "default": "20 mL"
    },
    "molarMass": {
      "default": 233.39
    },
    "analysis": {
      "default": [
        {
          "id": "yield",
          "kind": "operation",
          "ref": "core:compute",
          "params": {
            "expression": "100 * m / (0.0025 * 233.39)",
            "values": {
              "m": "=(first(recorded('mass-a')) + first(recorded('mass-b'))) / 2"
            },
            "field": "yield-percent"
          },
          "objectives": [
            "o-yield"
          ]
        },
        {
          "id": "why-wash",
          "kind": "decision",
          "objectives": [
            "o-explain"
          ],
          "prompt": "Why is the precipitate washed with water before it is dried?",
          "options": [
            {
              "id": "soluble",
              "label": "To rinse away the dissolved salts left in the wet precipitate, which would otherwise dry onto it and add to its mass"
            },
            {
              "id": "dissolve",
              "label": "To dissolve some of the precipitate"
            },
            {
              "id": "cool",
              "label": "To cool it"
            }
          ],
          "correctWhen": "choice == 'soluble'"
        }
      ]
    },
    "goals": {
      "default": {
        "predicates": [
          {
            "id": "g-yield",
            "statement": "The yield of barium sulfate is between 90 and 102 %",
            "check": "between(first(recorded('yield-percent')), 90, 102)"
          },
          {
            "id": "g-explain",
            "statement": "Washing is explained",
            "check": "decision(why-wash) == 'soluble'"
          }
        ],
        "expectedObservations": [
          {
            "id": "e-white",
            "statement": "A fine white precipitate forms",
            "check": "mentions(first(recorded('seen-a')), 'white precipitate')",
            "source": "reference-standard"
          }
        ]
      }
    },
    "objectives": {
      "default": [
        {
          "id": "o-method",
          "kind": "skill",
          "statement": "Prepare a pure, dry sample of an insoluble salt"
        },
        {
          "id": "o-yield",
          "kind": "analysis",
          "statement": "Calculate a percentage yield",
          "goal": "g-yield"
        },
        {
          "id": "o-explain",
          "kind": "reasoning",
          "statement": "Explain the washing step",
          "goal": "g-explain"
        }
      ]
    },
    "keywords": {
      "default": [
        "insoluble salt",
        "precipitation",
        "barium sulfate",
        "filtration",
        "washing",
        "percentage yield"
      ]
    },
    "level": {
      "default": "ages-14-16"
    }
  },
  "materials": {
    "supplies": [
      "{{sample}}",
      "{{reagent}}",
      "{{acid}}",
      {
        "id": "water",
        "label": "Deionised water",
        "preparation": "core:water-deionised",
        "amount": "500 mL",
        "container": "core:reagent-bottle-1l"
      }
    ]
  },
  "equipment": {
    "roles": [
      {
        "id": "eye",
        "requires": {
          "class": "core:visual-inspection"
        }
      },
      {
        "id": "balance",
        "requires": {
          "class": "core:balance-4dp"
        }
      },
      {
        "id": "pipette25",
        "requires": {
          "class": "core:volumetric-pipette-25ml"
        }
      }
    ]
  },
  "procedure": {
    "fidelity": "prescribed-tolerant",
    "steps": [
      {
        "id": "runs",
        "kind": "group",
        "title": "Each portion",
        "objectives": [
          "o-method"
        ],
        "forEach": {
          "var": "r",
          "in": "=['a', 'b']"
        },
        "let": {
          "beaker": "='beaker-' + r"
        },
        "steps": [
          {
            "id": "beaker",
            "kind": "operation",
            "ref": "core:fetch",
            "params": {
              "equipment": "core:beaker-100ml",
              "id": "=beaker",
              "label": "='Precipitation (' + r + ')'"
            }
          },
          {
            "id": "sample-in",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "sample",
              "destination": "=beaker",
              "volume": "25 mL",
              "tool": "pipette25"
            }
          },
          {
            "id": "acidify",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "acid",
              "destination": "=beaker",
              "volume": "2 mL",
              "tool": "pour"
            }
          },
          {
            "id": "reagent-in",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "reagent",
              "destination": "=beaker",
              "volume": "{{reagentVolume}}",
              "tool": "pour"
            }
          },
          {
            "id": "stir",
            "kind": "operation",
            "ref": "core:mix",
            "params": {
              "container": "=beaker",
              "method": "stir",
              "cycles": 3
            }
          },
          {
            "id": "stand",
            "kind": "operation",
            "ref": "core:advance-time",
            "params": {
              "duration": "10 min"
            }
          },
          {
            "id": "look",
            "kind": "operation",
            "ref": "core:measure",
            "params": {
              "instrument": "eye",
              "subject": "=beaker"
            }
          },
          {
            "id": "note-seen",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "='seen-' + r",
              "value": "=look.out.appearance"
            }
          },
          {
            "id": "funnel",
            "kind": "operation",
            "ref": "core:fetch",
            "params": {
              "equipment": "core:filter-funnel",
              "id": "='funnel-' + r",
              "label": "='Filter (' + r + ')'"
            }
          },
          {
            "id": "funnel-on",
            "kind": "operation",
            "ref": "core:place-in",
            "params": {
              "container": "='funnel-' + r",
              "place": "balance"
            }
          },
          {
            "id": "tare",
            "kind": "operation",
            "ref": "core:tare",
            "params": {
              "balance": "balance"
            }
          },
          {
            "id": "funnel-off",
            "kind": "operation",
            "ref": "core:remove-from",
            "params": {
              "container": "='funnel-' + r"
            }
          },
          {
            "id": "filtrate",
            "kind": "operation",
            "ref": "core:fetch",
            "params": {
              "equipment": "core:beaker-100ml",
              "id": "='filtrate-' + r",
              "label": "='Filtrate (' + r + ')'"
            }
          },
          {
            "id": "filter",
            "kind": "operation",
            "ref": "core:filter",
            "params": {
              "source": "=beaker",
              "filter": "='funnel-' + r",
              "filtrate": "='filtrate-' + r"
            }
          },
          {
            "id": "washes",
            "kind": "group",
            "title": "Rinse the beaker onto the filter and wash",
            "forEach": {
              "var": "n",
              "in": "=[1, 2, 3]"
            },
            "steps": [
              {
                "id": "rinse",
                "kind": "operation",
                "ref": "core:transfer",
                "params": {
                  "source": "water",
                  "destination": "=beaker",
                  "volume": "10 mL",
                  "tool": "pour"
                }
              },
              {
                "id": "swirl",
                "kind": "operation",
                "ref": "core:mix",
                "params": {
                  "container": "=beaker",
                  "method": "swirl",
                  "cycles": 2
                }
              },
              {
                "id": "wash",
                "kind": "operation",
                "ref": "core:filter",
                "params": {
                  "source": "=beaker",
                  "filter": "='funnel-' + r",
                  "filtrate": "='filtrate-' + r"
                }
              }
            ]
          },
          {
            "id": "dry",
            "kind": "operation",
            "ref": "core:dry",
            "params": {
              "container": "='funnel-' + r",
              "method": "heat"
            }
          },
          {
            "id": "funnel-back",
            "kind": "operation",
            "ref": "core:place-in",
            "params": {
              "container": "='funnel-' + r",
              "place": "balance"
            }
          },
          {
            "id": "weigh",
            "kind": "operation",
            "ref": "core:weigh",
            "params": {
              "balance": "balance"
            }
          },
          {
            "id": "off",
            "kind": "operation",
            "ref": "core:remove-from",
            "params": {
              "container": "='funnel-' + r"
            }
          },
          {
            "id": "note-mass",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "='mass-' + r",
              "value": "=value(quantity(weigh.out.value), 'g')"
            }
          }
        ]
      },
      {
        "id": "analysis",
        "kind": "group",
        "title": "Results",
        "steps": "{{analysis}}"
      }
    ]
  },
  "goals": "{{goals}}",
  "variation": {
    "noise": "default"
  },
  "provenance": {
    "defaultClass": "general-knowledge",
    "review": {
      "status": "draft"
    }
  },
