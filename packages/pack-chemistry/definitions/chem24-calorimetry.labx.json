            "goal": "g-dh"
          },
          {
            "id": "o-explain",
            "kind": "reasoning",
            "statement": "Explain an endothermic dissolution",
            "goal": "g-explain"
          }
        ],
        "level": "ages-16-19",
        "keywords": [
          "calorimetry",
          "enthalpy of solution",
          "dissolving",
          "endothermic",
          "exothermic",
          "ammonium nitrate",
          "lattice enthalpy"
        ]
      }
    },
    {
      "id": "chem24-hess-copper-sulfate",
      "title": "Hess's law: the hydration of copper(II) sulfate",
      "summary": "Measure the enthalpy of solution of anhydrous copper(II) sulfate and of its pentahydrate, and use Hess's law to find the enthalpy change when the anhydrous salt takes up water.",
      "briefing": "CuSO₄(s) + 5H₂O(l) → CuSO₄·5H₂O(s) cannot be measured directly. Both solids dissolve to the same solution, so ΔH(hydration) = ΔH(solution, anhydrous) − ΔH(solution, pentahydrate). Use about 25 mmol of each in 50 mL of water.",
      "curricula": [
        "GCSE",
        "A level",
        "IB"
      ],
      "values": {
        "runs": "=[['anhydrous', 'Anhydrous copper(II) sulfate in water', 'water', 50, 'anh', 4.0, 'solid', 159.61, 0], ['hydrated', 'Copper(II) sulfate pentahydrate in water', 'water', 50, 'hyd', 6.25, 'solid', 249.69, 0]]",
        "supplies": [
          {
            "id": "water",
            "label": "Deionised water",
            "preparation": "core:water-deionised",
            "amount": "500 mL",
            "container": "core:reagent-bottle-1l"
          },
          {
            "id": "anh",
            "label": "Anhydrous copper(II) sulfate (white)",
            "contains": [
              {
                "substance": "aq:copper-ii-sulfate",
                "purity": "99 %"
              }
            ],
            "amount": "50 g",
            "container": "core:weighing-bottle"
          },
          {
            "id": "hyd",
            "label": "Copper(II) sulfate pentahydrate (blue crystals)",
            "contains": [
              {
                "substance": "aq:copper-ii-sulfate-pentahydrate",
                "purity": "99 %"
              }
            ],
            "amount": "50 g",
            "container": "core:weighing-bottle"
          }
        ],
        "analysis": [
          {
            "id": "hydration",
            "kind": "operation",
            "ref": "core:compute",
            "params": {
              "expression": "a - b",
              "values": {
                "a": "=first(recorded('dH-anhydrous'))",
                "b": "=first(recorded('dH-hydrated'))"
