[
  {
    "id": "core:dilution-series",
    "version": 1,
    "status": "experimental",
    "label": "Prepare a dilution series",
    "description": "Prepare a set of concentrations by diluting a stock into separate vessels (each made directly from the stock, so errors do not propagate down the series).",
    "purposes": [
      "prepare.dilution-series",
      "prepare.standard-series"
    ],
    "params": {
      "stock": {
        "type": "container",
        "required": true
      },
      "diluent": {
        "type": "container",
        "required": true
      },
      "analyte": {
        "type": "material",
        "description": "The substance the targets refer to; default: the first component on the stock's label"
      },
      "targets": {
        "type": "list",
        "items": {
          "type": "quantity"
        },
        "required": true
      },
      "volumeEach": {
        "type": "quantity",
        "dimension": "volume",
        "required": true
      },
      "method": {
        "type": "enum",
        "values": [
          "parallel-from-stock"
        ],
        "default": "parallel-from-stock"
      }
    },
    "roles": {
      "vessels": {
        "kind": "container",
        "requires": {
          "class": "core:tube",
          "capacity": ">= 1.2 * volumeEach"
        },
        "prefer": [
          "core:microtube-1.5ml"
        ],
        "count": "=len(targets)"
      }
    },
    "derived": {
      "stockConc": "=labelConc(stock, analyte)"
    },
    "steps": [
      {
        "id": "each",
        "kind": "group",
        "forEach": {
          "var": "target",
          "in": "=targets",
          "index": "i"
        },
        "let": {
          "sv": "=round(volumeEach * target / stockConc, 0.01 uL)",
          "dv": "=volumeEach - sv"
        },
        "steps": [
          {
            "id": "label",
            "kind": "operation",
            "ref": "core:label",
            "params": {
              "container": "=vessels[i]",
              "text": "=text(target)"
            }
          },
          {
            "id": "add-diluent",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "=diluent",
              "destination": "=vessels[i]",
              "volume": "=dv"
            },
            "when": "dv > 0 uL"
          },
          {
            "id": "add-stock",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "=stock",
              "destination": "=vessels[i]",
              "volume": "=sv"
            },
            "when": "sv > 0 uL"
          },
          {
            "id": "mix",
            "kind": "operation",
            "ref": "core:mix",
            "params": {
              "container": "=vessels[i]",
              "method": "vortex"
            },
            "when": "sv > 0 uL && dv > 0 uL"
          }
        ]
      }
    ],
    "outputs": {
      "vessels": "=vessels",
      "concentrations": "=targets"
    },
    "quality": [
      {
        "id": "fresh-tip-stock",
        "statement": "A fresh tip for every transfer from the stock",
        "check": "all(events(op='core:transfer', step='add-stock'), tipFresh || sameSourceAsLast)",
        "severity": "major",
        "skills": [
          "core:micropipetting"
        ],
        "feedbackKind": "procedural"
      },
      {
        "id": "pipette-in-range",
        "statement": "Each volume measured with a pipette in its accurate range",
        "check": "all(events(op='core:transfer'), inGoodRange)",
        "severity": "minor",
        "skills": [
          "core:pipette-range-selection"
        ],
        "feedbackKind": "procedural"
      },
      {
        "id": "mixed",
        "statement": "Each standard mixed before it is used",
        "check": "all(vessels, homogeneity(it) > 0.95)",
        "severity": "major",
        "skills": [
          "core:dilution-series"
        ],
        "feedbackKind": "procedural"
      }
    ],
    "errors": [
      {
        "id": "reused-tip",
        "statement": "Tip reused between the stock and a standard",
        "consequence": "The tip's film carries stock into the next standard (core:transfer carry-over channel): a small positive bias",
        "tag": "tip-reuse"
      },
      {
        "id": "unmixed",
        "statement": "A standard not mixed",
        "consequence": "The tube stays layered (core:mixing/strata); the sample drawn from it is too dilute or too concentrated",
        "tag": "poor-mixing"
      },
      {
        "id": "inverted-factor",
        "statement": "Stock and diluent volumes swapped",
        "consequence": "Concentrations far from the targets",
        "tag": "dilution-factor-inversion"
      }
    ],
    "skills": [
      "core:dilution-series",
      "core:dilution-planning",
      "core:micropipetting"
    ],
    "support": {
      "each": "For each standard, work out the stock volume (C₁V₁ = C₂V₂) and add diluent first, then stock, then mix.",
      "add-diluent": "Add the diluent first, so the stock goes into liquid.",
      "add-stock": "Use a fresh tip for each stock transfer.",
      "mix": "Vortex briefly so the standard is uniform before you sample from it."
    },
    "presentation": {
      "station": "bench.liquid-handling"
    }
  },
  {
    "id": "core:serial-dilution",
    "version": 1,
    "status": "experimental",
    "label": "Serial dilution",
    "description": "Each vessel is made from the previous one, so a constant factor applies down the series (and errors propagate). The last vessel keeps one transfer volume more than the others.",
    "purposes": [
      "prepare.dilution-series"
    ],
    "params": {
      "stock": {
        "type": "container",
        "required": true
      },
      "diluent": {
        "type": "container",
        "required": true
      },
      "factor": {
        "type": "number",
        "required": true
      },
      "count": {
        "type": "integer",
        "required": true
      },
      "volumeEach": {
        "type": "quantity",
        "dimension": "volume",
        "required": true,
        "description": "Volume left in each vessel after the transfer to the next"
      }
    },
    "roles": {
      "vessels": {
        "kind": "container",
        "requires": {
          "class": "core:tube",
          "capacity": ">= 1.2 * volumeEach * factor / (factor - 1)"
        },
        "prefer": [
          "core:microtube-1.5ml"
        ],
        "count": "=count"
      }
    },
    "derived": {
      "transferVolume": "=round(volumeEach / (factor - 1), 0.01 uL)"
    },
    "steps": [
      {
        "id": "fill",
        "kind": "operation",
        "ref": "core:transfer",
        "forEach": {
          "var": "v",
          "in": "=vessels"
        },
        "params": {
          "source": "=diluent",
          "destination": "=v",
          "volume": "=volumeEach"
        }
      },
      {
        "id": "first",
        "kind": "operation",
        "ref": "core:transfer",
        "params": {
          "source": "=stock",
          "destination": "=vessels[0]",
          "volume": "=transferVolume"
        }
      },
      {
        "id": "mix-first",
        "kind": "operation",
        "ref": "core:mix",
        "params": {
          "container": "=vessels[0]",
          "method": "vortex"
        }
      },
      {
        "id": "down",
        "kind": "group",
        "forEach": {
          "var": "n",
          "in": "=range(1, count - 1, count - 1)"
        },
        "when": "count > 1",
        "steps": [
          {
            "id": "carry",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "=vessels[n - 1]",
              "destination": "=vessels[n]",
              "volume": "=transferVolume"
            }
          },
          {
            "id": "mix",
            "kind": "operation",
            "ref": "core:mix",
            "params": {
              "container": "=vessels[n]",
              "method": "vortex"
            }
          }
        ]
      }
    ],
    "outputs": {
      "vessels": "=vessels"
    },
    "quality": [
      {
        "id": "fresh-tip-each",
        "statement": "A fresh tip for each transfer down the series",
        "check": "all(events(op='core:transfer', step='carry'), tipFresh || sameSourceAsLast)",
        "severity": "major",
        "skills": [
          "core:micropipetting"
        ],
        "feedbackKind": "procedural"
      },
      {
        "id": "mixed-each",
        "statement": "Each vessel mixed before transferring from it",
        "check": "all(vessels, homogeneity(it) > 0.95)",
        "severity": "major",
        "skills": [
          "core:serial-dilution"
        ],
        "feedbackKind": "procedural"
      }
    ],
    "errors": [
      {
        "id": "unmixed",
        "statement": "A vessel not mixed before transferring on",
        "consequence": "The error propagates to every later vessel",
        "tag": "poor-mixing"
      }
    ],
    "skills": [
      "core:serial-dilution",
      "core:dilution-planning",
      "core:micropipetting"
    ],
    "presentation": {
      "station": "bench.liquid-handling"
    }
  },
  {
    "id": "core:dilute-sample",
    "version": 1,
    "status": "experimental",
    "label": "Dilute a sample",
    "purposes": [
      "combine.dilute"
    ],
    "params": {
      "sample": {
        "type": "container",
        "required": true
      },
      "diluent": {
        "type": "container",
        "required": true
      },
      "factor": {
        "type": "number",
        "required": true
      },
      "finalVolume": {
        "type": "quantity",
        "dimension": "volume",
        "default": "100 uL"
      }
    },
    "roles": {
      "vessel": {
        "kind": "container",
        "requires": {
          "class": "core:tube",
          "capacity": ">= 1.2 * finalVolume"
        },
        "prefer": [
          "core:microtube-1.5ml"
        ]
      }
    },
    "derived": {
      "sv": "=round(finalVolume / factor, 0.01 uL)",
      "dv": "=finalVolume - sv"
    },
    "steps": [
      {
        "id": "label",
        "kind": "operation",
        "ref": "core:label",
        "params": {
          "container": "=vessel",
          "text": "=labelOf(sample) + ' 1:' + text(factor)"
        }
      },
      {
        "id": "add-diluent",
        "kind": "operation",
        "ref": "core:transfer",
        "params": {
          "source": "=diluent",
          "destination": "=vessel",
          "volume": "=dv"
        }
      },
      {
        "id": "add-sample",
        "kind": "operation",
        "ref": "core:transfer",
        "params": {
          "source": "=sample",
          "destination": "=vessel",
          "volume": "=sv"
        }
      },
      {
        "id": "mix",
        "kind": "operation",
        "ref": "core:mix",
        "params": {
          "container": "=vessel",
          "method": "vortex"
        }
      }
    ],
    "outputs": {
      "vessel": "=vessel",
      "factor": "=factor"
    },
    "skills": [
      "core:dilute-sample",
      "core:dilution-planning",
      "core:micropipetting"
    ]
  },
  {
    "id": "core:plate-layout",
    "version": 1,
    "status": "experimental",
    "label": "Design a plate layout",
    "mode": "design",
    "purposes": [
      "plan.layout"
    ],
    "params": {
      "plate": {
        "type": "container",
        "required": true
      },
      "groups": {
        "type": "list",
        "required": true,
        "description": "[{ group, items, role }]: what goes on the plate"
      },
      "replicates": {
        "type": "integer",
        "default": 1
      },
      "blanks": {
        "type": "integer",
        "default": 0
      },
      "blankSource": {
        "type": "container"
      },
      "order": {
        "type": "enum",
        "values": [
          "row",
          "column"
        ],
        "default": "row"
      }
    },
    "steps": [
      {
        "id": "layout",
        "kind": "operation",
        "ref": "core:layout-plate",
        "params": {
          "plate": "=plate",
          "groups": "=groups",
          "replicates": "=replicates",
          "blanks": "=blanks",
          "blankSource": "=blankSource",
          "order": "=order"
        }
      }
    ],
    "outputs": {
      "layout": "=layout.out.layout"
    },
    "skills": [
      "core:plate-layout",
      "core:control-design"
    ]
  },
  {
    "id": "core:transfer-to-plate",
    "version": 1,
    "status": "experimental",
    "label": "Load a plate",
    "purposes": [
      "transfer.to-plate"
    ],
    "params": {
      "layout": {
        "type": "record",
        "required": true
      },
      "volume": {
        "type": "quantity",
        "dimension": "volume",
        "required": true
      }
    },
    "steps": [
      {
        "id": "load",
        "kind": "operation",
        "ref": "core:transfer",
        "forEach": {
          "var": "e",
          "in": "=filter(layout.entries, item != null)"
        },
        "params": {
          "source": "=e.item",
          "destination": "=e.well",
          "volume": "=volume"
        }
      }
    ],
    "outputs": {
      "wells": "=map(layout.entries, well)"
    },
    "quality": [
      {
        "id": "fresh-tip-each-item",
        "statement": "A fresh tip for each different standard or sample",
        "check": "all(events(op='core:transfer', step='load'), tipFresh || sameSourceAsLast)",
        "severity": "major",
        "skills": [
          "core:micropipetting"
        ],
        "feedbackKind": "procedural"
      }
    ],
    "skills": [
      "core:transfer-to-plate",
      "core:micropipetting"
    ],
    "presentation": {
      "station": "bench.liquid-handling"
    }
  },
  {
