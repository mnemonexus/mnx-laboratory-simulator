  {
    "id": "micro:haemocytometer-count",
    "version": 1,
    "status": "experimental",
    "label": "Count cells with a haemocytometer and trypan blue",
    "description": "Mix the cells 1:1 with trypan blue, load the chamber, count the four large corner squares (clear and blue cells separately), and work out cells per mL and the proportion alive.",
    "purposes": [
      "measure.cell-density"
    ],
    "params": {
      "sample": {
        "type": "container",
        "required": true
      },
      "stain": {
        "type": "container",
        "required": true
      },
      "squares": {
        "type": "integer",
        "default": 4
      },
      "dilution": {
        "type": "number",
        "default": 1,
        "description": "Any dilution already made before staining"
      }
    },
    "roles": {
      "microscope": {
        "kind": "equipment",
        "requires": {
          "purpose": "observe.morphology"
        },
        "prefer": [
          "core:brightfield-microscope"
        ]
      },
      "chamber": {
        "kind": "container",
        "requires": {
          "class": "core:haemocytometer"
        },
        "prefer": [
          "core:haemocytometer"
        ]
      },
      "tube": {
        "kind": "container",
        "requires": {
          "class": "core:microtube-1.5ml"
        },
        "prefer": [
          "core:microtube-1.5ml"
        ]
      }
    },
    "steps": [
      {
        "id": "resuspend",
        "kind": "operation",
        "ref": "core:mix",
        "params": {
          "container": "=sample",
          "method": "vortex",
          "cycles": 2
        }
      },
      {
        "id": "cells-in",
        "kind": "operation",
        "ref": "core:transfer",
        "params": {
          "source": "=sample",
          "destination": "=tube",
          "volume": "50 uL"
        }
      },
      {
        "id": "stain-in",
        "kind": "operation",
        "ref": "core:transfer",
        "params": {
          "source": "=stain",
          "destination": "=tube",
          "volume": "50 uL"
        }
      },
      {
        "id": "mix",
        "kind": "operation",
        "ref": "core:mix",
        "params": {
          "container": "=tube",
          "method": "vortex",
          "cycles": 2
        }
      },
      {
        "id": "load",
        "kind": "operation",
        "ref": "core:transfer",
        "params": {
          "source": "=tube",
          "destination": "=chamber",
          "volume": "10 uL"
        }
      },
      {
        "id": "count",
        "kind": "operation",
        "ref": "core:measure",
        "params": {
          "instrument": "=microscope",
          "subject": "=chamber",
          "squares": "=squares"
        }
      },
      {
        "id": "density",
        "kind": "operation",
        "ref": "core:compute",
        "params": {
          "expression": "(sum(c) + sum(b)) / n * 2 * d * 10000",
          "values": {
            "c": "=count.out.counts",
            "b": "=count.out.blue",
            "n": "=squares",
            "d": "=dilution"
          },
          "field": "cells-per-ml"
        }
      },
      {
        "id": "alive",
        "kind": "operation",
        "ref": "core:compute",
        "params": {
          "expression": "sum(c) / (sum(c) + sum(b))",
          "values": {
            "c": "=count.out.counts",
            "b": "=count.out.blue"
          },
          "field": "viability"
        }
      }
    ],
    "outputs": {
      "perMl": "=density.out.value",
      "viability": "=alive.out.value"
    },
    "quality": [
      {
        "id": "enough",
        "statement": "Enough cells counted for a 10 % estimate (about 100)",
        "check": "sum(count.out.counts) + sum(count.out.blue) >= 100",
        "severity": "minor",
        "skills": [
          "micro:haemocytometer"
        ],
        "feedbackKind": "measurement"
      }
    ],
    "errors": [
      {
        "id": "too-dense",
        "statement": "Too concentrated to count",
        "consequence": "The squares are too crowded: dilute and count again (core:measure)",
        "tag": "count-too-dense"
      },
      {
        "id": "too-few",
        "statement": "Too few cells counted",
        "consequence": "Poisson error: counting N cells gives about 1/√N relative error (counting model)",
        "tag": "count-too-few"
      },
      {
        "id": "unmixed",
        "statement": "Sample not mixed before it is taken",
        "consequence": "Cells are not evenly spread: the count is biased (mixing model)",
        "tag": "unmixed-sample"
      }
    ],
    "skills": [
      "micro:haemocytometer"
    ]
  }
]
