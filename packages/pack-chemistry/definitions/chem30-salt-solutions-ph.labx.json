{
  "format": "lab-experiment",
  "formatVersion": "0.1",
  "id": "chem30-salt-solutions-ph",
  "version": "1.0.0",
  "title": "{{title}}",
  "language": "en-GB",
  "requires": {
    "framework": ">=0.1"
  },
  "summary": "{{summary}}",
  "briefing": "{{briefing}}",
  "context": {
    "intendedContexts": [
      "practical-session",
      "lecture-introduction",
      "assessment"
    ],
    "audience": {
      "level": "{{level}}",
      "disciplines": [
        "chemistry"
      ]
    },
    "keywords": [
      "pH",
      "indicator",
      "pH meter",
      "acids and alkalis",
      "salt hydrolysis"
    ],
    "topics": [
      "Acids, bases and salts"
    ],
    "concepts": [
      {
        "id": "ph-scale",
        "label": "pH measures how acidic or alkaline a solution is"
      },
      {
        "id": "proton-transfer",
        "label": "Acids give and bases take hydrogen ions"
      }
    ],
    "objectives": [
      {
        "id": "o-measure",
        "kind": "skill",
        "statement": "Calibrate a pH meter and measure the pH of solutions",
        "skills": [
          "core:ph-meter-calibration"
        ]
      },
      {
        "id": "o-observe",
        "kind": "outcome",
        "statement": "Record indicator colours and pH readings for each solution"
      },
      {
        "id": "o-explain",
        "kind": "reasoning",
        "statement": "{{explainObjective}}",
        "goal": "g-q1"
      }
    ],
    "curricula": "{{curricula}}"
  },
  "parameters": {
    "title": {
      "default": "The pH of salt solutions"
    },
    "summary": {
      "default": "Measure the pH of six salt solutions with a calibrated pH meter and universal indicator, and explain why some salts give acidic or alkaline solutions though no acid or alkali was added."
    },
    "briefing": {
      "default": "Calibrate the pH meter with the pH 4 and pH 7 buffers. Pour about 20 mL of each 0.1 M salt solution into a beaker and read its pH, rinsing the electrode between readings. Put 5 mL of each solution in a test tube with two drops of universal indicator and note the colour. Some ions react with water: an ion that gives H⁺ to water makes the solution acidic, and one that takes H⁺ from water leaves OH⁻ and makes it alkaline."
    },
    "level": {
      "default": "ages-16-19"
    },
    "curricula": {
      "default": [
        "A level",
        "IB",
        "AP",
        "T Level"
      ]
    },
    "samples": {
      "default": "=['nacl', 'nh4cl', 'na2co3', 'naac', 'fecl3', 'alcl3']"
    },
    "indicators": {
      "default": "=['ui']"
    },
    "explainObjective": {
      "default": "Explain salt hydrolysis: which ions give hydrogen ions to water and which take them"
    },
    "questions": {
      "default": [
        {
          "id": "q1",
          "kind": "decision",
          "objectives": [
            "o-explain"
          ],
          "prompt": "Iron(III) chloride solution is acidic although no acid was added. Why?",
          "options": [
            {
              "id": "hydrated-ion",
              "label": "The small, highly charged Fe³⁺ ion pulls electrons from the water molecules bound to it, and they release H⁺"
            },
            {
              "id": "chloride",
              "label": "Chloride ions make solutions acidic"
            },
            {
              "id": "contains-hcl",
              "label": "The salt contains hydrochloric acid"
            }
          ],
          "correctWhen": "'hydrated-ion'"
        },
        {
          "id": "q2",
          "kind": "decision",
          "objectives": [
            "o-explain"
          ],
          "prompt": "Why is sodium carbonate solution alkaline?",
          "options": [
            {
              "id": "base",
              "label": "Carbonate ions take H⁺ from water molecules, leaving OH⁻ ions"
            },
            {
              "id": "sodium",
              "label": "Sodium is a metal, and metals make alkalis"
            },
            {
              "id": "impure",
              "label": "Sodium hydroxide is left over from making it"
            }
          ],
          "correctWhen": "'base'"
        },
        {
          "id": "q3",
          "kind": "decision",
          "objectives": [
            "o-explain"
          ],
          "prompt": "Which salt gives a neutral solution, and why?",
          "options": [
            {
              "id": "nacl",
              "label": "Sodium chloride: neither Na⁺ nor Cl⁻ reacts with water"
            },
            {
              "id": "nh4cl",
              "label": "Ammonium chloride: NH₄⁺ and Cl⁻ cancel out"
            },
            {
              "id": "naac",
              "label": "Sodium ethanoate: it is made from an acid and an alkali"
            }
          ],
          "correctWhen": "'nacl'"
        }
      ]
    },
    "goals": {
      "default": [
        {
          "id": "g-q1",
          "statement": "The acidity of iron(III) chloride is explained",
          "check": "decision('q1') == 'hydrated-ion'"
        },
        {
          "id": "g-q2",
          "statement": "The alkalinity of sodium carbonate is explained",
          "check": "decision('q2') == 'base'"
        },
        {
          "id": "g-q3",
          "statement": "The neutral salt is identified",
          "check": "decision('q3') == 'nacl'"
        }
      ]
    },
    "observations": {
      "default": [
        {
          "id": "e-acidic",
          "statement": "Ammonium, aluminium and iron(III) chlorides are acidic; iron(III) chloride is the most acidic, below pH 3",
          "check": "first(recorded('ph-nh4cl')) < 6 && first(recorded('ph-alcl3')) < 5 && first(recorded('ph-fecl3')) < 3",
          "source": "reference-standard"
        },
        {
          "id": "e-alkaline",
          "statement": "Sodium ethanoate and sodium carbonate are alkaline; sodium carbonate is above pH 11",
          "check": "first(recorded('ph-naac')) > 8 && first(recorded('ph-na2co3')) > 11",
          "source": "reference-standard"
        },
        {
          "id": "e-neutral",
          "statement": "Sodium chloride is close to neutral",
          "check": "abs(first(recorded('ph-nacl')) - 7) < 1",
          "source": "reference-standard"
        }
      ]
    }
  },
  "materials": {
    "supplies": [
      {
        "id": "nacl",
        "label": "Sodium chloride, 0.1 M",
        "contains": [
          {
            "substance": "aq:sodium-chloride",
            "conc": "0.1 mol/L"
          }
        ],
        "solvent": "core:water",
        "amount": "60 mL",
        "container": "core:reagent-bottle-250ml"
      },
      {
        "id": "nh4cl",
        "label": "Ammonium chloride, 0.1 M",
        "contains": [
          {
            "substance": "aq:ammonium-chloride",
            "conc": "0.1 mol/L"
          }
        ],
        "solvent": "core:water",
        "amount": "60 mL",
        "container": "core:reagent-bottle-250ml"
      },
      {
        "id": "na2co3",
        "label": "Sodium carbonate, 0.1 M",
        "contains": [
          {
            "substance": "aq:sodium-carbonate",
            "conc": "0.1 mol/L"
          }
        ],
        "solvent": "core:water",
        "amount": "60 mL",
        "container": "core:reagent-bottle-250ml"
      },
      {
        "id": "naac",
        "label": "Sodium ethanoate, 0.1 M",
        "contains": [
          {
            "substance": "aq:sodium-ethanoate",
            "conc": "0.1 mol/L"
          }
        ],
        "solvent": "core:water",
        "amount": "60 mL",
        "container": "core:reagent-bottle-250ml"
      },
      {
        "id": "fecl3",
        "label": "Iron(III) chloride, 0.1 M",
        "contains": [
          {
            "substance": "aq:iron-iii-chloride",
            "conc": "0.1 mol/L"
          }
        ],
        "solvent": "core:water",
        "amount": "60 mL",
        "container": "core:reagent-bottle-250ml"
      },
      {
        "id": "alcl3",
        "label": "Aluminium chloride, 0.1 M",
        "contains": [
          {
            "substance": "aq:aluminium-chloride",
            "conc": "0.1 mol/L"
          }
        ],
        "solvent": "core:water",
