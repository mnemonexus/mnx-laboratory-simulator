{
  "format": "lab-experiment",
  "formatVersion": "0.1",
  "id": "chem20-ion-tests",
  "version": "1.0.0",
  "title": "{{title}}",
  "language": "en-GB",
  "requires": {
    "framework": ">=0.1",
    "capabilities": [
      {
        "operation": "core:measure"
      }
    ]
  },
  "summary": "{{summary}}",
  "briefing": "{{briefing}}",
  "context": {
    "intendedContexts": [
      "practical-session",
      "lecture-introduction",
      "assessment"
    ],
    "audience": {
      "level": "{{level}}",
      "disciplines": [
        "chemistry"
      ]
    },
    "keywords": "{{keywords}}",
    "topics": [
      "Qualitative analysis",
      "Inorganic chemistry"
    ],
    "curricula": [
      "GCSE",
      "A level",
      "IB",
      "BTEC"
    ],
    "concepts": [
      {
        "id": "precipitation",
        "label": "Precipitation and solubility"
      },
      {
        "id": "complexes",
        "label": "Complex ions"
      }
    ],
    "objectives": [
      {
        "id": "o-observe",
        "kind": "skill",
        "statement": "Carry out test-tube reactions and record observations"
      },
      {
        "id": "o-identify",
        "kind": "reasoning",
        "statement": "Identify ions from what is seen",
        "goal": "g-identify"
      }
    ]
  },
  "parameters": {
    "title": {
      "default": "Which metal ion? Hydroxide precipitates"
    },
    "summary": {
      "default": "Add sodium hydroxide to five solutions, a few drops and then in excess, and name each metal ion from the colour of its hydroxide and whether it dissolves again."
    },
    "briefing": {
      "default": "Sodium hydroxide precipitates most metal ions as their hydroxides. The colour tells several apart; aluminium (and zinc) hydroxide dissolve again in excess because they are amphoteric. Calcium and magnesium hydroxides are both white and stay; a flame test separates them."
    },
    "level": {
      "default": "ages-14-16"
    },
    "tubes": {
      "default": "=[['A', 'sol-a'], ['B', 'sol-b'], ['C', 'sol-c'], ['D', 'sol-d'], ['E', 'sol-e']]"
    },
    "additions": {
      "default": "=[['naoh', '0.5 mL', 'drops', 'A few drops of sodium hydroxide (about ten)'], ['naoh', '3 mL', 'excess', 'Sodium hydroxide in excess']]"
    },
    "letters": {
      "default": "=['A', 'B', 'C', 'D', 'E']"
    },
    "options": {
      "default": [
        {
          "id": "copper",
          "label": "Copper(II), Cu²⁺"
        },
        {
          "id": "iron-ii",
          "label": "Iron(II), Fe²⁺"
        },
        {
          "id": "iron-iii",
          "label": "Iron(III), Fe³⁺"
        },
        {
          "id": "aluminium",
          "label": "Aluminium, Al³⁺"
        },
        {
          "id": "calcium",
          "label": "Calcium, Ca²⁺"
        },
        {
          "id": "magnesium",
          "label": "Magnesium, Mg²⁺"
        }
      ]
    },
    "answersList": {
      "default": "[['A', 'copper'], ['B', 'iron-ii'], ['C', 'iron-iii'], ['D', 'aluminium'], ['E', 'calcium']]"
    },
    "samples": {
      "default": [
        {
          "id": "sol-a",
          "label": "Solution A",
          "role": "unknown",
          "contains": [
            {
              "substance": "aq:copper-ii-sulfate",
              "conc": "0.1 mol/L"
            }
          ],
          "solvent": "core:water",
          "amount": "10 mL",
          "container": "core:dropper-bottle-10ml"
        },
        {
          "id": "sol-b",
          "label": "Solution B",
          "role": "unknown",
          "contains": [
            {
              "substance": "aq:iron-ii-sulfate",
              "conc": "0.1 mol/L"
            }
          ],
          "solvent": "core:water",
          "amount": "10 mL",
          "container": "core:dropper-bottle-10ml"
        },
        {
          "id": "sol-c",
          "label": "Solution C",
          "role": "unknown",
          "contains": [
            {
              "substance": "aq:iron-iii-chloride",
              "conc": "0.1 mol/L"
            },
            {
              "substance": "aq:nitric-acid",
              "conc": "0.01 mol/L"
            }
          ],
          "solvent": "core:water",
          "amount": "10 mL",
          "container": "core:dropper-bottle-10ml"
        },
        {
          "id": "sol-d",
          "label": "Solution D",
          "role": "unknown",
          "contains": [
            {
              "substance": "aq:aluminium-sulfate",
              "conc": "0.05 mol/L"
            }
          ],
          "solvent": "core:water",
          "amount": "10 mL",
          "container": "core:dropper-bottle-10ml"
        },
        {
          "id": "sol-e",
          "label": "Solution E",
          "role": "unknown",
          "contains": [
            {
              "substance": "aq:calcium-chloride",
              "conc": "0.1 mol/L"
            }
          ],
          "solvent": "core:water",
          "amount": "10 mL",
          "container": "core:dropper-bottle-10ml"
        }
      ]
    },
    "reagents": {
      "default": [
        {
          "id": "naoh",
          "label": "Sodium hydroxide, 1 M",
          "contains": [
            {
              "substance": "aq:sodium-hydroxide",
              "conc": "1 mol/L"
            }
          ],
          "solvent": "core:water",
          "amount": "50 mL",
          "container": "core:reagent-bottle-250ml"
        }
      ]
    },
    "keywords": {
      "default": [
        "hydroxide",
        "precipitate",
        "metal ions",
        "cation test",
        "qualitative analysis"
      ]
    },
    "lettersList": {
      "default": "['A', 'B', 'C', 'D', 'E']"
    },
    "firstCheck": {
      "default": "mentions(first(recorded('seen-A-drops')), 'blue precipitate') && mentions(first(recorded('seen-B-drops')), 'green precipitate') && mentions(first(recorded('seen-C-drops')), 'brown precipitate') && mentions(first(recorded('seen-D-drops')), 'white precipitate') && mentions(first(recorded('seen-E-drops')), 'white precipitate')"
    }
  },
  "materials": {
    "samples": "{{samples}}",
    "supplies": "{{reagents}}"
  },
  "equipment": {
    "roles": [
      {
        "id": "dropper",
        "requires": {
          "class": "core:pasteur-pipette"
        }
      },
      {
        "id": "eye",
        "requires": {
          "class": "core:visual-inspection"
        }
      }
    ]
  },
  "procedure": {
    "fidelity": "prescribed-tolerant",
    "steps": [
      {
        "id": "tests",
        "kind": "group",
        "title": "Each solution in a test tube",
        "forEach": {
          "var": "x",
          "in": "{{tubes}}"
        },
        "objectives": [
          "o-observe"
        ],
        "steps": [
          {
            "id": "tube",
            "kind": "operation",
            "ref": "core:fetch",
            "params": {
              "equipment": "core:test-tube",
              "id": "='tube-' + x[0]",
              "label": "='Tube ' + x[0]"
            }
          },
          {
            "id": "sample",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "=x[1]",
              "destination": "='tube-' + x[0]",
              "volume": "2 mL",
              "tool": "dropper"
            }
          },
          {
            "id": "additions",
            "kind": "group",
            "forEach": {
              "var": "y",
              "in": "{{additions}}"
            },
            "steps": [
              {
                "id": "add",
                "kind": "operation",
                "ref": "core:transfer",
                "params": {
                  "source": "=y[0]",
                  "destination": "='tube-' + x[0]",
                  "volume": "=y[1]",
                  "tool": "dropper"
                }
              },
              {
                "id": "shake",
                "kind": "operation",
                "ref": "core:mix",
                "params": {
                  "container": "='tube-' + x[0]",
                  "method": "swirl",
                  "cycles": 3
                }
              },
              {
                "id": "look",
                "kind": "operation",
                "ref": "core:measure",
                "params": {
                  "instrument": "eye",
                  "subject": "='tube-' + x[0]"
                }
              },
              {
                "id": "note",
                "kind": "operation",
                "ref": "core:record",
                "params": {
                  "field": "='seen-' + x[0] + '-' + y[2]",
                  "value": "=look.out.appearance"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "identify",
        "kind": "decision",
        "objectives": [
          "o-identify"
        ],
        "prompt": "Which ion does this solution contain?",
        "forEach": {
          "var": "x",
          "in": "{{letters}}"
        },
        "options": "{{options}}",
        "correctWhen": "choice == first(filter({{answersList}}, it[0] == x))[1]"
      }
    ]
  },
  "goals": {
    "predicates": [
      {
        "id": "g-identify",
        "statement": "Every solution's ion is named correctly",
        "check": "all(x in {{lettersList}}: decision(identify, x) == first(filter({{answersList}}, it[0] == x))[1])"
      }
    ],
    "expectedObservations": [
      {
        "id": "e-first",
        "statement": "The first reagent gives the expected precipitate (or none)",
        "check": "{{firstCheck}}",
        "source": "reference-standard"
      }
    ]
  },
  "variation": {
    "noise": "default"
  },
  "provenance": {
    "defaultClass": "general-knowledge",
    "review": {
      "status": "draft"
    }
  },
