[
  {
    "id": "micro:prepare-smear",
    "version": 1,
    "status": "experimental",
    "label": "Prepare a smear from a liquid culture",
    "description": "Flame the loop, take a loopful of culture onto a slide, flame the loop again, and let the smear air-dry.",
    "purposes": [
      "prepare.smear"
    ],
    "params": {
      "culture": {
        "type": "container",
        "required": true
      },
      "slide": {
        "type": "container",
        "required": true
      },
      "volume": {
        "type": "quantity",
        "dimension": "volume",
        "default": "10 uL"
      }
    },
    "roles": {
      "loop": {
        "kind": "equipment",
        "requires": {
          "purpose": "transfer.organisms"
        },
        "prefer": [
          "core:inoculating-loop-10ul"
        ]
      }
    },
    "steps": [
      {
        "id": "flame-before",
        "kind": "operation",
        "ref": "core:sterilise",
        "params": {
          "tool": "=loop"
        }
      },
      {
        "id": "take",
        "kind": "operation",
        "ref": "core:transfer",
        "params": {
          "source": "=culture",
          "destination": "=slide",
          "volume": "=volume",
          "tool": "=loop"
        }
      },
      {
        "id": "flame-after",
        "kind": "operation",
        "ref": "core:sterilise",
        "params": {
          "tool": "=loop"
        }
      },
      {
        "id": "air-dry",
        "kind": "operation",
        "ref": "core:dry",
        "params": {
          "container": "=slide",
          "method": "air",
          "duration": "5 min"
        }
      }
    ],
    "quality": [
      {
        "id": "pure",
        "statement": "The smear holds only the organism from its own culture",
        "check": "count(organisms(slide)) == count(organisms(culture))",
        "severity": "major",
        "skills": [
          "micro:aseptic-technique"
        ],
        "feedbackKind": "procedural"
      }
    ],
    "errors": [
      {
        "id": "unflamed-loop",
        "statement": "The loop is not flamed before or after touching a culture",
        "consequence": "Cells ride on the loop into the next culture and onto the next slide (core:transfer, core:sterilise)",
        "tag": "cross-contamination"
      }
    ],
    "skills": [
      "micro:smear-preparation",
      "micro:aseptic-technique"
    ]
  },
  {
    "id": "micro:heat-fix",
    "version": 1,
    "status": "experimental",
    "label": "Heat-fix a smear",
    "description": "Pass the dried slide through a flame, smear side up, two or three times.",
    "purposes": [
      "transform.fix"
    ],
    "params": {
      "slide": {
        "type": "container",
        "required": true
      }
    },
    "steps": [
      {
        "id": "pass",
        "kind": "operation",
        "ref": "core:dry",
        "params": {
          "container": "=slide",
          "method": "heat",
          "duration": "5 s"
        }
      }
    ],
    "errors": [
      {
        "id": "unfixed",
        "statement": "The smear is not heat-fixed",
        "consequence": "Each reagent and rinse washes cells off; the slide ends nearly empty (core:flood, core:rinse)",
        "tag": "smear-washed-off"
      }
    ],
    "skills": [
      "micro:heat-fixing"
    ]
  },
  {
    "id": "micro:gram-stain",
    "version": 1,
    "status": "experimental",
    "label": "Gram stain",
    "description": "Crystal violet, rinse; Gram's iodine, rinse; decolourise briefly, rinse at once; safranin, rinse; blot dry.",
    "purposes": [
      "transform.stain"
    ],
    "params": {
      "slide": {
        "type": "container",
        "required": true
      },
      "primary": {
        "type": "container",
        "required": true
      },
      "mordant": {
        "type": "container",
        "required": true
      },
      "decolouriser": {
        "type": "container",
        "required": true
      },
      "counterstain": {
        "type": "container",
        "required": true
      },
      "primaryTime": {
        "type": "quantity",
        "dimension": "time",
        "default": "60 s"
      },
      "mordantTime": {
        "type": "quantity",
        "dimension": "time",
        "default": "60 s"
      },
      "decolouriseTime": {
        "type": "quantity",
        "dimension": "time",
        "default": "10 s"
      },
      "counterstainTime": {
        "type": "quantity",
        "dimension": "time",
        "default": "45 s"
      }
    },
    "steps": [
      {
        "id": "crystal-violet",
        "kind": "operation",
        "ref": "core:flood",
        "params": {
          "container": "=slide",
          "reagent": "=primary",
          "duration": "=primaryTime"
        }
      },
      {
        "id": "rinse-1",
        "kind": "operation",
        "ref": "core:rinse",
        "params": {
          "container": "=slide"
        }
      },
      {
        "id": "iodine",
        "kind": "operation",
        "ref": "core:flood",
        "params": {
          "container": "=slide",
          "reagent": "=mordant",
          "duration": "=mordantTime"
        }
      },
      {
        "id": "rinse-2",
        "kind": "operation",
        "ref": "core:rinse",
        "params": {
          "container": "=slide"
        }
      },
      {
        "id": "decolourise",
        "kind": "operation",
        "ref": "core:flood",
        "params": {
          "container": "=slide",
          "reagent": "=decolouriser",
          "duration": "=decolouriseTime"
        }
      },
      {
        "id": "rinse-3",
        "kind": "operation",
        "ref": "core:rinse",
        "params": {
          "container": "=slide"
        }
      },
      {
        "id": "safranin",
        "kind": "operation",
        "ref": "core:flood",
        "params": {
          "container": "=slide",
          "reagent": "=counterstain",
          "duration": "=counterstainTime"
        }
      },
      {
        "id": "rinse-4",
        "kind": "operation",
        "ref": "core:rinse",
        "params": {
          "container": "=slide"
        }
      },
      {
        "id": "blot",
        "kind": "operation",
        "ref": "core:dry",
        "params": {
          "container": "=slide",
          "method": "air",
          "duration": "1 min"
        }
      }
    ],
    "quality": [
      {
        "id": "true-colour",
        "statement": "The cells show the colour their Gram class should give",
        "check": "stainColour(slide) == if(gramClass(slide) == 'positive', 'purple', 'pink')",
        "severity": "major",
        "skills": [
          "micro:gram-stain"
        ],
        "feedbackKind": "procedural"
      }
    ],
    "errors": [
      {
        "id": "over-decolourised",
        "statement": "Decolouriser left on too long",
        "consequence": "Gram-positive cells lose crystal violet, take up safranin and look Gram-negative (staining model)",
        "tag": "over-decolourised"
      },
      {
        "id": "under-decolourised",
        "statement": "Decolouriser rinsed off too soon",
        "consequence": "Gram-negative cells keep crystal violet and look Gram-positive (staining model)",
        "tag": "under-decolourised"
      },
      {
        "id": "no-mordant",
        "statement": "Iodine step left out",
        "consequence": "Crystal violet is not complexed and washes out of every cell (staining model)",
        "tag": "no-mordant"
      }
    ],
    "skills": [
      "micro:gram-stain"
    ]
  },
  {
    "id": "micro:brightfield-microscopy",
    "version": 1,
    "status": "experimental",
    "label": "Look at a stained slide under the microscope",
    "description": "Find the smear at low power, then add a drop of immersion oil and look with the 100× objective.",
    "purposes": [
      "observe.morphology"
    ],
    "params": {
      "slide": {
        "type": "container",
        "required": true
      },
      "objective": {
        "type": "text",
        "default": "100x-oil"
      }
    },
    "roles": {
      "microscope": {
        "kind": "equipment",
        "requires": {
          "purpose": "observe.morphology"
        },
        "prefer": [
          "core:brightfield-microscope"
        ]
      }
    },
    "steps": [
      {
        "id": "look",
        "kind": "operation",
        "ref": "core:measure",
        "params": {
          "instrument": "=microscope",
          "subject": "=slide",
          "objective": "=objective"
        }
      }
    ],
    "outputs": {
      "observation": "=look.out.record"
    },
    "skills": [
      "micro:brightfield-microscopy"
    ]
  },
  {
    "id": "micro:aseptic-transfer",
    "version": 1,
    "status": "experimental",
    "label": "Aseptic transfer with a sterile tip",
    "description": "Transfer cells or reagents with a fresh sterile tip, opening tubes only as long as needed.",
    "purposes": [
      "transfer.organisms"
    ],
    "params": {
      "from": {
        "type": "container",
        "required": true
      },
      "into": {
        "type": "container",
        "required": true
      },
      "volume": {
        "type": "quantity",
        "dimension": "volume",
        "required": true
      }
    },
    "steps": [
      {
        "id": "move",
        "kind": "operation",
        "ref": "core:transfer",
        "params": {
          "source": "=from",
          "destination": "=into",
          "volume": "=volume"
        }
      }
    ],
    "skills": [
      "micro:aseptic-technique"
    ]
  },
  {
    "id": "micro:recovery-incubation",
    "version": 1,
    "status": "experimental",
    "label": "Recover transformed cells in broth",
    "description": "Add broth to each tube and let the cells recover and start making the resistance protein before plating.",
    "purposes": [
      "transform.grow-culture"
    ],
    "params": {
      "tubes": {
        "type": "list",
        "items": {
          "type": "container"
        },
        "required": true
      },
      "medium": {
        "type": "container",
        "required": true
      },
      "volume": {
        "type": "quantity",
        "dimension": "volume",
        "default": "250 uL"
      },
      "duration": {
        "type": "quantity",
        "dimension": "time",
        "default": "10 min"
      }
    },
    "steps": [
      {
        "id": "add-broth",
        "kind": "operation",
        "ref": "core:transfer",
        "forEach": {
          "var": "t",
          "in": "=tubes"
        },
        "params": {
          "source": "=medium",
          "destination": "=t",
          "volume": "=volume"
        }
      },
      {
        "id": "out-of-ice",
        "kind": "operation",
        "ref": "core:remove-from",
        "forEach": {
          "var": "t",
          "in": "=tubes"
        },
        "params": {
          "container": "=t"
        }
      },
      {
        "id": "recover",
        "kind": "operation",
        "ref": "core:advance-time",
        "params": {
          "duration": "=duration"
        }
      }
    ],
    "errors": [
      {
        "id": "no-recovery",
        "statement": "Plated straight after the heat shock",
        "consequence": "Transformants have had no time to make β-lactamase; fewer survive on ampicillin (transformation model)",
        "tag": "no-recovery"
      }
    ],
    "skills": [
      "micro:aseptic-technique"
    ]
  },
  {
