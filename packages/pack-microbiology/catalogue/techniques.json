  {
    "id": "micro:streak-plate",
    "version": 1,
    "status": "experimental",
    "label": "Streak a plate for single colonies",
    "description": "Put a loopful of culture in one sector and streak it out; flame the loop and draw each new sector out of the end of the last, four sectors in all.",
    "purposes": [
      "purify.culture"
    ],
    "params": {
      "source": {
        "type": "container",
        "required": true
      },
      "plate": {
        "type": "container",
        "required": true
      },
      "sectors": {
        "type": "integer",
        "default": 4
      }
    },
    "roles": {
      "loop": {
        "kind": "equipment",
        "requires": {
          "purpose": "transfer.organisms"
        },
        "prefer": [
          "core:inoculating-loop-10ul"
        ]
      }
    },
    "steps": [
      {
        "id": "flame",
        "kind": "operation",
        "ref": "core:sterilise",
        "params": {
          "tool": "=loop"
        }
      },
      {
        "id": "inoculate",
        "kind": "operation",
        "ref": "core:transfer",
        "params": {
          "source": "=source",
          "destination": "=plate",
          "volume": "10 uL",
          "tool": "=loop"
        }
      },
      {
        "id": "first",
        "kind": "operation",
        "ref": "core:streak",
        "params": {
          "plate": "=plate",
          "tool": "=loop",
          "sector": 1
        }
      },
      {
        "id": "draw-out",
        "kind": "group",
        "forEach": {
          "var": "k",
          "in": "=range(2, sectors, sectors - 1)"
        },
        "steps": [
          {
            "id": "reflame",
            "kind": "operation",
            "ref": "core:sterilise",
            "params": {
              "tool": "=loop"
            }
          },
          {
            "id": "next",
            "kind": "operation",
            "ref": "core:streak",
            "params": {
              "plate": "=plate",
              "tool": "=loop",
              "sector": "=k"
            }
          }
        ]
      },
      {
        "id": "done",
        "kind": "operation",
        "ref": "core:sterilise",
        "params": {
          "tool": "=loop"
        }
      }
    ],
    "errors": [
      {
        "id": "no-flaming",
        "statement": "The loop is not flamed between sectors",
        "consequence": "Each sector gets most of what the loop carried: no single colonies anywhere (core:streak)",
        "tag": "unflamed-streak"
      }
    ],
    "skills": [
      "micro:streak-plating",
      "micro:aseptic-technique"
    ]
  },
