        "container": "core:dropper-bottle-10ml"
      },
      {
        "id": "btb",
        "label": "Bromothymol blue",
        "preparation": "core:bromothymol-blue-indicator",
        "amount": "10 mL",
        "container": "core:dropper-bottle-10ml"
      },
      {
        "id": "buf4",
        "label": "pH 4.00 buffer",
        "preparation": "core:ph-buffer-4",
        "amount": "50 mL",
        "container": "core:beaker-100ml"
      },
      {
        "id": "buf7",
        "label": "pH 7.00 buffer",
        "preparation": "core:ph-buffer-7",
        "amount": "50 mL",
        "container": "core:beaker-100ml"
      }
    ]
  },
  "equipment": {
    "roles": [
      {
        "id": "meter",
        "requires": {
          "class": "core:ph-meter.benchtop"
        }
      },
      {
        "id": "dropper",
        "requires": {
          "class": "core:pasteur-pipette"
        }
      },
      {
        "id": "eye",
        "requires": {
          "class": "core:visual-inspection"
        }
      }
    ]
  },
  "procedure": {
    "fidelity": "prescribed-tolerant",
    "steps": [
      {
        "id": "calibrate",
        "kind": "operation",
        "ref": "core:calibrate",
        "params": {
          "instrument": "meter",
          "mode": "two-point",
          "buffers": [
            "buf4",
            "buf7"
          ]
        },
        "objectives": [
          "o-measure"
        ]
      },
      {
        "id": "solutions",
        "kind": "group",
        "title": "Measure each solution and test it with indicator",
        "forEach": {
          "var": "x",
          "in": "{{samples}}"
        },
        "objectives": [
          "o-measure",
          "o-observe"
        ],
        "steps": [
          {
            "id": "beaker",
            "kind": "operation",
            "ref": "core:fetch",
            "params": {
              "equipment": "core:beaker-100ml",
              "id": "='b-' + x",
              "label": "='Beaker ' + x"
            }
          },
          {
            "id": "pour",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "=x",
              "destination": "='b-' + x",
              "volume": "20 mL"
            }
          },
          {
            "id": "ph",
            "kind": "operation",
            "ref": "core:measure",
            "params": {
              "instrument": "meter",
              "subject": "='b-' + x"
            }
          },
          {
            "id": "note-ph",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "='ph-' + x",
              "value": "=ph.out.value"
            }
          },
          {
            "id": "indicators",
            "kind": "group",
            "title": "Indicator colours",
            "forEach": {
              "var": "y",
              "in": "{{indicators}}"
            },
            "steps": [
              {
                "id": "tube",
                "kind": "operation",
                "ref": "core:fetch",
                "params": {
                  "equipment": "core:test-tube",
                  "id": "='t-' + x + '-' + y",
                  "label": "=x + ' with ' + y"
                }
              },
              {
                "id": "sample",
                "kind": "operation",
                "ref": "core:transfer",
                "params": {
                  "source": "=x",
                  "destination": "='t-' + x + '-' + y",
                  "volume": "5 mL"
                }
              },
              {
                "id": "drops",
                "kind": "operation",
                "ref": "core:transfer",
                "params": {
                  "source": "=y",
                  "destination": "='t-' + x + '-' + y",
                  "volume": "0.1 mL",
                  "tool": "dropper"
                }
              },
              {
                "id": "shake",
                "kind": "operation",
                "ref": "core:mix",
                "params": {
                  "container": "='t-' + x + '-' + y",
                  "method": "swirl",
                  "cycles": 3
                }
              },
              {
                "id": "look",
                "kind": "operation",
                "ref": "core:measure",
                "params": {
                  "instrument": "eye",
                  "subject": "='t-' + x + '-' + y"
                }
              },
              {
                "id": "note",
                "kind": "operation",
                "ref": "core:record",
                "params": {
                  "field": "='seen-' + x + '-' + y",
                  "value": "=look.out.appearance"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "questions",
        "kind": "group",
        "title": "Explain your results",
        "objectives": [
          "o-explain"
        ],
        "steps": "{{questions}}"
      }
    ]
  },
  "goals": {
    "predicates": "{{goals}}",
    "expectedObservations": "{{observations}}"
  },
  "variants": [
    {
      "id": "chem30-indicators",
      "title": "Indicators and the pH scale",
      "summary": "Test hydrochloric and ethanoic acids, water, sodium hydrogencarbonate, ammonia and sodium hydroxide with litmus, methyl orange, phenolphthalein, bromothymol blue and universal indicator, and compare the colours with pH-meter readings.",
      "briefing": "Calibrate the pH meter with the pH 4 and pH 7 buffers and read the pH of each solution. Then put 5 mL of each solution into five test tubes and add two drops of a different indicator to each. Each indicator is a weak acid whose acid and base forms differ in colour, so it changes colour over its own narrow pH range. Universal indicator is a mixture that changes colour across the whole scale.",
      "values": {
        "level": "ages-14-16",
        "curricula": [
          "GCSE",
          "IGCSE",
          "BTEC",
          "Access to HE"
        ],
        "samples": "=['hcl', 'eth', 'water', 'bicarb', 'nh3', 'naoh']",
        "indicators": "=['litmus', 'mo', 'pp', 'btb', 'ui']",
        "explainObjective": "Explain why indicators change colour over different pH ranges, and why a strong and a weak acid of the same concentration differ in pH",
        "questions": [
          {
            "id": "q1",
            "kind": "decision",
            "objectives": [
              "o-explain"
            ],
            "prompt": "Why does universal indicator tell you more about a solution than litmus does?",
            "options": [
              {
                "id": "mixture",
                "label": "It is a mixture of indicators that change colour at different pHs, so it has a colour for each part of the scale"
              },
              {
                "id": "stronger",
                "label": "It reacts more strongly with acids"
              },
              {
                "id": "concentrated",
                "label": "It is more concentrated"
              }
            ],
            "correctWhen": "'mixture'"
          },
          {
            "id": "q2",
            "kind": "decision",
            "objectives": [
              "o-explain"
            ],
            "prompt": "Phenolphthalein stays colourless in both water and ethanoic acid. What does that tell you?",
            "options": [
              {
                "id": "not-alkaline",
                "label": "Only that neither is alkaline: phenolphthalein is colourless below about pH 8.5"
              },
              {
                "id": "both-acidic",
                "label": "Both are acidic"
              },
              {
                "id": "both-neutral",
                "label": "Both are neutral"
              }
            ],
            "correctWhen": "'not-alkaline'"
          },
          {
            "id": "q3",
            "kind": "decision",
            "objectives": [
              "o-explain"
            ],
            "prompt": "Hydrochloric and ethanoic acids are both 0.1 M. Why is ethanoic acid's pH higher?",
            "options": [
              {
                "id": "weak",
                "label": "Ethanoic acid is weak: only a small fraction of its molecules give up H⁺"
              },
              {
                "id": "dilute",
                "label": "It is more dilute"
              },
              {
                "id": "organic",
                "label": "Organic acids are always neutral"
              }
            ],
            "correctWhen": "'weak'"
          }
        ],
        "goals": [
          {
            "id": "g-q1",
            "statement": "Universal indicator is explained",
            "check": "decision('q1') == 'mixture'"
          },
          {
            "id": "g-q2",
            "statement": "Phenolphthalein's range is explained",
            "check": "decision('q2') == 'not-alkaline'"
          },
          {
            "id": "g-q3",
            "statement": "Strong and weak acids are distinguished",
            "check": "decision('q3') == 'weak'"
          }
        ],
        "observations": [
          {
            "id": "e-ph",
            "statement": "Hydrochloric acid reads about pH 1, ethanoic acid about pH 3 and sodium hydroxide about pH 13",
            "check": "first(recorded('ph-hcl')) < 1.5 && abs(first(recorded('ph-eth')) - 2.9) < 0.4 && first(recorded('ph-naoh')) > 12.5",
            "source": "reference-standard"
          },
          {
            "id": "e-litmus",
            "statement": "Litmus is red in the acids and blue in the alkalis",
            "check": "mentions(first(recorded('seen-hcl-litmus')), 'red|pink') && mentions(first(recorded('seen-naoh-litmus')), 'blue|violet|purple')",
            "source": "reference-standard"
          },
          {
            "id": "e-indicators",
            "statement": "Phenolphthalein turns pink only in alkali; methyl orange is red in acid and orange-yellow in alkali; bromothymol blue is yellow in acid and blue in alkali",
            "check": "mentions(first(recorded('seen-naoh-pp')), 'pink|magenta|purple|red|violet') && first(recorded('seen-hcl-pp')) == 'clear' && mentions(first(recorded('seen-hcl-mo')), 'red|pink') && mentions(first(recorded('seen-naoh-mo')), 'yellow|orange') && !mentions(first(recorded('seen-naoh-mo')), 'red|pink') && mentions(first(recorded('seen-hcl-btb')), 'yellow') && mentions(first(recorded('seen-naoh-btb')), 'blue|violet')",
            "source": "reference-standard"
          }
        ]
      },
      "keywords": [
        "indicator",
        "litmus",
        "phenolphthalein",
        "methyl orange",
        "bromothymol blue",
        "universal indicator",
        "strong and weak acids"
      ]
    }
  ],
  "provenance": {
    "defaultClass": "general-knowledge",
    "review": {
      "status": "draft"
    }
  }
}
