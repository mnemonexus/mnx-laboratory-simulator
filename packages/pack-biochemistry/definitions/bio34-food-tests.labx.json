{
  "format": "lab-experiment",
  "formatVersion": "0.1",
  "id": "bio34-food-tests",
  "version": "1.0.0",
  "title": "Food tests",
  "language": "en-GB",
  "requires": {
    "framework": ">=0.1"
  },
  "summary": "Test glucose, table sugar, starch, egg white, vegetable oil and water for starch (iodine), reducing sugar (Benedict’s), non-reducing sugar (acid, then Benedict’s), protein (biuret) and lipid (Sudan III).",
  "briefing": "Each test has its own tube of 2 mL of food. Iodine solution turns blue-black with starch. Benedict’s reagent, heated in a boiling water bath, gives a green, yellow, orange or brick-red precipitate with a reducing sugar: the more sugar, the further along. A non-reducing sugar (sucrose) must first be split by boiling with acid; neutralise with sodium hydrogencarbonate before adding Benedict’s, which only works in alkali. Biuret reagent turns from blue to violet with protein. Sudan III stains lipid red: shake the food with water and the stain, and a red oily layer rises to the top.",
  "context": {
    "intendedContexts": [
      "practical-session",
      "lecture-introduction",
      "assessment"
    ],
    "audience": {
      "level": "ages-14-16",
      "disciplines": [
        "biology"
      ]
    },
    "keywords": [
      "food tests",
      "starch",
      "iodine",
      "Benedict’s",
      "reducing sugar",
      "non-reducing sugar",
      "biuret",
      "protein",
      "lipid",
      "Sudan III",
      "biological molecules"
    ],
    "topics": [
      "Biological molecules",
      "Nutrition"
    ],
    "concepts": [
      {
        "id": "tests",
        "label": "Each class of biological molecule has a specific chemical test"
      },
      {
        "id": "reducing",
        "label": "Reducing sugars reduce copper(II) to copper(I) oxide in hot alkali"
      }
    ],
    "objectives": [
      {
        "id": "o-test",
        "kind": "skill",
        "statement": "Carry out the food tests safely, heating in a water bath"
      },
      {
        "id": "o-identify",
        "kind": "outcome",
        "statement": "Identify which foods contain starch, sugars, protein and lipid",
        "goal": "g-identify"
      },
      {
        "id": "o-reason",
        "kind": "reasoning",
        "statement": "Explain the non-reducing sugar test",
        "goal": "g-neutralise"
      }
    ],
    "curricula": [
      "GCSE",
      "IGCSE",
      "A level",
      "IB",
      "BTEC",
      "Access to HE"
    ]
  },
  "materials": {
    "supplies": [
      {
        "id": "glucose",
        "label": "Glucose solution (2 %)",
        "contains": [
          {
            "substance": "core:glucose",
            "conc": "20 g/L"
          }
        ],
        "solvent": "core:water",
        "amount": "50 mL",
        "container": "core:reagent-bottle-250ml"
      },
      {
        "id": "sucrose",
        "label": "Table sugar solution (2 %)",
        "contains": [
          {
            "substance": "core:sucrose",
            "conc": "20 g/L"
          }
        ],
        "solvent": "core:water",
        "amount": "50 mL",
        "container": "core:reagent-bottle-250ml"
      },
      {
        "id": "starch",
        "label": "Starch suspension (1 %)",
        "contains": [
          {
            "substance": "core:starch-soluble",
            "conc": "10 g/L"
          }
        ],
        "solvent": "core:water",
        "amount": "50 mL",
        "container": "core:reagent-bottle-250ml"
      },
      {
        "id": "egg",
        "label": "Egg white, diluted",
        "contains": [
          {
            "substance": "bio:ovalbumin",
            "conc": "50 g/L"
          }
        ],
        "solvent": "core:water",
        "amount": "50 mL",
        "container": "core:reagent-bottle-250ml"
      },
      {
        "id": "oil",
        "label": "Vegetable oil",
        "contains": [
          {
            "substance": "core:vegetable-oil",
            "conc": "920 g/L"
          }
        ],
        "solvent": "core:vegetable-oil",
        "amount": "50 mL",
