            "contains": [
              {
                "substance": "aq:hydrochloric-acid",
                "conc": "1.0 mol/L"
              }
            ],
            "solvent": "core:water",
            "amount": "250 mL",
            "container": "core:reagent-bottle-1l"
          },
          {
            "id": "naoh",
            "label": "Sodium hydroxide, 1.0 M",
            "contains": [
              {
                "substance": "aq:sodium-hydroxide",
                "conc": "1.0 mol/L"
              }
            ],
            "solvent": "core:water",
            "amount": "250 mL",
            "container": "core:reagent-bottle-1l"
          },
          {
            "id": "nahco3",
            "label": "Sodium hydrogencarbonate, 1.0 M",
            "contains": [
              {
                "substance": "core:sodium-bicarbonate",
