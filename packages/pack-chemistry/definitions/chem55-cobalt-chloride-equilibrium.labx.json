{
  "format": "lab-experiment",
  "formatVersion": "0.1",
  "id": "chem55-cobalt-chloride-equilibrium",
  "version": "1.0.0",
  "language": "en-GB",
  "requires": {
    "framework": ">=0.1"
  },
  "title": "Le Chatelier’s principle: the cobalt(II) chloride equilibrium",
  "summary": "Shift the equilibrium between pink hexaaquacobalt(II) and blue tetrachlorocobaltate(II) by adding chloride, adding water, heating and cooling, and use the colour changes to find the sign of ΔH.",
  "briefing": "Co(H₂O)₆²⁺ (pink) + 4Cl⁻ ⇌ CoCl₄²⁻ (blue) + 6H₂O. To 2 mL of 0.5 M cobalt(II) chloride add 6 mL of concentrated hydrochloric acid, then 10 mL of water. Make three tubes of 2 mL of 0.2 M cobalt(II) chloride with 0.9 mL of the acid (between the two colours, purple): stand one in a water bath at 80 °C, one in ice, and keep one at room temperature to compare. Wear goggles and gloves: concentrated acid is corrosive and cobalt salts are toxic.",
  "context": {
    "intendedContexts": [
      "practical-session",
      "lecture-introduction",
      "assessment"
    ],
    "audience": {
      "level": "ages-16-19",
      "disciplines": [
        "chemistry"
      ]
    },
    "keywords": [
      "Le Chatelier",
      "equilibrium",
      "cobalt chloride",
      "complex ions",
      "enthalpy change",
      "temperature"
    ],
    "topics": [
      "Equilibrium",
      "Transition metals"
    ],
    "concepts": [
      {
        "id": "lechatelier",
        "label": "An equilibrium shifts to oppose a change: more chloride or heat (for an endothermic forward reaction) favours the blue complex"
      }
    ],
    "objectives": [
      {
        "id": "o-observe",
        "kind": "skill",
        "statement": "Observe the equilibrium shift with concentration and temperature"
      },
      {
        "id": "o-shift",
        "kind": "analysis",
        "statement": "Explain the shifts with Le Chatelier’s principle",
        "goal": "g-shift"
      },
      {
        "id": "o-explain",
        "kind": "reasoning",
        "statement": "Deduce the sign of ΔH",
        "goal": "g-explain"
      }
    ],
    "curricula": [
      "A level",
      "IB",
      "AP"
    ]
  },
  "materials": {
    "supplies": [
      {
        "id": "cobalt",
        "label": "Cobalt(II) chloride, 0.2 M (toxic)",
        "contains": [
          {
            "substance": "aq:cobalt-ii-chloride",
            "conc": "0.2 mol/L"
          }
        ],
        "solvent": "core:water",
        "amount": "50 mL",
        "container": "core:reagent-bottle-50ml"
      },
      {
        "id": "cobalt-strong",
        "label": "Cobalt(II) chloride, 0.5 M (toxic)",
        "contains": [
          {
            "substance": "aq:cobalt-ii-chloride",
            "conc": "0.5 mol/L"
          }
        ],
        "solvent": "core:water",
        "amount": "50 mL",
        "container": "core:reagent-bottle-50ml"
      },
      {
        "id": "hcl",
        "label": "Hydrochloric acid, concentrated (10 M, corrosive)",
        "contains": [
          {
            "substance": "core:hydrochloric-acid",
            "conc": "10 mol/L"
          }
        ],
        "solvent": "core:water",
        "amount": "50 mL",
        "container": "core:reagent-bottle-50ml"
      },
      {
        "id": "water",
        "label": "Deionised water",
        "preparation": "core:water-deionised",
        "amount": "100 mL",
        "container": "core:reagent-bottle-250ml"
      }
    ]
  },
