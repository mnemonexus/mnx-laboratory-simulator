            "id": "load-well",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "=x[0]",
              "destination": "=x[1]",
              "volume": "50 uL"
            }
          }
        ],
        "forEach": {
          "var": "x",
          "in": "=[['d0', 'plate/A2'], ['d0', 'plate/A3'], ['prime', 'plate/A4'], ['prime', 'plate/A5'], ['boost1', 'plate/A6'], ['boost1', 'plate/A7'], ['boost2', 'plate/A8'], ['boost2', 'plate/A9'], ['boost2', 'plate/A10'], ['boost2', 'plate/A11']]"
        },
        "objectives": [
          "o-elisa"
        ]
      },
      {
        "id": "dilute",
        "kind": "group",
        "title": "Three-fold down each column: mix, then 50 µL on; 50 µL from row H discarded",
        "steps": [
          {
            "id": "down",
            "kind": "group",
            "title": "Down the column",
            "steps": [
              {
                "id": "mix-well",
                "kind": "operation",
                "ref": "core:mix",
                "params": {
                  "container": "='plate/' + r[0] + text(col)",
