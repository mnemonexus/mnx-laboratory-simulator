    "roles": [
      {
        "id": "dropper",
        "requires": {
          "class": "core:pasteur-pipette"
        }
      },
      {
        "id": "eye",
        "requires": {
          "class": "core:visual-inspection"
        }
      },
      {
        "id": "bath",
        "requires": {
          "class": "core:water-bath",
          "temperature": "95 Cel"
        }
      }
    ]
  },
  "procedure": {
    "fidelity": "prescribed-tolerant",
    "steps": [
      {
        "id": "set-bath",
        "kind": "operation",
        "ref": "core:set-environment",
        "params": {
          "device": "bath",
          "temperature": "95 Cel"
        }
      },
      {
        "id": "foods",
        "kind": "group",
        "title": "Test each food",
        "objectives": [
          "o-test"
        ],
        "forEach": {
          "var": "x",
          "in": "=['glucose', 'sucrose', 'starch', 'egg', 'oil', 'water']"
        },
        "steps": [
          {
            "id": "test-iodine",
            "kind": "group",
            "title": "Starch: iodine solution",
            "steps": [
              {
                "id": "iodine-tube",
                "kind": "operation",
                "ref": "core:fetch",
                "params": {
                  "equipment": "core:test-tube",
                  "id": "='t-' + x + '-iodine'",
                  "label": "=x + ': starch: iodine solution'"
                }
              },
              {
                "id": "iodine-sample",
                "kind": "operation",
                "ref": "core:transfer",
                "params": {
                  "source": "=x",
                  "destination": "='t-' + x + '-iodine'",
                  "volume": "2 mL",
                  "tool": "dropper"
                }
              },
              {
                "id": "iodine-add",
                "kind": "operation",
                "ref": "core:transfer",
                "params": {
                  "source": "iodine",
                  "destination": "='t-' + x + '-iodine'",
                  "volume": "0.1 mL",
                  "tool": "dropper"
                }
              },
              {
                "id": "iodine-mix",
                "kind": "operation",
                "ref": "core:mix",
                "params": {
                  "container": "='t-' + x + '-iodine'",
                  "method": "swirl",
                  "cycles": 3
                }
              },
              {
                "id": "iodine-look",
                "kind": "operation",
                "ref": "core:measure",
                "params": {
                  "instrument": "eye",
                  "subject": "='t-' + x + '-iodine'"
                }
              },
              {
                "id": "iodine-note",
                "kind": "operation",
                "ref": "core:record",
                "params": {
                  "field": "='seen-' + x + '-iodine'",
                  "value": "=iodine-look.out.appearance"
                }
              }
            ]
          },
          {
            "id": "test-benedict",
            "kind": "group",
