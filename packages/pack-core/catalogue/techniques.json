  {
    "id": "core:titrate-to-endpoint",
    "version": 1,
    "status": "experimental",
    "label": "Titrate to the end point",
    "description": "Without an estimate, add titrant in steps until the indicator changes (a rough titration). With one, add quickly to about 1 mL short, then drop by drop, swirling, until the colour persists.",
    "purposes": [
      "analyse.titration"
    ],
    "params": {
      "burette": {
        "type": "container",
        "required": true
      },
      "flask": {
        "type": "container",
        "required": true
      },
      "endColour": {
        "type": "text",
        "default": "pink",
        "description": "The colour at the end point (for a precipitate, any of several names separated by |)"
      },
      "approx": {
        "type": "quantity",
        "dimension": "volume",
        "description": "Expected titre (from a rough titration)"
      },
      "increment": {
        "type": "quantity",
        "dimension": "volume",
        "default": "0.5 mL"
      },
      "drop": {
        "type": "quantity",
        "dimension": "volume",
        "default": "0.05 mL"
      },
      "watch": {
        "type": "enum",
        "values": [
          "solution",
          "precipitate"
        ],
        "default": "solution",
        "description": "What changes colour at the end point: the solution (an indicator) or the precipitate (chromate in a Mohr titration)"
      }
    },
    "steps": [
      {
        "id": "rough",
        "kind": "group",
        "when": "approx == null",
        "repeat": {
          "until": "if(watch == \"precipitate\", mentions(precipitateColour(flask), endColour), colour(flask) == endColour)",
          "max": 200
        },
        "steps": [
          {
            "id": "add",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "=burette",
              "destination": "=flask",
              "volume": "=increment"
            }
          },
          {
            "id": "swirl",
            "kind": "operation",
            "ref": "core:mix",
            "params": {
              "container": "=flask",
              "method": "swirl"
            }
          }
        ]
      },
      {
        "id": "quick",
        "kind": "operation",
        "ref": "core:transfer",
        "when": "approx != null && approx > 1 mL",
        "params": {
          "source": "=burette",
          "destination": "=flask",
          "volume": "=approx - 1 mL"
        }
      },
      {
        "id": "settle",
        "kind": "operation",
        "ref": "core:mix",
        "when": "approx != null",
        "params": {
          "container": "=flask",
          "method": "swirl"
        }
      },
      {
        "id": "dropwise",
        "kind": "group",
        "when": "approx != null && !if(watch == \"precipitate\", mentions(precipitateColour(flask), endColour), colour(flask) == endColour)",
        "repeat": {
          "until": "if(watch == \"precipitate\", mentions(precipitateColour(flask), endColour), colour(flask) == endColour)",
          "max": 400
        },
        "steps": [
          {
            "id": "add-drop",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "=burette",
              "destination": "=flask",
              "volume": "=drop"
            }
          },
          {
            "id": "swirl-drop",
            "kind": "operation",
            "ref": "core:mix",
            "params": {
              "container": "=flask",
              "method": "swirl"
            }
          }
        ]
      }
    ],
    "quality": [
      {
        "id": "end-colour",
        "statement": "Stopped at the end-point colour",
        "check": "if(watch == \"precipitate\", mentions(precipitateColour(flask), endColour), colour(flask) == endColour)",
        "severity": "major",
        "skills": [
          "core:titration"
        ],
        "feedbackKind": "procedural"
      }
    ],
    "errors": [
      {
        "id": "overshoot",
        "statement": "Titrant added too fast near the end point",
        "consequence": "The titre is too large and the solution is deep pink (equilibrium.acid-base)",
        "tag": "titration-endpoint-overshoot"
      }
    ],
    "skills": [
      "core:titration",
      "core:burette-technique"
    ]
  },
  {
    "id": "core:load-rotor",
    "version": 1,
    "status": "experimental",
    "label": "Load a centrifuge rotor in balance",
    "description": "Place tubes in opposite pairs. With an odd number, make a balance tube of the same kind, filled with water to the same volume.",
    "purposes": [
      "separate.solid-from-liquid"
    ],
    "params": {
      "tubes": {
        "type": "list",
        "items": {
          "type": "container"
        },
        "required": true
      },
      "by": {
        "type": "enum",
        "values": [
          "volume",
          "mass"
        ],
        "default": "volume",
        "description": "Fill the balance tube with water to the same volume, or to the same mass (for dense solutions)"
      }
    },
    "roles": {
      "rotor": {
        "kind": "equipment",
        "requires": {
          "purpose": "separate.solid-from-liquid"
        },
        "prefer": [
          "core:microcentrifuge-24"
        ]
      }
    },
    "derived": {
      "odd": "=mod(count(tubes), 2) == 1"
    },
    "steps": [
      {
        "id": "balance-tube",
        "kind": "operation",
        "ref": "core:fetch",
        "when": "odd",
        "params": {
          "equipment": "=equipmentOf(tubes[0])",
          "id": "balance-tube",
          "label": "Balance",
          "fill": {
            "preparation": "core:water-deionised",
            "amount": "=if(by == 'mass', weight(tubes[0]) / (0.997 g/mL), volume(tubes[0]))"
          }
        }
      },
      {
        "id": "close-balance",
        "kind": "operation",
        "ref": "core:close",
        "when": "odd",
        "params": {
          "container": "balance-tube"
        }
      },
      {
        "id": "close",
        "kind": "operation",
        "ref": "core:close",
        "forEach": {
          "var": "t",
          "in": "=tubes"
        },
        "params": {
          "container": "=t"
        }
      },
      {
        "id": "pairs",
        "kind": "group",
        "let": {
          "all": "=if(odd, tubes + ['balance-tube'], tubes)",
          "half": "=count(all) / 2"
        },
        "steps": [
          {
            "id": "pair",
            "kind": "group",
            "forEach": {
              "var": "k",
              "in": "=range(0, half - 1, half)"
            },
            "steps": [
              {
                "id": "first",
                "kind": "operation",
                "ref": "core:place-in",
                "params": {
                  "container": "=all[2 * k]",
                  "place": "=rotor",
                  "position": "=k + 1"
                }
              },
              {
                "id": "opposite",
                "kind": "operation",
                "ref": "core:place-in",
                "params": {
                  "container": "=all[2 * k + 1]",
                  "place": "=rotor",
                  "position": "=k + 13"
                }
              }
            ]
          }
        ]
      }
    ],
    "quality": [
      {
        "id": "balanced",
        "statement": "The rotor is in balance",
        "check": "rotorImbalance(rotor) <= 0.1 g",
        "severity": "critical",
        "skills": [
          "core:centrifuge-balancing"
        ],
        "feedbackKind": "safety"
      }
    ],
    "errors": [
      {
        "id": "unbalanced",
        "statement": "Tubes not in opposite pairs, or no balance tube for an odd number",
        "consequence": "The rotor runs out of balance: vibration, an automatic stop and an incident (core:centrifuge)",
        "tag": "rotor-imbalance"
      }
    ],
    "skills": [
      "core:centrifuge-balancing"
    ]
  },
  {
    "id": "core:vacuum-filtration",
    "version": 1,
    "status": "experimental",
    "label": "Collect a solid by vacuum filtration",
    "description": "Pour the mixture onto a Büchner funnel under suction, then wash the cake with small portions of cold solvent, draining after each.",
    "purposes": [
      "separate.solid-from-liquid"
    ],
    "params": {
      "source": {
        "type": "container",
        "required": true
      },
      "wash": {
        "type": "container",
        "description": "Cold solvent to wash the cake; omitted = no wash"
      },
      "washVolume": {
        "type": "quantity",
        "dimension": "volume",
        "default": "5 mL"
      },
      "washes": {
        "type": "integer",
        "default": 2
      }
    },
    "roles": {
      "funnel": {
        "kind": "container",
        "requires": {
          "purpose": "separate.solid-from-liquid"
        },
        "prefer": [
          "core:buchner-funnel-70mm"
        ]
      },
      "flask": {
        "kind": "container",
        "requires": {
          "class": "core:filter-flask-250ml"
        },
        "prefer": [
          "core:filter-flask-250ml"
        ]
      }
    },
    "steps": [
      {
        "id": "collect",
        "kind": "operation",
        "ref": "core:filter",
        "params": {
          "source": "=source",
          "filter": "=funnel",
          "filtrate": "=flask"
        }
      },
      {
        "id": "wash-cake",
        "kind": "group",
        "when": "wash != null",
        "repeat": {
          "times": "=washes"
        },
        "steps": [
          {
            "id": "add-wash",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "=wash",
              "destination": "=funnel",
              "volume": "=washVolume",
              "tool": "pour"
            }
          },
          {
            "id": "drain",
            "kind": "operation",
            "ref": "core:filter",
            "params": {
              "filter": "=funnel",
              "filtrate": "=flask"
            }
          }
        ]
      }
    ],
    "outputs": {
      "cake": "=funnel",
      "filtrate": "=flask"
    },
    "errors": [
      {
        "id": "unwashed",
        "statement": "The cake is not washed",
        "consequence": "The mother liquor left in the cake dries onto the product with everything dissolved in it (core:filter)",
        "tag": "unwashed-cake"
      },
      {
        "id": "warm-wash",
        "statement": "The cake is washed with warm or large portions of solvent",
        "consequence": "The wash dissolves product: the yield falls (solubility model)",
        "tag": "warm-wash"
      }
    ],
    "skills": [
      "core:vacuum-filtration"
    ]
  },
