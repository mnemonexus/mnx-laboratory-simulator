{
  "format": "lab-experiment",
  "formatVersion": "0.1",
  "id": "molbio9-gyra-rflp",
  "version": "1.0.0",
  "title": "Fluoroquinolone resistance by PCR-RFLP: gyrA codon 83",
  "language": "en-GB",
  "requires": {
    "framework": ">=0.1",
    "capabilities": [
      {
        "technique": "molbio:pcr"
      },
      {
        "technique": "molbio:agarose-gel"
      }
    ]
  },
  "summary": "Amplify the quinolone resistance-determining region of gyrA from four urinary E. coli isolates and a sensitive reference strain, digest the products with HinfI, whose site at codon 83 the Ser83Leu mutation removes, and read each isolate's genotype from a 2 % gel.",
  "briefing": "In wild-type gyrA, codons 82 and 83 (GAC TCG) contain a HinfI site (GANTC). The commonest fluoroquinolone-resistance mutation, Ser83Leu (TCG to TTG), destroys it. The 350 bp product of a wild-type gene is cut into about 210 and 140 bp; a Ser83Leu product stays whole; a culture holding both shows all three. Digest the sensitive reference strain alongside, and keep one product uncut.",
  "context": {
    "intendedContexts": [
      "practical-session",
      "transferal"
    ],
    "audience": {
      "level": "undergraduate-1",
      "disciplines": [
        "biomedical-science",
        "microbiology",
        "molecular-biology"
      ]
    },
    "concepts": [
      {
        "id": "snp-site",
        "label": "A point mutation that destroys a restriction site"
      },
      {
        "id": "digest-control",
        "label": "Controls for a loss-of-site assay"
      },
      {
        "id": "mixed-population",
        "label": "Mixed populations and resistance selection"
      }
    ],
    "objectives": [
      {
        "id": "o-pcr",
        "kind": "skill",
        "statement": "Set up PCRs with a reference strain and a no-template control",
        "skills": [
          "molbio:pcr-setup",
          "core:micropipetting"
        ]
      },
      {
        "id": "o-digest",
        "kind": "skill",
        "statement": "Digest the products and run them on a gel",
        "skills": [
          "molbio:gel-electrophoresis"
        ]
      },
      {
        "id": "o-genotype",
        "kind": "reasoning",
        "statement": "Assign each isolate's genotype, justify the digest control and advise on treatment",
        "goal": "g-genotypes"
      }
    ]
  },
  "materials": {
    "samples": [
      {
        "id": "iso-1",
        "label": "Isolate 1 DNA (10 ng/µL)",
        "role": "unknown",
        "solvent": "core:water",
        "amount": "20 uL",
        "container": "core:microtube-1.5ml",
        "contains": [
          {
            "substance": "molbio:ecoli-gdna-gyra-wt",
            "conc": "10 ng/uL"
          }
        ]
      },
      {
        "id": "iso-2",
        "label": "Isolate 2 DNA (10 ng/µL)",
        "role": "unknown",
        "solvent": "core:water",
        "amount": "20 uL",
        "container": "core:microtube-1.5ml",
        "contains": [
          {
            "substance": "molbio:ecoli-gdna-gyra-s83l",
            "conc": "10 ng/uL"
          }
        ]
      },
      {
        "id": "iso-3",
        "label": "Isolate 3 DNA (10 ng/µL)",
        "role": "unknown",
        "solvent": "core:water",
        "amount": "20 uL",
        "container": "core:microtube-1.5ml",
        "contains": [
          {
            "substance": "molbio:ecoli-gdna-gyra-wt",
            "conc": "6 ng/uL"
          },
          {
            "substance": "molbio:ecoli-gdna-gyra-s83l",
            "conc": "4 ng/uL"
          }
        ]
      },
      {
        "id": "iso-4",
        "label": "Isolate 4 DNA (10 ng/µL)",
        "role": "unknown",
        "solvent": "core:water",
        "amount": "20 uL",
        "container": "core:microtube-1.5ml",
        "contains": [
          {
            "substance": "molbio:ecoli-gdna-gyra-s83l",
            "conc": "10 ng/uL"
          }
        ]
      },
      {
        "id": "ref",
        "label": "Reference strain DNA, ciprofloxacin-sensitive (10 ng/µL)",
        "role": "unknown",
        "solvent": "core:water",
        "amount": "20 uL",
        "container": "core:microtube-1.5ml",
        "contains": [
          {
            "substance": "molbio:ecoli-gdna-gyra-wt",
            "conc": "10 ng/uL"
          }
        ]
      }
    ],
    "supplies": [
      {
        "id": "mastermix",
        "label": "PCR master mix (2×)",
        "preparation": "molbio:pcr-master-mix-2x",
        "amount": "500 uL",
        "container": "core:microtube-1.5ml",
        "storage": "0 Cel"
      },
      {
        "id": "primers",
        "label": "gyrA primer mix (10 µM each)",
        "solvent": "core:water",
        "contains": [
          {
            "substance": "molbio:gyra-forward-primer",
            "conc": "10 uM"
          },
          {
            "substance": "molbio:gyra-reverse-primer",
            "conc": "10 uM"
          }
        ],
        "amount": "100 uL",
        "container": "core:microtube-1.5ml",
        "storage": "0 Cel"
      },
      {
        "id": "water",
        "label": "Nuclease-free water",
        "preparation": "core:water-deionised",
        "amount": "1 mL",
        "container": "core:microtube-1.5ml"
      },
      {
        "id": "buffer",
        "label": "Restriction buffer (10×)",
        "preparation": "molbio:restriction-buffer-10x",
        "amount": "100 uL",
        "container": "core:microtube-1.5ml",
        "storage": "0 Cel"
      },
      {
        "id": "hinfi",
        "label": "HinfI (10 U/µL)",
        "preparation": "molbio:hinfi-10u",
        "amount": "20 uL",
        "container": "core:microtube-1.5ml",
        "storage": "0 Cel"
      },
      {
        "id": "dye",
        "label": "Loading dye (6×)",
        "preparation": "molbio:loading-dye-6x",
        "amount": "100 uL",
        "container": "core:microtube-1.5ml"
      },
      {
        "id": "ladder",
        "label": "100 bp ladder",
        "preparation": "molbio:ladder-100bp",
        "amount": "50 uL",
        "container": "core:microtube-1.5ml"
      }
    ]
  },
  "equipment": {
    "roles": [
      {
        "id": "bath",
        "requires": {
          "class": "core:water-bath",
          "temperature": "37 Cel"
        }
      },
      {
        "id": "gel",
        "requires": {
          "class": "core:agarose-gel-2pct"
        }
      }
    ]
  },
  "procedure": {
    "fidelity": "prescribed-tolerant",
    "steps": [
      {
        "id": "setup",
        "kind": "group",
        "title": "Six 25 µL reactions: four isolates, the reference strain and a no-template control",
        "steps": [
          {
            "id": "tube",
            "kind": "operation",
            "ref": "core:fetch",
            "params": {
              "equipment": "core:pcr-tube-0.2ml",
              "id": "=x[0]",
              "label": "=x[0]"
            }
          },
          {
            "id": "water-in",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "water",
              "destination": "=x[0]",
              "volume": "10.25 uL"
            }
          },
          {
            "id": "mix-in",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "mastermix",
              "destination": "=x[0]",
              "volume": "12.5 uL"
            }
          },
          {
            "id": "primers-in",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "primers",
              "destination": "=x[0]",
              "volume": "1.25 uL"
            }
          },
          {
            "id": "template",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "=x[1]",
              "destination": "=x[0]",
              "volume": "1 uL"
            }
          },
          {
            "id": "flick",
            "kind": "operation",
            "ref": "core:mix",
            "params": {
              "container": "=x[0]",
              "method": "flick",
              "cycles": 3
            }
          }
        ],
        "forEach": {
          "var": "x",
          "in": "=[['pcr-1', 'iso-1'], ['pcr-2', 'iso-2'], ['pcr-3', 'iso-3'], ['pcr-4', 'iso-4'], ['pcr-ref', 'ref'], ['pcr-ntc', 'water']]"
        },
        "objectives": [
          "o-pcr"
        ]
      },
      {
        "id": "amplify",
        "kind": "technique",
        "ref": "molbio:pcr",
        "params": {
          "tubes": [
            "pcr-1",
            "pcr-2",
            "pcr-3",
            "pcr-4",
            "pcr-ref",
            "pcr-ntc"
          ],
          "cycles": 30,
          "annealTemperature": "58 Cel",
          "extendTime": "30 s"
        },
        "objectives": [
          "o-pcr"
        ]
      },
      {
        "id": "digests",
        "kind": "group",
        "title": "10 µL of each product with HinfI, the reference strain's too",
        "steps": [
          {
            "id": "d-tube",
            "kind": "operation",
            "ref": "core:fetch",
            "params": {
              "equipment": "core:microtube-1.5ml",
              "id": "=x[0]",
              "label": "=x[0]"
            }
          },
          {
            "id": "d-water",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "water",
              "destination": "=x[0]",
              "volume": "7 uL"
            }
          },
          {
            "id": "d-buffer",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "buffer",
              "destination": "=x[0]",
              "volume": "2 uL"
            }
          },
          {
            "id": "d-product",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "=x[1]",
              "destination": "=x[0]",
              "volume": "10 uL"
            }
          },
          {
            "id": "d-enzyme",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "hinfi",
              "destination": "=x[0]",
              "volume": "1 uL"
            }
          },
          {
            "id": "d-flick",
            "kind": "operation",
            "ref": "core:mix",
            "params": {
              "container": "=x[0]",
              "method": "flick",
              "cycles": 3
            }
          }
        ],
        "forEach": {
          "var": "x",
          "in": "=[['dig-1', 'pcr-1'], ['dig-2', 'pcr-2'], ['dig-3', 'pcr-3'], ['dig-4', 'pcr-4'], ['dig-ref', 'pcr-ref']]"
        },
        "objectives": [
          "o-digest"
        ]
      },
      {
        "id": "into-bath",
        "kind": "operation",
        "ref": "core:place-in",
        "params": {
          "container": "=x[0]",
          "place": "bath"
        },
        "forEach": {
          "var": "x",
          "in": "=[['dig-1', 'pcr-1'], ['dig-2', 'pcr-2'], ['dig-3', 'pcr-3'], ['dig-4', 'pcr-4'], ['dig-ref', 'pcr-ref']]"
        }
      },
      {
        "id": "digest",
        "kind": "operation",
        "ref": "core:advance-time",
        "params": {
          "duration": "60 min"
        }
      },
      {
        "id": "out-of-bath",
        "kind": "operation",
        "ref": "core:remove-from",
        "params": {
          "container": "=x[0]"
        },
        "forEach": {
          "var": "x",
          "in": "=[['dig-1', 'pcr-1'], ['dig-2', 'pcr-2'], ['dig-3', 'pcr-3'], ['dig-4', 'pcr-4'], ['dig-ref', 'pcr-ref']]"
        }
      },
      {
        "id": "dye",
        "kind": "group",
        "title": "Loading dye into every sample",
        "steps": [
          {
            "id": "dye-in",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "dye",
              "destination": "=x[0]",
              "volume": "4 uL"
            }
          },
          {
            "id": "dye-mix",
            "kind": "operation",
            "ref": "core:mix",
            "params": {
              "container": "=x[0]",
              "method": "flick",
              "cycles": 3
            }
          }
        ],
        "forEach": {
          "var": "x",
          "in": "=[['dig-ref', 'gel/A2'], ['dig-1', 'gel/A3'], ['dig-2', 'gel/A4'], ['dig-3', 'gel/A5'], ['dig-4', 'gel/A6'], ['pcr-ref', 'gel/A7'], ['pcr-ntc', 'gel/A8']]"
        }
      },
      {
        "id": "ladder-dye",
        "kind": "operation",
        "ref": "core:transfer",
        "params": {
          "source": "dye",
          "destination": "ladder",
          "volume": "10 uL"
        }
      },
      {
        "id": "ladder-mix",
        "kind": "operation",
        "ref": "core:mix",
        "params": {
          "container": "ladder",
          "method": "flick",
          "cycles": 3
        }
      },
      {
        "id": "electrophoresis",
        "kind": "technique",
        "ref": "molbio:agarose-gel",
        "objectives": [
          "o-digest"
        ],
        "params": {
          "gel": "gel",
          "ladder": "ladder",
          "ladderLane": "gel/A1",
          "loads": [
            [
              "dig-ref",
              "gel/A2"
            ],
            [
              "dig-1",
              "gel/A3"
            ],
            [
              "dig-2",
              "gel/A4"
            ],
            [
              "dig-3",
              "gel/A5"
            ],
            [
              "dig-4",
              "gel/A6"
            ],
            [
              "pcr-ref",
              "gel/A7"
            ],
            [
              "pcr-ntc",
              "gel/A8"
            ]
          ],
          "volume": "10 uL",
          "voltage": 100,
          "duration": "40 min"
        }
      },
      {
        "id": "sizing",
        "kind": "group",
        "title": "Size the bands in each lane against the ladder",
        "steps": [
          {
            "id": "size",
            "kind": "technique",
            "ref": "molbio:size-band",
            "params": {
              "ladderLane": "gel/A1",
              "lane": "=x[1]",
              "ladder": "molbio:ladder-100bp"
            }
          },
          {
            "id": "note",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "='sizes-' + x[0]",
              "value": "=size.out.sizes"
            }
          }
        ],
        "forEach": {
          "var": "x",
          "in": "=[['dig-ref', 'gel/A2'], ['dig-1', 'gel/A3'], ['dig-2', 'gel/A4'], ['dig-3', 'gel/A5'], ['dig-4', 'gel/A6'], ['pcr-ref', 'gel/A7'], ['pcr-ntc', 'gel/A8']]"
        }
      },
      {
        "id": "digest-ok",
        "kind": "decision",
        "objectives": [
          "o-genotype"
        ],
        "prompt": "The mutation removes the HinfI site, so a resistant allele is simply not cut. Why digest the sensitive reference strain alongside?",
        "options": [
          {
            "id": "control",
            "label": "A failed digest would leave every product whole and look resistant: the reference must be cut for the other lanes to be read"
          },
          {
            "id": "size",
            "label": "To find the size of the uncut product"
          },
          {
            "id": "none",
            "label": "It is not needed: the ladder is the control"
          }
        ],
        "correctWhen": "'control'"
      },
      {
        "id": "genotype",
        "kind": "decision",
        "objectives": [
          "o-genotype"
        ],
        "forEach": {
          "var": "s",
          "in": "=['1', '2', '3', '4']"
        },
        "prompt": "What does this isolate carry at gyrA codon 83?",
        "options": [
          {
            "id": "wt",
            "label": "Wild type: cut into about 210 and 140 bp"
          },
          {
            "id": "s83l",
            "label": "Ser83Leu: the 350 bp product is not cut"
          },
          {
            "id": "mixed",
            "label": "Both: a mixed culture (350, 210 and 140 bp)"
          }
        ],
        "correctWhen": "if(any(first(recorded('sizes-dig-' + s + '')), between(it, 180, 250)) && any(first(recorded('sizes-dig-' + s + '')), between(it, 110, 170)), if(any(first(recorded('sizes-dig-' + s + '')), between(it, 300, 420)), 'mixed', 'wt'), 's83l')"
      },
      {
        "id": "therapy",
        "kind": "decision",
        "objectives": [
          "o-genotype"
        ],
        "prompt": "Ciprofloxacin is being considered for the patient with isolate 3. What do you advise?",
        "options": [
          {
            "id": "avoid",
            "label": "Avoid it: part of the population carries Ser83Leu and would be selected by treatment"
          },
          {
            "id": "give",
            "label": "Give it: most of the cells are wild type"
          },
          {
            "id": "double",
            "label": "Give a double dose"
          }
        ],
        "correctWhen": "if(if(any(first(recorded('sizes-dig-3')), between(it, 180, 250)) && any(first(recorded('sizes-dig-3')), between(it, 110, 170)), if(any(first(recorded('sizes-dig-3')), between(it, 300, 420)), 'mixed', 'wt'), 's83l') == 'wt', 'give', 'avoid')"
      }
    ]
  },
  "goals": {
    "predicates": [
      {
        "id": "g-genotypes",
        "statement": "Every isolate is genotyped (1 wild type, 2 and 4 Ser83Leu, 3 mixed), the digest control is understood and isolate 3 is not treated with ciprofloxacin",
        "check": "decision(genotype, '1') == 'wt' && decision(genotype, '2') == 's83l' && decision(genotype, '3') == 'mixed' && decision(genotype, '4') == 's83l' && decision('digest-ok') == 'control' && decision('therapy') == 'avoid'"
      }
    ],
    "expectedObservations": [
      {
        "id": "e-ref",
        "statement": "The reference strain's product is cut completely: no 350 bp band",
        "check": "any(first(recorded('sizes-dig-ref')), between(it, 180, 250)) && any(first(recorded('sizes-dig-ref')), between(it, 110, 170)) && !any(first(recorded('sizes-dig-ref')), between(it, 300, 420))",
        "source": "simulation-derived"
      },
      {
        "id": "e-uncut",
        "statement": "The uncut product runs at about 350 bp",
        "check": "any(first(recorded('sizes-pcr-ref')), between(it, 300, 420)) && !any(first(recorded('sizes-pcr-ref')), between(it, 110, 250))",
        "source": "reference-standard"
      },
      {
        "id": "e-ntc",
        "statement": "The no-template control is clean",
        "check": "count(bandsIn('gel/A8')) == 0",
        "source": "reference-standard"
      }
    ]
  },
  "variation": {
    "noise": "default"
  },
  "provenance": {
    "defaultClass": "reference-standard",
    "review": {
      "status": "draft"
    }
  }
}
