            "id": "mx-h",
            "kind": "operation",
            "ref": "core:mix",
            "params": {
              "container": "='run-h-' + text(x[0])",
              "method": "invert",
              "cycles": 3
            }
          },
          {
            "id": "uc-h",
            "kind": "operation",
            "ref": "core:open",
            "params": {
              "container": "='run-h-' + text(x[0])"
            }
          },
          {
            "id": "rd-h",
            "kind": "operation",
            "ref": "core:measure",
            "params": {
              "instrument": "spec",
              "subject": "='run-h-' + text(x[0])",
              "wavelength": "405 nm",
              "mode": "kinetic",
              "interval": "3 s",
              "duration": "4 min"
            }
          },
          {
            "id": "ft-h",
            "kind": "data",
            "ref": "core:fit",
            "params": {
              "model": "first-order",
              "x": "=trace(rd-h).t",
              "y": "=trace(rd-h).a"
            }
          },
          {
            "id": "ko-h",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "kobs-h",
              "value": "=ft-h.out.fit.params.k"
            }
          },
          {
            "id": "oh-h",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "oh-h",
              "value": "=x[1]"
            }
          }
        ],
        "forEach": {
          "var": "x",
          "in": "=[[11, 0.01], [9, 0.006667], [7, 0.003333], [4, 0.001667]]"
        },
        "objectives": [
          "o-runs"
        ]
      },
      {
        "id": "k2-h",
        "kind": "data",
        "ref": "core:fit",
        "objectives": [
          "o-hammett"
        ],
        "params": {
          "model": "linear-through-origin",
          "x": "=recorded('oh-h')",
          "y": "=recorded('kobs-h')"
