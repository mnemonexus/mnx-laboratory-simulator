{
  "format": "lab-experiment",
  "formatVersion": "0.1",
  "id": "chem15-hammett-ester-hydrolysis",
  "version": "1.0.0",
  "title": "Substituent effects on ester hydrolysis: a Hammett plot from pseudo-first-order kinetics",
  "language": "en-GB",
  "requires": {
    "framework": ">=0.1",
    "capabilities": [
      {
        "operation": "core:measure"
      },
      {
        "operation": "core:fit"
      }
    ]
  },
  "summary": "Follow the hydrolysis of four 4-nitrophenyl benzoates (X = H, 4-Me, 4-Cl, 3-CF3) by the yellow 4-nitrophenolate they release at 405 nm, fit each trace for kobs, get the second-order rate constant from kobs against [OH⁻], and from a Hammett plot find ρ and what it says about the mechanism.",
  "briefing": "With hydroxide in large excess the hydrolysis is pseudo-first order: A = b − c·e^(−kobs·t), and kobs = k[OH⁻]. Each run is 2.5 mL of 30 µM ester stock and 0.5 mL of NaOH, so [OH⁻] in the cuvette is a sixth of the solution's. Hammett σ: H 0, 4-Me −0.17, 4-Cl 0.23, 3-CF3 0.43; plot log(k/kH) against σ, slope ρ. Slower esters get stronger base so each run changes within four minutes.",
  "context": {
    "intendedContexts": [
      "practical-session",
      "transferal"
    ],
    "audience": {
      "level": "undergraduate-2",
      "disciplines": [
        "chemistry",
        "biochemistry"
      ]
    },
    "concepts": [
      {
        "id": "pseudo-first-order",
        "label": "Pseudo-first-order kinetics"
      },
      {
        "id": "hammett",
        "label": "Linear free-energy relationships (Hammett)"
      },
      {
        "id": "tetrahedral",
        "label": "Hydroxide attack on an ester carbonyl"
      }
    ],
    "objectives": [
      {
        "id": "o-runs",
        "kind": "skill",
        "statement": "Make stocks and base series and record kinetic runs at 405 nm",
        "skills": [
          "core:make-up-to-volume",
          "core:spectrophotometer-read"
        ]
      },
      {
        "id": "o-hammett",
        "kind": "analysis",
        "statement": "Fit kobs, then k, then ρ; interpret its sign",
        "goal": "g-hammett"
      }
    ]
  },
  "materials": {
    "supplies": [
      {
        "id": "e-h",
        "label": "4-Nitrophenyl benzoate",
        "contains": [
          {
            "substance": "chem:4-nitrophenyl-benzoate",
            "purity": "99 %"
          }
        ],
        "amount": "500 mg",
        "container": "core:weighing-bottle"
      },
      {
        "id": "e-me",
        "label": "4-Nitrophenyl 4-methylbenzoate",
        "contains": [
          {
            "substance": "chem:4-nitrophenyl-4-methyl-benzoate",
            "purity": "99 %"
          }
        ],
        "amount": "500 mg",
        "container": "core:weighing-bottle"
      },
      {
        "id": "e-cl",
        "label": "4-Nitrophenyl 4-chlorobenzoate",
        "contains": [
          {
            "substance": "chem:4-nitrophenyl-4-chloro-benzoate",
            "purity": "99 %"
          }
        ],
        "amount": "500 mg",
        "container": "core:weighing-bottle"
      },
      {
        "id": "e-cf3",
        "label": "4-Nitrophenyl 3-(trifluoromethyl)benzoate",
        "contains": [
          {
            "substance": "chem:4-nitrophenyl-3-trifluoromethyl-benzoate",
            "purity": "99 %"
          }
        ],
        "amount": "500 mg",
        "container": "core:weighing-bottle"
      },
      {
        "id": "acetone",
        "label": "Acetone",
        "contains": [
          {
            "substance": "micro:acetone",
            "conc": "13.5 M"
          }
        ],
        "solvent": "core:water",
        "amount": "500 mL",
        "container": "core:reagent-bottle-1l"
      },
      {
        "id": "aq-acetone",
        "label": "50:50 acetone/water",
        "preparation": "chem:acetone-water-50",
        "amount": "250 mL",
        "container": "core:reagent-bottle-250ml"
      },
      {
        "id": "naoh",
        "label": "NaOH, 0.1 M",
        "contains": [
          {
            "substance": "core:sodium-hydroxide",
            "conc": "0.1 M"
          }
        ],
        "solvent": "core:water",
        "amount": "100 mL",
        "container": "core:reagent-bottle-250ml"
      },
      {
        "id": "water",
        "label": "Deionised water",
        "preparation": "core:water-deionised",
        "amount": "500 mL",
        "container": "core:reagent-bottle-1l"
      }
    ]
  },
