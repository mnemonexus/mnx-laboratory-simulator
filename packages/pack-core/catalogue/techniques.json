    "steps": [
      {
        "id": "set",
        "kind": "operation",
        "ref": "core:set-environment",
        "params": {
          "device": "=place",
          "temperature": "=temperature"
        },
        "when": "adjustable(place)"
      },
      {
        "id": "in",
        "kind": "operation",
        "ref": "core:place-in",
        "params": {
          "container": "=container",
