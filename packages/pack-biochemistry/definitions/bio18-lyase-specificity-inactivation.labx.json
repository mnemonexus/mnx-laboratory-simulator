            "params": {
              "source": "dtnb",
              "destination": "c-blank",
              "volume": "250 uL"
            }
          },
          {
            "id": "b-buf",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "buffer",
              "destination": "c-blank",
              "volume": "750 uL"
            }
          },
          {
            "id": "b-mix",
            "kind": "operation",
            "ref": "core:mix",
            "params": {
              "container": "c-blank",
              "method": "pipette-mix",
              "cycles": 5
            }
          }
        ]
      },
      {
        "id": "zero",
        "kind": "operation",
        "ref": "core:calibrate",
        "params": {
          "instrument": "spec",
          "mode": "blank",
          "reference": "c-blank",
          "wavelength": "412 nm"
        }
      },
      {
        "id": "series",
        "kind": "group",
        "title": "Initial rates across each analogue's concentration range (enzyme 0.125 µM, added last)",
        "steps": [
          {
            "id": "cuv",
            "kind": "operation",
            "ref": "core:fetch",
            "params": {
              "equipment": "core:cuvette-ps-1cm",
              "id": "='c-' + x[0]",
              "label": "=x[0]"
            }
          },
          {
            "id": "a-dtnb",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "dtnb",
              "destination": "='c-' + x[0]",
              "volume": "250 uL"
            }
          },
          {
            "id": "a-sub",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "=x[1]",
              "destination": "='c-' + x[0]",
              "volume": "=text(x[2]) + ' uL'"
            }
          },
          {
            "id": "a-buf",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "buffer",
              "destination": "='c-' + x[0]",
              "volume": "=text(x[3]) + ' uL'"
            }
          },
          {
            "id": "a-enz",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "patb",
              "destination": "='c-' + x[0]",
              "volume": "50 uL"
            }
          },
          {
            "id": "a-cover",
            "kind": "operation",
            "ref": "core:close",
            "params": {
              "container": "='c-' + x[0]",
              "cover": "parafilm"
            }
          },
          {
            "id": "a-mix",
            "kind": "operation",
            "ref": "core:mix",
            "params": {
              "container": "='c-' + x[0]",
              "method": "invert",
              "cycles": 5
            }
          },
          {
            "id": "a-open",
            "kind": "operation",
            "ref": "core:open",
            "params": {
              "container": "='c-' + x[0]"
            }
          },
          {
            "id": "trace",
            "kind": "operation",
            "ref": "core:measure",
            "params": {
              "instrument": "spec",
              "subject": "='c-' + x[0]",
              "wavelength": "412 nm",
              "mode": "kinetic",
              "interval": "5 s",
              "duration": "3 min"
            }
          },
