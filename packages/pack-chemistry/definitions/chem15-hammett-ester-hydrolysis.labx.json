  "procedure": {
    "fidelity": "prescribed-tolerant",
    "steps": [
      {
        "id": "bases",
        "kind": "group",
        "title": "NaOH solutions from the 0.1 M stock (20 mL each)",
        "steps": [
          {
            "id": "vf",
            "kind": "operation",
            "ref": "core:fetch",
            "params": {
              "equipment": "core:volumetric-flask-25ml",
              "id": "='naoh-' + text(x[0])",
              "label": "='NaOH, ' + text(x[1]) + ' M'"
            }
          },
          {
            "id": "stock-in",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "naoh",
              "destination": "='naoh-' + text(x[0])",
              "volume": "=text(x[1] * 250) + ' mL'"
            }
          },
          {
            "id": "makeup",
            "kind": "operation",
            "ref": "core:make-up-to-mark",
            "params": {
              "container": "='naoh-' + text(x[0])",
              "solvent": "water"
            }
          },
          {
            "id": "close",
            "kind": "operation",
            "ref": "core:close",
            "params": {
              "container": "='naoh-' + text(x[0])"
            }
          },
          {
            "id": "inv",
            "kind": "operation",
            "ref": "core:mix",
            "params": {
              "container": "='naoh-' + text(x[0])",
              "method": "invert",
              "cycles": 10
            }
          },
          {
            "id": "open",
            "kind": "operation",
            "ref": "core:open",
            "params": {
              "container": "='naoh-' + text(x[0])"
            }
          }
        ],
        "forEach": {
          "var": "x",
          "in": "=[[0, 0.002], [1, 0.004], [2, 0.005], [3, 0.008], [4, 0.01], [5, 0.012], [6, 0.015], [7, 0.02], [8, 0.03], [9, 0.04], [10, 0.045], [11, 0.06]]"
        },
        "objectives": [
          "o-runs"
        ]
      },
      {
        "id": "stock-h",
        "kind": "group",
        "title": "0.15 mmol in 100 mL of acetone, then 0.5 mL to 25 mL with 50:50 acetone/water (30 µM)",
