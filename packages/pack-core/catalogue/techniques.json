  {
    "id": "core:weigh-by-difference",
    "version": 1,
    "status": "experimental",
    "label": "Weigh by difference",
    "description": "Weigh the container of solid, tip a portion into the destination, weigh the container again: the mass delivered is the difference, whatever stays on the spatula or boat.",
    "purposes": [
      "measure-out.mass"
    ],
    "params": {
      "source": {
        "type": "container",
        "required": true,
        "description": "The weighing bottle holding the solid"
      },
      "destination": {
        "type": "container",
        "required": true
      },
      "mass": {
        "type": "quantity",
        "dimension": "mass",
        "required": true,
        "description": "About how much to take"
      }
    },
    "roles": {
      "balance": {
        "kind": "equipment",
        "requires": {
          "purpose": "measure.mass"
        },
        "prefer": [
          "core:balance-4dp"
        ]
      }
    },
    "steps": [
      {
        "id": "on-first",
        "kind": "operation",
        "ref": "core:place-in",
        "params": {
          "container": "=source",
          "place": "=balance"
        }
      },
      {
        "id": "first",
        "kind": "operation",
        "ref": "core:weigh",
        "params": {
          "balance": "=balance"
        }
      },
      {
        "id": "off-first",
        "kind": "operation",
        "ref": "core:remove-from",
        "params": {
          "container": "=source"
        }
      },
      {
        "id": "tip",
        "kind": "operation",
        "ref": "core:add-solid",
        "params": {
          "substance": "=source",
          "destination": "=destination",
          "mass": "=mass"
        }
      },
      {
        "id": "on-second",
        "kind": "operation",
        "ref": "core:place-in",
        "params": {
          "container": "=source",
          "place": "=balance"
        }
      },
      {
        "id": "second",
        "kind": "operation",
        "ref": "core:weigh",
        "params": {
          "balance": "=balance"
        }
      },
      {
        "id": "off-second",
        "kind": "operation",
        "ref": "core:remove-from",
        "params": {
          "container": "=source"
        }
      }
    ],
    "outputs": {
      "delivered": "=quantity(first.out.value) - quantity(second.out.value)"
    },
    "skills": [
      "core:weigh-by-difference",
      "core:tare-and-weigh"
    ]
