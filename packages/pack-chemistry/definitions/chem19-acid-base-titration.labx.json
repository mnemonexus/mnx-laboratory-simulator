    {
      "id": "chem19-mohr-chloride",
      "title": "Chloride by the Mohr titration",
      "summary": "Find the chloride concentration of a solution by titration with standard silver nitrate, using potassium chromate: the first permanent reddish tinge of silver chromate in the white silver chloride marks the end point.",
      "values": {
        "level": "ages-16-19",
