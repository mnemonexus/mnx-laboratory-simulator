              "id": "e-signs",
              "statement": "Ammonium nitrate and potassium chloride cool the water; calcium chloride warms it",
              "check": "first(recorded('dT-nh4no3')) < 0 && first(recorded('dT-kcl')) < 0 && first(recorded('dT-cacl2')) > 0",
              "source": "reference-standard"
            }
          ]
        },
        "objectives": [
          {
            "id": "o-measure",
