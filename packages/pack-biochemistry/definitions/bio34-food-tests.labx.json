      {
        "id": "water",
        "label": "Deionised water",
        "preparation": "core:water-deionised",
        "amount": "250 mL",
        "container": "core:reagent-bottle-1l"
      },
      {
        "id": "iodine",
        "label": "Iodine solution",
        "preparation": "bio:iodine-solution",
        "amount": "10 mL",
        "container": "core:dropper-bottle-10ml"
      },
      {
        "id": "benedict",
        "label": "Benedict’s reagent",
        "preparation": "bio:benedicts-reagent",
        "amount": "100 mL",
        "container": "core:reagent-bottle-250ml"
      },
      {
        "id": "hcl",
        "label": "Dilute hydrochloric acid, 1 M",
