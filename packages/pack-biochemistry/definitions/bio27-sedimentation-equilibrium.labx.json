              ]
            }
          },
          {
            "id": "a-s16k",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "A-s16k",
              "value": [
                0.0115,
                0.009,
                0.009,
                0.0126,
                0.015,
                0.0264,
                0.0309,
                0.0353,
                0.0513,
