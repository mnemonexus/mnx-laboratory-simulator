{
  "format": "lab-experiment",
  "formatVersion": "0.1",
  "id": "micro13-soil-spot-counts",
  "version": "1.0.0",
  "title": "Fuel in the soil: counting a degrader by spot plating",
  "language": "en-GB",
  "requires": {
    "framework": ">=0.1",
    "capabilities": [
      {
        "operation": "core:add-solid"
      },
      {
        "operation": "core:transfer"
      },
      {
        "operation": "core:measure"
      }
    ]
  },
  "summary": "Four sterile-soil microcosms seeded with an alkane-degrading pseudomonad (with or without an alkane fuel, kept cold or on the bench for a day): suspend half a gram of each, dilute to 10⁻⁶, spot three 10 µL drops of every dilution on one plate, and count the spots two days later to see where the degrader multiplied.",
  "briefing": "A spot plate puts a whole dilution series on one plate: small drops, each counted on its own. Half a gram of soil in 4.5 mL is a 10⁻¹ suspension (0.1 g of soil per mL), so the colonies in three 10 µL spots of the 10⁻ᵏ tube came from 0.03 mL × 10⁻ᵏ g of soil: cells per gram = colonies ÷ 0.03 × 10ᵏ. Count the most concentrated dilution whose spots still hold separate colonies. Use a fresh tip for each dilution, and put the microcosms back in the fridge once sampled so they do not change.",
  "context": {
    "intendedContexts": [
      "practical-session",
      "transferal"
    ],
    "audience": {
      "level": "undergraduate-1",
      "disciplines": [
        "bioscience",
        "ecology"
      ]
    },
    "concepts": [
      {
        "id": "spot-plating",
        "label": "Spot plating a dilution series"
      },
      {
        "id": "bioremediation",
        "label": "Bioremediation of hydrocarbons"
      },
      {
        "id": "growth-limits",
        "label": "Temperature and substrate as limits to growth"
      }
    ],
    "objectives": [
      {
        "id": "o-dilute",
        "kind": "skill",
        "statement": "Suspend a soil sample and make a tenfold dilution series",
        "skills": [
          "core:serial-dilution"
        ]
      },
      {
        "id": "o-spot",
        "kind": "skill",
        "statement": "Spot plate a series, choose the dilution to count and calculate cells per gram of soil",
        "skills": [
          "micro:colony-counting"
        ],
        "goal": "g-count"
      },
      {
        "id": "o-interpret",
        "kind": "reasoning",
        "statement": "Explain where the degrader grew in terms of its substrate and temperature",
        "goal": "g-interpret"
      }
    ]
  },
  "materials": {
    "samples": [
      {
        "id": "cold-clean",
        "label": "Cold, no fuel",
        "role": "specimen",
        "container": "core:conical-flask-250ml",
        "water": "5 mL",
        "contains": [
          {
            "substance": "core:soil",
            "mass": "25 g"
          },
          {
            "substance": "micro:pseudomonas-putida",
            "count": "5e5 {cells}"
          }
        ]
      },
      {
        "id": "cold-oil",
        "label": "Cold, with fuel",
        "role": "specimen",
        "container": "core:conical-flask-250ml",
        "water": "5 mL",
        "contains": [
          {
            "substance": "core:soil",
            "mass": "25 g"
          },
          {
            "substance": "micro:pseudomonas-putida",
            "count": "5e5 {cells}"
          },
          {
            "substance": "micro:hexadecane",
            "conc": "15.4 g/L"
          }
        ]
      },
      {
        "id": "warm-clean",
        "label": "Warm, no fuel",
        "role": "specimen",
        "container": "core:conical-flask-250ml",
        "water": "5 mL",
        "contains": [
          {
            "substance": "core:soil",
            "mass": "25 g"
          },
          {
            "substance": "micro:pseudomonas-putida",
            "count": "5e5 {cells}"
          }
        ]
      },
      {
        "id": "warm-oil",
        "label": "Warm, with fuel",
        "role": "specimen",
        "container": "core:conical-flask-250ml",
        "water": "5 mL",
        "contains": [
          {
            "substance": "core:soil",
            "mass": "25 g"
          },
          {
            "substance": "micro:pseudomonas-putida",
            "count": "5e5 {cells}"
          },
          {
            "substance": "micro:hexadecane",
            "conc": "15.4 g/L"
          }
        ]
      }
    ],
    "supplies": [
      {
        "id": "ringer",
        "label": "¼-strength Ringer",
        "preparation": "micro:ringer-quarter",
        "amount": "50 mL",
        "container": "core:reagent-bottle-50ml"
      },
      {
        "id": "cold-clean-1",
        "label": "cold-clean 10-1",
        "preparation": "micro:ringer-quarter",
        "amount": "4.5 mL",
        "container": "core:universal-bottle-28ml"
      },
      {
        "id": "cold-oil-1",
        "label": "cold-oil 10-1",
        "preparation": "micro:ringer-quarter",
        "amount": "4.5 mL",
        "container": "core:universal-bottle-28ml"
      },
      {
        "id": "warm-clean-1",
        "label": "warm-clean 10-1",
        "preparation": "micro:ringer-quarter",
        "amount": "4.5 mL",
        "container": "core:universal-bottle-28ml"
      },
      {
        "id": "warm-oil-1",
        "label": "warm-oil 10-1",
        "preparation": "micro:ringer-quarter",
        "amount": "4.5 mL",
        "container": "core:universal-bottle-28ml"
      },
      {
        "id": "plate-cold-clean",
        "label": "Spot plate: cold-clean",
        "preparation": "micro:nutrient-agar",
        "amount": "20 mL",
        "container": "core:petri-dish-90mm"
      },
      {
        "id": "plate-cold-oil",
        "label": "Spot plate: cold-oil",
        "preparation": "micro:nutrient-agar",
        "amount": "20 mL",
        "container": "core:petri-dish-90mm"
      },
      {
        "id": "plate-warm-clean",
        "label": "Spot plate: warm-clean",
        "preparation": "micro:nutrient-agar",
        "amount": "20 mL",
        "container": "core:petri-dish-90mm"
      },
      {
        "id": "plate-warm-oil",
        "label": "Spot plate: warm-oil",
        "preparation": "micro:nutrient-agar",
        "amount": "20 mL",
        "container": "core:petri-dish-90mm"
      }
    ]
  },
  "equipment": {
    "roles": [
      {
        "id": "fridge",
        "requires": {
          "class": "core:fridge"
        }
      },
      {
        "id": "counter",
        "requires": {
          "class": "core:colony-counter"
        }
      }
    ]
  },
  "procedure": {
    "fidelity": "prescribed-tolerant",
    "sessions": [
      {
        "id": "d1",
        "title": "Sample, dilute and spot"
      },
      {
        "id": "d2",
        "title": "Two days later: count and explain"
      }
    ],
    "steps": [
      {
        "id": "settle",
        "kind": "offstage",
        "session": "d1",
        "title": "The microcosms were set up a day ago: two in the fridge, two on the bench",
        "duration": "24 h",
        "params": {
          "place": "fridge",
          "containers": [
            "cold-clean",
            "cold-oil"
          ]
        }
      },
      {
        "id": "coat",
        "kind": "operation",
        "ref": "core:don",
        "params": {
          "item": "lab-coat"
        },
        "session": "d1"
      },
      {
        "id": "tubes",
        "kind": "group",
        "title": "Five tubes of 0.9 mL Ringer for each microcosm",
        "steps": [
          {
            "id": "t",
            "kind": "operation",
            "ref": "core:fetch",
            "params": {
              "equipment": "core:microtube-1.5ml",
              "id": "=x[0] + '-' + text(x[1])",
              "label": "=x[0] + ' 10-' + text(x[1])"
            }
          },
          {
            "id": "r",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "ringer",
              "destination": "=x[0] + '-' + text(x[1])",
              "volume": "0.9 mL"
            }
          }
        ],
        "forEach": {
          "var": "x",
          "in": "=[['cold-clean', 2], ['cold-clean', 3], ['cold-clean', 4], ['cold-clean', 5], ['cold-clean', 6], ['cold-oil', 2], ['cold-oil', 3], ['cold-oil', 4], ['cold-oil', 5], ['cold-oil', 6], ['warm-clean', 2], ['warm-clean', 3], ['warm-clean', 4], ['warm-clean', 5], ['warm-clean', 6], ['warm-oil', 2], ['warm-oil', 3], ['warm-oil', 4], ['warm-oil', 5], ['warm-oil', 6]]"
        },
        "session": "d1",
        "objectives": [
          "o-dilute"
        ]
      },
      {
        "id": "suspend",
        "kind": "group",
        "title": "Half a gram of each soil into 4.5 mL of Ringer (10⁻¹), shaken for a minute",
        "steps": [
          {
            "id": "soil",
            "kind": "operation",
            "ref": "core:add-solid",
            "params": {
              "substance": "=x",
              "destination": "=x + '-1'",
              "mass": "0.5 g"
            }
          },
          {
            "id": "cap",
            "kind": "operation",
            "ref": "core:close",
            "params": {
              "container": "=x + '-1'"
            }
          },
          {
            "id": "shake",
            "kind": "operation",
            "ref": "core:mix",
            "params": {
              "container": "=x + '-1'",
              "method": "shake",
              "cycles": 60
            }
          },
          {
            "id": "uncap",
            "kind": "operation",
            "ref": "core:open",
            "params": {
              "container": "=x + '-1'"
            }
          }
        ],
        "forEach": {
          "var": "x",
          "in": "=['cold-clean', 'cold-oil', 'warm-clean', 'warm-oil']"
        },
        "session": "d1",
        "objectives": [
          "o-dilute"
        ]
      },
      {
        "id": "back",
        "kind": "operation",
        "ref": "core:place-in",
        "params": {
          "container": "=x",
          "place": "fridge"
        },
        "forEach": {
          "var": "x",
          "in": "=['cold-clean', 'cold-oil', 'warm-clean', 'warm-oil']"
        },
        "session": "d1"
      },
      {
        "id": "series",
        "kind": "group",
        "title": "Tenfold steps to 10⁻⁶",
        "steps": [
          {
            "id": "carry",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "=x[0]",
              "destination": "=x[1]",
              "volume": "0.1 mL"
            }
          },
          {
            "id": "vortex",
            "kind": "operation",
            "ref": "core:mix",
            "params": {
              "container": "=x[1]",
              "method": "vortex",
              "cycles": 1
            }
          }
        ],
        "forEach": {
          "var": "x",
          "in": "=[['cold-clean-1', 'cold-clean-2'], ['cold-clean-2', 'cold-clean-3'], ['cold-clean-3', 'cold-clean-4'], ['cold-clean-4', 'cold-clean-5'], ['cold-clean-5', 'cold-clean-6'], ['cold-oil-1', 'cold-oil-2'], ['cold-oil-2', 'cold-oil-3'], ['cold-oil-3', 'cold-oil-4'], ['cold-oil-4', 'cold-oil-5'], ['cold-oil-5', 'cold-oil-6'], ['warm-clean-1', 'warm-clean-2'], ['warm-clean-2', 'warm-clean-3'], ['warm-clean-3', 'warm-clean-4'], ['warm-clean-4', 'warm-clean-5'], ['warm-clean-5', 'warm-clean-6'], ['warm-oil-1', 'warm-oil-2'], ['warm-oil-2', 'warm-oil-3'], ['warm-oil-3', 'warm-oil-4'], ['warm-oil-4', 'warm-oil-5'], ['warm-oil-5', 'warm-oil-6']]"
        },
        "session": "d1",
        "objectives": [
          "o-dilute"
        ]
      },
      {
        "id": "spot",
        "kind": "group",
        "title": "Three 10 µL spots of every dilution, 10⁻¹ to 10⁻⁶, one plate per microcosm",
        "steps": [
          {
            "id": "drop",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "=x[1]",
              "destination": "='plate-' + x[0]",
              "volume": "10 uL",
              "spot": "=x[2]"
            }
          }
        ],
        "forEach": {
          "var": "x",
          "in": "=[['cold-clean', 'cold-clean-1', 1], ['cold-clean', 'cold-clean-1', 2], ['cold-clean', 'cold-clean-1', 3], ['cold-clean', 'cold-clean-2', 4], ['cold-clean', 'cold-clean-2', 5], ['cold-clean', 'cold-clean-2', 6], ['cold-clean', 'cold-clean-3', 7], ['cold-clean', 'cold-clean-3', 8], ['cold-clean', 'cold-clean-3', 9], ['cold-clean', 'cold-clean-4', 10], ['cold-clean', 'cold-clean-4', 11], ['cold-clean', 'cold-clean-4', 12], ['cold-clean', 'cold-clean-5', 13], ['cold-clean', 'cold-clean-5', 14], ['cold-clean', 'cold-clean-5', 15], ['cold-clean', 'cold-clean-6', 16], ['cold-clean', 'cold-clean-6', 17], ['cold-clean', 'cold-clean-6', 18], ['cold-oil', 'cold-oil-1', 1], ['cold-oil', 'cold-oil-1', 2], ['cold-oil', 'cold-oil-1', 3], ['cold-oil', 'cold-oil-2', 4], ['cold-oil', 'cold-oil-2', 5], ['cold-oil', 'cold-oil-2', 6], ['cold-oil', 'cold-oil-3', 7], ['cold-oil', 'cold-oil-3', 8], ['cold-oil', 'cold-oil-3', 9], ['cold-oil', 'cold-oil-4', 10], ['cold-oil', 'cold-oil-4', 11], ['cold-oil', 'cold-oil-4', 12], ['cold-oil', 'cold-oil-5', 13], ['cold-oil', 'cold-oil-5', 14], ['cold-oil', 'cold-oil-5', 15], ['cold-oil', 'cold-oil-6', 16], ['cold-oil', 'cold-oil-6', 17], ['cold-oil', 'cold-oil-6', 18], ['warm-clean', 'warm-clean-1', 1], ['warm-clean', 'warm-clean-1', 2], ['warm-clean', 'warm-clean-1', 3], ['warm-clean', 'warm-clean-2', 4], ['warm-clean', 'warm-clean-2', 5], ['warm-clean', 'warm-clean-2', 6], ['warm-clean', 'warm-clean-3', 7], ['warm-clean', 'warm-clean-3', 8], ['warm-clean', 'warm-clean-3', 9], ['warm-clean', 'warm-clean-4', 10], ['warm-clean', 'warm-clean-4', 11], ['warm-clean', 'warm-clean-4', 12], ['warm-clean', 'warm-clean-5', 13], ['warm-clean', 'warm-clean-5', 14], ['warm-clean', 'warm-clean-5', 15], ['warm-clean', 'warm-clean-6', 16], ['warm-clean', 'warm-clean-6', 17], ['warm-clean', 'warm-clean-6', 18], ['warm-oil', 'warm-oil-1', 1], ['warm-oil', 'warm-oil-1', 2], ['warm-oil', 'warm-oil-1', 3], ['warm-oil', 'warm-oil-2', 4], ['warm-oil', 'warm-oil-2', 5], ['warm-oil', 'warm-oil-2', 6], ['warm-oil', 'warm-oil-3', 7], ['warm-oil', 'warm-oil-3', 8], ['warm-oil', 'warm-oil-3', 9], ['warm-oil', 'warm-oil-4', 10], ['warm-oil', 'warm-oil-4', 11], ['warm-oil', 'warm-oil-4', 12], ['warm-oil', 'warm-oil-5', 13], ['warm-oil', 'warm-oil-5', 14], ['warm-oil', 'warm-oil-5', 15], ['warm-oil', 'warm-oil-6', 16], ['warm-oil', 'warm-oil-6', 17], ['warm-oil', 'warm-oil-6', 18]]"
        },
        "session": "d1",
        "objectives": [
          "o-spot"
        ]
      },
      {
        "id": "soak",
        "kind": "operation",
        "ref": "core:advance-time",
        "params": {
          "duration": "10 min"
        },
        "session": "d1"
      },
      {
        "id": "invert",
        "kind": "checkpoint",
        "session": "d1",
        "title": "The spots have soaked in: invert the plates"
      },
      {
        "id": "off",
        "kind": "operation",
        "ref": "core:doff",
        "params": {
          "item": "lab-coat"
        },
        "session": "d1"
      },
      {
        "id": "grow",
        "kind": "offstage",
        "session": "d1",
        "title": "Two days on the bench",
        "duration": "40 h"
      },
      {
        "id": "coat-2",
        "kind": "operation",
        "ref": "core:don",
        "params": {
          "item": "lab-coat"
        },
        "session": "d2"
      },
      {
        "id": "count",
        "kind": "group",
        "title": "Count the spots and work back to cells per gram",
        "steps": [
          {
            "id": "c",
            "kind": "operation",
            "ref": "core:measure",
            "params": {
              "instrument": "counter",
              "subject": "='plate-' + x"
            }
          },
          {
            "id": "c-g",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "='per-g-' + x",
              "value": "=if((coalesce(c.out.bySector[0], 1e9) + coalesce(c.out.bySector[1], 1e9) + coalesce(c.out.bySector[2], 1e9)) < 1e9, (coalesce(c.out.bySector[0], 1e9) + coalesce(c.out.bySector[1], 1e9) + coalesce(c.out.bySector[2], 1e9)) * 10 / 0.03, if((coalesce(c.out.bySector[3], 1e9) + coalesce(c.out.bySector[4], 1e9) + coalesce(c.out.bySector[5], 1e9)) < 1e9, (coalesce(c.out.bySector[3], 1e9) + coalesce(c.out.bySector[4], 1e9) + coalesce(c.out.bySector[5], 1e9)) * 100 / 0.03, if((coalesce(c.out.bySector[6], 1e9) + coalesce(c.out.bySector[7], 1e9) + coalesce(c.out.bySector[8], 1e9)) < 1e9, (coalesce(c.out.bySector[6], 1e9) + coalesce(c.out.bySector[7], 1e9) + coalesce(c.out.bySector[8], 1e9)) * 1000 / 0.03, if((coalesce(c.out.bySector[9], 1e9) + coalesce(c.out.bySector[10], 1e9) + coalesce(c.out.bySector[11], 1e9)) < 1e9, (coalesce(c.out.bySector[9], 1e9) + coalesce(c.out.bySector[10], 1e9) + coalesce(c.out.bySector[11], 1e9)) * 10000 / 0.03, if((coalesce(c.out.bySector[12], 1e9) + coalesce(c.out.bySector[13], 1e9) + coalesce(c.out.bySector[14], 1e9)) < 1e9, (coalesce(c.out.bySector[12], 1e9) + coalesce(c.out.bySector[13], 1e9) + coalesce(c.out.bySector[14], 1e9)) * 100000 / 0.03, if((coalesce(c.out.bySector[15], 1e9) + coalesce(c.out.bySector[16], 1e9) + coalesce(c.out.bySector[17], 1e9)) < 1e9, (coalesce(c.out.bySector[15], 1e9) + coalesce(c.out.bySector[16], 1e9) + coalesce(c.out.bySector[17], 1e9)) * 1000000 / 0.03, null))))))"
            }
          }
        ],
        "forEach": {
          "var": "x",
          "in": "=['cold-clean', 'cold-oil', 'warm-clean', 'warm-oil']"
        },
        "session": "d2",
        "objectives": [
          "o-spot"
        ]
      },
      {
        "id": "which",
        "kind": "decision",
        "session": "d2",
        "objectives": [
          "o-spot"
        ],
        "prompt": "On a plate where several dilutions grew, which dilution's spots do you count?",
        "options": [
          {
            "id": "most",
            "label": "The most concentrated one whose spots are all separate colonies: the most colonies counted, so the smallest counting error"
          },
          {
            "id": "dilute",
            "label": "The most dilute one with any colonies, since it is the cleanest"
          },
          {
            "id": "mean",
            "label": "Every dilution, averaged"
          }
        ],
        "correctWhen": "'most'"
      },
      {
        "id": "grew",
        "kind": "decision",
        "session": "d2",
        "objectives": [
          "o-interpret"
        ],
        "prompt": "Each microcosm started with about 2 × 10⁴ of the degrader per gram. In which did it multiply?",
        "options": [
          {
            "id": "cold-clean",
            "label": "Cold, no fuel"
          },
          {
            "id": "cold-oil",
            "label": "Cold, with fuel"
          },
          {
            "id": "warm-clean",
            "label": "Warm, no fuel"
          },
          {
            "id": "warm-oil",
            "label": "Warm, with fuel: the alkane is its food"
          }
        ],
        "correctWhen": "if(coalesce(first(recorded('per-g-warm-oil')), 0) >= max(coalesce(first(recorded('per-g-warm-clean')), 0), coalesce(first(recorded('per-g-cold-oil')), 0), coalesce(first(recorded('per-g-cold-clean')), 0)), 'warm-oil', if(coalesce(first(recorded('per-g-warm-clean')), 0) >= max(coalesce(first(recorded('per-g-cold-oil')), 0), coalesce(first(recorded('per-g-cold-clean')), 0)), 'warm-clean', if(coalesce(first(recorded('per-g-cold-oil')), 0) >= coalesce(first(recorded('per-g-cold-clean')), 0), 'cold-oil', 'cold-clean')))"
      },
      {
        "id": "limit",
        "kind": "decision",
        "session": "d2",
        "objectives": [
          "o-interpret"
        ],
        "prompt": "The cold microcosm had the fuel too, yet its count hardly changed. What does that mean for cleaning up a spill in winter?",
        "options": [
          {
            "id": "cold",
            "label": "Temperature limits it: at 4 °C the degrader barely grows even with food, so clean-up is slow until the soil warms"
          },
          {
            "id": "toxic",
            "label": "The fuel is toxic in the cold"
          },
          {
            "id": "dead",
            "label": "The cold killed the degrader"
          }
        ],
        "correctWhen": "'cold'"
      },
      {
        "id": "discard",
        "kind": "operation",
        "ref": "core:dispose",
        "params": {
          "container": "='plate-' + x",
          "stream": "core:biohazard-waste"
        },
        "forEach": {
          "var": "x",
          "in": "=['cold-clean', 'cold-oil', 'warm-clean', 'warm-oil']"
        },
        "session": "d2"
      },
      {
        "id": "off-2",
        "kind": "operation",
        "ref": "core:doff",
        "params": {
          "item": "lab-coat"
        },
        "session": "d2"
      }
    ]
  },
  "goals": {
    "predicates": [
      {
        "id": "g-count",
        "statement": "The warm microcosms' counts are within a factor of two of the truth",
        "check": "all(s in ['warm-clean', 'warm-oil']: abs(log10(coalesce(first(recorded('per-g-' + s)), 1e-9) / (0.2 * cells(s, 'viable')))) < 0.3)"
      },
      {
        "id": "g-interpret",
        "statement": "The counting rule, where the degrader grew and why the cold held it back are all explained",
        "check": "decision('which') == 'most' && decision('grew') == 'warm-oil' && decision('limit') == 'cold'"
      }
    ],
    "expectedObservations": [
