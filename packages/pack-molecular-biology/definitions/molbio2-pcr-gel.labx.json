{
  "format": "lab-experiment",
  "formatVersion": "0.1",
  "id": "molbio2-pcr-gel",
  "version": "1.0.0",
  "title": "Amplifying the GFP gene by PCR and sizing it on a gel",
  "language": "en-GB",
  "requires": {
    "framework": ">=0.1",
    "capabilities": [{ "technique": "molbio:pcr" }, { "technique": "molbio:agarose-gel" }, { "technique": "molbio:size-band" }]
  },
  "summary": "Set up a PCR for the GFP gene of pGLO and a no-template control, run 30 cycles, run both beside a 1 kb ladder on a 1 % agarose gel, and estimate the product's size from the ladder.",
  "briefing": "The primers flank the GFP gene, so a successful PCR gives one product of a defined length. The no-template control tells you whether anything in your reagents was contaminated. Estimate the product's size from how far it ran compared with the ladder.",
  "context": {
    "intendedContexts": ["practical-session"],
    "audience": { "level": "undergraduate-1", "disciplines": ["molecular-biology"] },
    "concepts": [{ "id": "pcr", "label": "Exponential amplification between two primers" }, { "id": "gel", "label": "Separation of DNA by size" }],
    "objectives": [
      { "id": "o-setup", "kind": "skill", "statement": "Set up a PCR and its no-template control", "skills": ["molbio:pcr-setup", "core:micropipetting"] },
      { "id": "o-gel", "kind": "skill", "statement": "Load and run an agarose gel", "skills": ["molbio:gel-electrophoresis"] },
      { "id": "o-size", "kind": "analysis", "statement": "Size the product against the ladder", "skills": ["molbio:band-sizing"], "goal": "g-size" },
      { "id": "o-interpret", "kind": "reasoning", "statement": "Judge from the controls whether the PCR worked", "goal": "g-clean" }
    ]
  },
  "materials": {
    "samples": [
      { "id": "template", "label": "pGLO plasmid, 1 ng/µL", "role": "reagent", "container": "core:microtube-1.5ml", "amount": "50 uL",
        "contains": [{ "substance": "molbio:pglo-plasmid", "conc": "1 ng/uL" }] }
    ],
    "supplies": [
      { "id": "mastermix", "label": "PCR master mix (2×)", "preparation": "molbio:pcr-master-mix-2x", "amount": "500 uL", "container": "core:microtube-1.5ml", "storage": "0 Cel" },
      { "id": "primers", "label": "GFP primer mix (10 µM each)", "preparation": "molbio:gfp-primer-mix", "amount": "100 uL", "container": "core:microtube-1.5ml", "storage": "0 Cel" },
      { "id": "water", "label": "Nuclease-free water", "preparation": "core:water-deionised", "amount": "1 mL", "container": "core:microtube-1.5ml" },
      { "id": "dye", "label": "Loading dye (6×)", "preparation": "molbio:loading-dye-6x", "amount": "100 uL", "container": "core:microtube-1.5ml" },
      { "id": "ladder", "label": "1 kb ladder (ready to load)", "preparation": "molbio:ladder-1kb-ready", "amount": "50 uL", "container": "core:microtube-1.5ml" }
    ]
  },
  "equipment": {
    "roles": [{ "id": "gel", "requires": { "class": "core:agarose-gel-1pct" } }]
  },
  "procedure": {
    "fidelity": "prescribed-tolerant",
    "sessions": [{ "id": "d1", "title": "PCR and gel" }],
    "steps": [
      { "id": "setup", "kind": "group", "title": "Two 25 µL reactions", "objectives": ["o-setup"], "forEach": { "var": "t", "in": "=['pcr', 'ntc']" },
        "steps": [
          { "id": "tube", "kind": "operation", "ref": "core:fetch", "params": { "equipment": "core:pcr-tube-0.2ml", "id": "=t", "label": "=if(t == 'pcr', 'GFP PCR', 'No template')" } },
          { "id": "add-water", "kind": "operation", "ref": "core:transfer", "params": { "source": "water", "destination": "=t", "volume": "=if(t == 'pcr', 10.25 uL, 11.25 uL)" } },
          { "id": "add-mix", "kind": "operation", "ref": "core:transfer", "params": { "source": "mastermix", "destination": "=t", "volume": "12.5 uL" } },
          { "id": "add-primers", "kind": "operation", "ref": "core:transfer", "params": { "source": "primers", "destination": "=t", "volume": "1.25 uL" } },
          { "id": "add-template", "kind": "operation", "ref": "core:transfer", "when": "t == 'pcr'", "params": { "source": "template", "destination": "=t", "volume": "1 uL" } },
          { "id": "mix", "kind": "operation", "ref": "core:mix", "params": { "container": "=t", "method": "flick", "cycles": 3 } }
        ] },
      { "id": "amplify", "kind": "technique", "ref": "molbio:pcr", "params": { "tubes": ["pcr", "ntc"], "cycles": 30, "annealTemperature": "58 Cel", "extendTime": "60 s" } },
      { "id": "add-dye", "kind": "group", "forEach": { "var": "t", "in": "=['pcr', 'ntc']" },
        "steps": [
          { "id": "dye-in", "kind": "operation", "ref": "core:transfer", "params": { "source": "dye", "destination": "=t", "volume": "5 uL" } },
          { "id": "dye-mix", "kind": "operation", "ref": "core:mix", "params": { "container": "=t", "method": "flick", "cycles": 3 } }
        ] },
      { "id": "electrophoresis", "kind": "technique", "ref": "molbio:agarose-gel", "objectives": ["o-gel"],
        "params": { "gel": "gel", "ladder": "ladder", "ladderLane": "gel/A1", "loads": [["pcr", "gel/A2"], ["ntc", "gel/A3"]], "volume": "5 uL", "voltage": 100, "duration": "40 min" } },
      { "id": "size", "kind": "technique", "ref": "molbio:size-band", "objectives": ["o-size"],
        "params": { "ladderLane": "gel/A1", "lane": "gel/A2", "ladder": "molbio:ladder-1kb" } },
      { "id": "verdict", "kind": "decision", "objectives": ["o-interpret"], "prompt": "What does the gel tell you?",
        "options": [
          { "id": "worked", "label": "One product of the expected size, and a clean control" },
          { "id": "contaminated", "label": "The no-template control has a band: something was contaminated" },
          { "id": "failed", "label": "No product" }
        ],
        "correctWhen": "if(count(bandsIn('gel/A3')) > 0, 'contaminated', if(count(bandsIn('gel/A2')) > 0, 'worked', 'failed'))" }
    ]
  },
  "goals": {
    "predicates": [
      { "id": "g-size", "statement": "The estimated size is within 10 % of the product's 720 bp", "check": "between(first(first(recorded('band-size'))), 648, 792)" },
      { "id": "g-clean", "statement": "The no-template control shows no band", "check": "count(bandsIn('gel/A3')) == 0" }
    ],
    "expectedObservations": [
      { "id": "e-ladder", "statement": "All twelve ladder bands are on the gel and resolved", "check": "count(bandsIn('gel/A1')) == 12", "source": "reference-standard" },
      { "id": "e-one-band", "statement": "The PCR lane has one band", "check": "count(bandsIn('gel/A2')) == 1", "source": "reference-standard" },
      { "id": "e-yield", "statement": "The reaction made more than 10¹¹ copies", "check": "amplified('pcr', 'molbio:gfp-amplicon') > 1e11", "source": "simulation-derived" }
    ]
  },
  "variation": { "noise": "default" },
  "provenance": { "defaultClass": "reference-standard", "review": { "status": "draft" } }
}
