{
  "format": "lab-experiment",
  "formatVersion": "0.1",
  "id": "chem18-phenol-acylation-ir",
  "version": "1.0.0",
  "title": "Acylating a phenol under nitrogen: following the work-up by IR",
  "language": "en-GB",
  "requires": {
    "framework": ">=0.1",
    "capabilities": [
      {
        "operation": "core:purge"
      },
      {
        "operation": "core:drain"
      },
      {
        "operation": "core:concentrate"
      }
    ]
  },
  "summary": "Make 4-nitrophenyl 4-chlorobenzoate from 4-nitrophenol and an excess of 4-chlorobenzoyl chloride with triethylamine in dried THF under nitrogen, then work it up, taking an IR spectrum of the organic layer before the bicarbonate washes and another of the product.",
  "briefing": "Acid chlorides acylate phenols fast with a base to take up the HCl; water turns them into the carboxylic acid. Here the acid chloride is in excess (1.5 equivalents), so the quench leaves 4-chlorobenzoic acid. Dilute HCl takes triethylamine into the water; bicarbonate takes carboxylic acids. IR: aryl ester C=O near 1740 cm⁻¹; carboxylic acid C=O near 1690 with a very broad O–H across 2500-3300; nitro near 1525 and 1345. RMM of the ester 277.66.",
  "context": {
    "intendedContexts": [
      "practical-session",
      "transferal"
    ],
    "audience": {
      "level": "undergraduate-2",
      "disciplines": [
        "chemistry",
        "biochemistry"
      ]
    },
    "concepts": [
      {
        "id": "acylation",
        "label": "Acylation of phenols by acid chlorides"
      },
      {
        "id": "acid-base-extraction",
        "label": "Acid–base extraction"
      },
      {
        "id": "ir",
        "label": "Infrared spectroscopy of carbonyl compounds"
      }
    ],
    "objectives": [
      {
        "id": "o-synth",
        "kind": "skill",
        "statement": "Run a moisture-sensitive acylation under nitrogen with syringes",
        "skills": [
          "core:inert-atmosphere"
        ]
      },
      {
        "id": "o-workup",
        "kind": "skill",
        "statement": "Work up the reaction: quench, extract, wash, dry and concentrate",
        "skills": [
          "chem:liquid-liquid-extraction",
          "chem:rotary-evaporation"
        ]
      },
      {
        "id": "o-ir",
        "kind": "analysis",
        "statement": "Read from IR spectra what the bicarbonate wash removed and that the product is the ester",
        "goal": "g-ir"
      }
    ]
  },
  "materials": {
    "supplies": [
