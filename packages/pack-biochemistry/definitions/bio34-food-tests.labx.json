        ],
        "solvent": "core:water",
        "amount": "100 mL",
        "container": "core:reagent-bottle-250ml"
      },
      {
        "id": "bicarb",
        "label": "Sodium hydrogencarbonate, 1 M",
        "contains": [
          {
            "substance": "aq:sodium-hydrogencarbonate",
            "conc": "1 mol/L"
          }
        ],
        "solvent": "core:water",
        "amount": "100 mL",
        "container": "core:reagent-bottle-250ml"
      },
      {
        "id": "biuret",
        "label": "Biuret reagent",
        "preparation": "bio:biuret-reagent",
        "amount": "100 mL",
        "container": "core:reagent-bottle-250ml"
      },
      {
        "id": "sudan",
        "label": "Sudan III stain",
        "preparation": "bio:sudan-iii-stain",
        "amount": "10 mL",
        "container": "core:dropper-bottle-10ml"
      }
    ]
  },
