        "correctWhen": "if(!mentions(first(recorded('cfc')), 'sector 1: confluent') || first(recorded('oxidase-A')) != 'positive', 'not-pseudomonad', if(any(first(recorded('sizes-pcr-a')), between(it, 560, 680)) && mentions(first(recorded('flask-a')), 'cloudy'), 'yes', 'pseudomonad'))"
