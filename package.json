{
  "name": "mnemonexus-laboratory",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run science:build && npm run worker && npm run content",
    "build": "npm run science:build && npm run worker && npm run content && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p packages/tsconfig.tools.json",
    "worker": "node scripts/addon/worker.mjs",
    "addon:dev": "npm run science:build && npm run worker && npm run content && node scripts/addon/kit.mjs dev",
    "addon:check": "npm run science:build && npm run worker && npm run content && node scripts/addon/kit.mjs check",
    "addon:pack": "npm run science:build && npm run worker && npm run content && node scripts/lighting/bake.mjs --check && node scripts/addon/kit.mjs pack",
    "facility": "node scripts/facility/floorplan.mjs",
    "bake": "node scripts/lighting/bake.mjs",
    "light:calibrate": "node scripts/lighting/calibrate.mjs",
    "addon:verify-app": "node scripts/addon/verify-app.mjs",
    "addon:verify-seating": "node scripts/addon/verify-seating.mjs",
    "addon:verify-chair-movement": "node scripts/addon/verify-chair-movement.mjs",
    "look:shots": "node scripts/addon/look-shots.mjs",
    "addon:install-app": "node scripts/addon/install-app.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lab": "node apps/cli/lab.ts",
    "lab:generate": "node apps/cli/lab.ts schema",
    "lab:check": "node apps/cli/lab.ts check",
    "content": "node scripts/runtime/content.mjs && node scripts/runtime/practice.mjs && node scripts/runtime/notices.mjs",
    "science:build": "node scripts/runtime/wasm.mjs",
    "science:test": "cargo test --manifest-path packages/lab-science-rust/Cargo.toml",
    "bench": "node scripts/performance/baseline.mjs",
    "bench:science": "node scripts/performance/science.mjs",
    "bench:renderers": "node scripts/performance/renderers.mjs",
    "verify:host": "node scripts/performance/verify-host.mjs",
    "verify:mobile": "node scripts/performance/mobile.mjs",
    "data:aqueous": "node scripts/data/phreeqc-import.mjs"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@mnemonexus/addon-sdk": "file:../mnx-addon-kit-release/sdk",
    "@mnemonexus/addon-ui": "file:../mnx-addon-kit-release/ui",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "5.0.3"
  },
  "description": "Laboratory Simulator: a walkable 3D laboratory for the biosciences and chemistry, as a MnemoNexus add-on.",
  "license": "MIT"
}
