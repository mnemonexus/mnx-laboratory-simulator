        "id": "why-neutralise",
        "kind": "decision",
        "objectives": [
          "o-reason"
        ],
        "prompt": "Why is the acid neutralised before Benedict’s reagent is added?",
        "options": [
          {
            "id": "alkali",
            "label": "Benedict’s reagent only reacts in alkali: the sugar must open and react in alkaline solution"
          },
