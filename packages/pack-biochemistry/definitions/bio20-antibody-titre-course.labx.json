      },
      {
        "id": "stop-it",
        "kind": "technique",
        "ref": "core:dispense-reagent",
        "params": {
          "reagent": "stop",
          "volume": "50 uL",
          "into": "=['plate/A1', 'plate/A2', 'plate/A3', 'plate/A4', 'plate/A5', 'plate/A6', 'plate/A7', 'plate/A8', 'plate/A9', 'plate/A10', 'plate/A11', 'plate/A12', 'plate/B1', 'plate/B2', 'plate/B3', 'plate/B4', 'plate/B5', 'plate/B6', 'plate/B7', 'plate/B8', 'plate/B9', 'plate/B10', 'plate/B11', 'plate/B12', 'plate/C1', 'plate/C2', 'plate/C3', 'plate/C4', 'plate/C5', 'plate/C6', 'plate/C7', 'plate/C8', 'plate/C9', 'plate/C10', 'plate/C11', 'plate/C12', 'plate/D1', 'plate/D2', 'plate/D3', 'plate/D4', 'plate/D5', 'plate/D6', 'plate/D7', 'plate/D8', 'plate/D9', 'plate/D10', 'plate/D11', 'plate/D12', 'plate/E1', 'plate/E2', 'plate/E3', 'plate/E4', 'plate/E5', 'plate/E6', 'plate/E7', 'plate/E8', 'plate/E9', 'plate/E10', 'plate/E11', 'plate/E12', 'plate/F1', 'plate/F2', 'plate/F3', 'plate/F4', 'plate/F5', 'plate/F6', 'plate/F7', 'plate/F8', 'plate/F9', 'plate/F10', 'plate/F11', 'plate/F12', 'plate/G1', 'plate/G2', 'plate/G3', 'plate/G4', 'plate/G5', 'plate/G6', 'plate/G7', 'plate/G8', 'plate/G9', 'plate/G10', 'plate/G11', 'plate/G12', 'plate/H1', 'plate/H2', 'plate/H3', 'plate/H4', 'plate/H5', 'plate/H6', 'plate/H7', 'plate/H8', 'plate/H9', 'plate/H10', 'plate/H11', 'plate/H12']"
        }
      },
      {
        "id": "shake",
        "kind": "operation",
        "ref": "core:mix",
        "params": {
          "container": "plate",
          "method": "shake"
        }
      },
      {
        "id": "read",
        "kind": "operation",
        "ref": "core:measure",
        "params": {
          "instrument": "reader",
          "subject": "plate",
          "wavelength": "450 nm"
        },
        "objectives": [
          "o-titre"
        ]
      },
      {
        "id": "blank",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "blank",
          "value": "=(reading(read, 'plate/A1') + reading(read, 'plate/A12') + reading(read, 'plate/B1') + reading(read, 'plate/B12') + reading(read, 'plate/C1') + reading(read, 'plate/C12') + reading(read, 'plate/D1') + reading(read, 'plate/D12') + reading(read, 'plate/E1') + reading(read, 'plate/E12') + reading(read, 'plate/F1') + reading(read, 'plate/F12') + reading(read, 'plate/G1') + reading(read, 'plate/G12') + reading(read, 'plate/H1') + reading(read, 'plate/H12')) / 16"
        }
      },
      {
        "id": "curves",
        "kind": "group",
        "title": "Each serum's A450 down its pair of columns, less the blank (1:300 to 1:656 100)",
        "steps": [
          {
            "id": "curve",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "='A450-' + x[0]",
              "value": "=map(['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'], (reading(read, 'plate/' + it + text(x[1])) + reading(read, 'plate/' + it + text(x[1] + 1))) / 2 - first(recorded('blank')))"
            }
          }
        ],
        "forEach": {
          "var": "x",
          "in": "=[['d0', 2], ['prime', 4], ['boost1', 6], ['boost2', 8], ['unblocked', 10]]"
        },
        "objectives": [
          "o-titre"
        ]
      },
      {
        "id": "titres",
        "kind": "group",
        "title": "End-point titres: the last dilution above the pre-immune serum's highest reading plus 0.15",
        "steps": [
          {
            "id": "titre",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "='titre-' + x",
              "value": "=if(count(first(recorded('A450-' + x)), it > max(first(recorded('A450-d0'))) + 0.15) > 0, seq(300, 3, 8)[count(first(recorded('A450-' + x)), it > max(first(recorded('A450-d0'))) + 0.15) - 1], 0)"
            }
          }
        ],
        "forEach": {
          "var": "x",
          "in": "=['prime', 'boost1', 'boost2']"
        },
        "objectives": [
          "o-titre"
        ]
      },
      {
        "id": "course",
        "kind": "decision",
        "objectives": [
          "o-titre"
        ],
        "prompt": "How did the antigen-specific antibody change over the immunisation course?",
        "options": [
          {
            "id": "rose",
            "label": "It rose with each injection, most after the second boost: the response grows with re-exposure"
          },
          {
            "id": "peaked",
            "label": "It peaked after the prime and fell with the boosts"
          },
          {
            "id": "flat",
            "label": "It hardly changed"
          }
        ],
        "correctWhen": "if(first(recorded('titre-boost2')) > first(recorded('titre-boost1')) && first(recorded('titre-boost1')) > first(recorded('titre-prime')), 'rose', if(first(recorded('titre-prime')) > first(recorded('titre-boost2')), 'peaked', 'flat'))"
      },
      {
        "id": "unblocked-q",
        "kind": "decision",
        "objectives": [
          "o-controls"
        ],
        "prompt": "Columns 10 and 11 had the second-boost serum in wells that were never blocked, diluted in wash buffer with no BSA. What do they show?",
        "options": [
          {
            "id": "background",
            "label": "Extra signal that lingers as the serum is diluted out: its other goat IgG stuck to bare plastic, and the conjugate found it; blocking stops that"
          },
          {
            "id": "same",
            "label": "The same curve as the blocked wells: blocking makes no difference"
          },
          {
            "id": "lower",
            "label": "Less signal: blocking adds to the signal"
          }
        ],
        "correctWhen": "if(first(recorded('A450-unblocked'))[4] + first(recorded('A450-unblocked'))[5] > first(recorded('A450-boost2'))[4] + first(recorded('A450-boost2'))[5] + 0.08, 'background', if(first(recorded('A450-unblocked'))[0] < 0.8 * first(recorded('A450-boost2'))[0], 'lower', 'same'))"
      },
      {
        "id": "preimmune",
        "kind": "decision",
        "objectives": [
          "o-controls"
        ],
        "prompt": "Why is the goat's pre-immune serum on the plate?",
        "options": [
          {
            "id": "baseline",
            "label": "It shows what the same goat's serum gives before immunisation: the baseline the cutoff is set from"
          },
          {
            "id": "positive",
            "label": "It is the positive control"
          },
          {
            "id": "blank",
            "label": "It replaces the blank wells"
          }
        ],
        "correctWhen": "'baseline'"
      }
    ]
  },
  "goals": {
    "predicates": [
      {
        "id": "g-course",
        "statement": "The titres are read and rise with each boost",
        "check": "decision('course') == 'rose' && first(recorded('titre-boost2')) > 0"
      },
      {
        "id": "g-controls",
        "statement": "The unblocked wells and the pre-immune serum are explained",
        "check": "decision('unblocked-q') == 'background' && decision('preimmune') == 'baseline'"
      }
    ],
    "expectedObservations": [
      {
        "id": "e-preimmune",
        "statement": "The pre-immune serum gives only background in blocked wells",
        "check": "max(first(recorded('A450-d0'))) < 0.15",
        "source": "simulation-derived"
      },
      {
        "id": "e-boost",
        "statement": "Each boost raises the titre at least three-fold",
        "check": "first(recorded('titre-boost1')) >= 3 * first(recorded('titre-prime')) && first(recorded('titre-boost2')) >= 3 * first(recorded('titre-boost1'))",
        "source": "simulation-derived"
      }
    ]
  },
  "variation": {
    "noise": "default"
  },
  "provenance": {
    "defaultClass": "reference-standard",
    "review": {
      "status": "draft"
    }
  }
