            "id": "rate",
            "kind": "data",
            "ref": "core:transform",
            "params": {
              "op": "initial-rate",
              "input": "=trace.out.record",
              "window": "2 min"
            }
          },
          {
            "id": "note",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "='rate-' + x[0]",
              "value": "=rate.out.values['c-' + x[0]]"
            }
          },
          {
            "id": "bin",
            "kind": "operation",
            "ref": "core:dispose",
            "params": {
              "container": "='c-' + x[0]",
              "stream": "core:chemical-waste.organic-non-halogenated"
            }
          }
        ],
        "forEach": {
          "var": "x",
          "in": "=[['benzyl-0.1', 's-benzyl', 10, 690], ['benzyl-0.2', 's-benzyl', 20, 680], ['benzyl-0.4', 's-benzyl', 40, 660], ['benzyl-0.8', 's-benzyl', 80, 620], ['benzyl-1.6', 's-benzyl', 160, 540], ['benzyl-3.2', 's-benzyl', 320, 380], ['ethyl-0.25', 's-ethyl', 25, 675], ['ethyl-0.5', 's-ethyl', 50, 650], ['ethyl-1', 's-ethyl', 100, 600], ['ethyl-2', 's-ethyl', 200, 500], ['ethyl-4', 's-ethyl', 400, 300], ['ethyl-6', 's-ethyl', 600, 100]]"
        },
        "objectives": [
          "o-kinetics"
        ]
      },
      {
        "id": "fit-benzyl",
        "kind": "operation",
        "ref": "core:fit",
        "params": {
          "x": "=[0.1, 0.2, 0.4, 0.8, 1.6, 3.2]",
          "y": "=list(first(recorded('rate-benzyl-0.1')) / 14150 * 1e6 / 60, first(recorded('rate-benzyl-0.2')) / 14150 * 1e6 / 60, first(recorded('rate-benzyl-0.4')) / 14150 * 1e6 / 60, first(recorded('rate-benzyl-0.8')) / 14150 * 1e6 / 60, first(recorded('rate-benzyl-1.6')) / 14150 * 1e6 / 60, first(recorded('rate-benzyl-3.2')) / 14150 * 1e6 / 60)",
          "model": "michaelis-menten"
        },
        "objectives": [
          "o-kinetics"
        ]
      },
      {
        "id": "km-benzyl",
        "kind": "operation",
        "ref": "core:record",
        "params": {
