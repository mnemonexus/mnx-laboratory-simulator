{
  "format": "lab-experiment",
  "formatVersion": "0.1",
  "id": "bio20-antibody-titre-course",
  "version": "1.0.0",
  "title": "An immunisation course by ELISA: end-point titres, and what blocking is for",
  "language": "en-GB",
  "requires": {
    "framework": ">=0.1",
    "capabilities": [
      {
        "operation": "core:wash"
      },
      {
        "operation": "core:measure"
      }
    ]
  },
  "summary": "Coat a plate with a recombinant antigen, block all but two columns, titrate a goat's pre-immune serum and its sera after a prime and two boosts three-fold down the plate, detect bound goat IgG with a peroxidase anti-goat conjugate and TMB, and compare end-point titres; the unblocked columns show why blocking matters.",
  "briefing": "Sera are pre-diluted 1:100; 50 µL into 100 µL of assay buffer makes 1:300 in row A, and each step down is a further three-fold. The conjugate recognises any goat IgG on the well, wherever it came from. Columns 10 and 11 are left unblocked and get wash buffer (no BSA) as their diluent. Take each titre as the last dilution whose A450 is still more than 0.15 above the pre-immune serum's highest reading.",
  "context": {
    "intendedContexts": [
      "practical-session",
      "transferal"
    ],
    "audience": {
      "level": "undergraduate-2",
      "disciplines": [
        "immunology",
        "biochemistry"
      ]
    },
    "concepts": [
      {
        "id": "titre",
        "label": "End-point antibody titres"
      },
      {
        "id": "boosting",
        "label": "Primary and secondary antibody responses"
      },
      {
        "id": "blocking",
        "label": "Blocking and non-specific binding"
      }
    ],
    "objectives": [
      {
        "id": "o-elisa",
        "kind": "skill",
        "statement": "Coat, block and titrate sera down an ELISA plate",
        "skills": [
          "core:micropipetting",
          "core:dilution-series"
        ]
      },
      {
        "id": "o-titre",
        "kind": "analysis",
        "statement": "Read end-point titres against a pre-immune cutoff and compare them",
        "goal": "g-course"
      },
      {
        "id": "o-controls",
        "kind": "reasoning",
        "statement": "Explain the pre-immune serum and the unblocked wells",
        "goal": "g-controls"
      }
    ]
  },
  "materials": {
    "samples": [
      {
        "id": "d0",
        "label": "Goat 7, pre-immune serum (1:100)",
        "role": "specimen",
        "preparation": "bio:assay-buffer-bsa",
        "contains": [
          {
            "substance": "bio:goat-igg",
            "conc": "0.1 mg/mL"
          }
        ],
        "amount": "300 uL",
        "container": "core:microtube-1.5ml",
        "storage": "4 Cel"
      },
      {
        "id": "prime",
        "label": "Goat 7, two weeks after the prime (1:100)",
        "role": "specimen",
        "preparation": "bio:assay-buffer-bsa",
        "contains": [
          {
            "substance": "bio:goat-igg",
            "conc": "0.1 mg/mL"
          },
          {
            "substance": "bio:goat-anti-antigen-igg",
            "conc": "0.15 ug/mL"
          }
        ],
        "amount": "300 uL",
        "container": "core:microtube-1.5ml",
        "storage": "4 Cel"
      },
      {
        "id": "boost1",
        "label": "Goat 7, after the first boost (1:100)",
        "role": "specimen",
        "preparation": "bio:assay-buffer-bsa",
        "contains": [
          {
            "substance": "bio:goat-igg",
            "conc": "0.1 mg/mL"
          },
          {
            "substance": "bio:goat-anti-antigen-igg",
            "conc": "0.6 ug/mL"
          }
        ],
        "amount": "300 uL",
        "container": "core:microtube-1.5ml",
        "storage": "4 Cel"
      },
      {
        "id": "boost2",
        "label": "Goat 7, after the second boost (1:100)",
        "role": "specimen",
        "preparation": "bio:assay-buffer-bsa",
        "contains": [
          {
            "substance": "bio:goat-igg",
            "conc": "0.1 mg/mL"
          },
          {
            "substance": "bio:goat-anti-antigen-igg",
            "conc": "2.5 ug/mL"
          }
        ],
        "amount": "300 uL",
        "container": "core:microtube-1.5ml",
        "storage": "4 Cel"
      }
    ],
    "supplies": [
      {
        "id": "antigen",
        "label": "Recombinant antigen, 2 µg/mL in coating buffer",
        "preparation": "bio:carbonate-coating-ph9.6",
        "contains": [
          {
            "substance": "bio:recombinant-antigen",
            "conc": "2 mg/L"
          }
        ],
        "amount": "12 mL",
        "container": "core:conical-tube-15ml",
        "storage": "4 Cel"
      },
      {
        "id": "wash",
        "label": "Wash buffer (PBS, 0.05 % Tween 20)",
        "preparation": "bio:pbs-tween",
        "amount": "1 L",
        "container": "core:reagent-bottle-1l"
      },
      {
        "id": "blocker",
        "label": "Blocking buffer (5 % milk in wash buffer)",
        "preparation": "bio:pbs-tween",
        "contains": [
          {
            "substance": "bio:skimmed-milk-powder",
            "conc": "50 g/L"
          }
        ],
        "amount": "20 mL",
        "container": "core:conical-tube-50ml"
      },
      {
        "id": "assay",
        "label": "Assay buffer (PBS-Tween, 1 % BSA)",
        "preparation": "bio:assay-buffer-bsa",
        "amount": "15 mL",
        "container": "core:conical-tube-50ml"
      },
      {
        "id": "secondary",
        "label": "Donkey anti-goat IgG–HRP",
        "preparation": "bio:secondary-anti-goat-hrp",
        "amount": "12 mL",
        "container": "core:conical-tube-15ml",
        "storage": "4 Cel"
      },
      {
        "id": "tmb",
        "label": "TMB substrate",
        "preparation": "bio:tmb-substrate",
        "amount": "12 mL",
        "container": "core:conical-tube-15ml"
      },
      {
        "id": "stop",
        "label": "Stop solution (1 M HCl)",
        "preparation": "bio:stop-hcl-1m",
        "amount": "6 mL",
        "container": "core:conical-tube-15ml"
      },
      {
        "id": "waste",
        "label": "Waste pot",
        "preparation": "core:water-deionised",
        "amount": "1 mL",
        "container": "core:beaker-250ml"
      }
    ]
  },
  "equipment": {
    "roles": [
      {
        "id": "plate",
        "requires": {
          "class": "core:microplate-96-elisa"
        }
      },
      {
        "id": "incubator",
        "requires": {
          "class": "core:incubator",
          "temperature": "37 Cel"
        }
      },
      {
        "id": "reader",
        "requires": {
          "purpose": "measure.absorbance",
          "wavelength": "450 nm",
          "format": "96-well"
        }
      }
    ]
  },
