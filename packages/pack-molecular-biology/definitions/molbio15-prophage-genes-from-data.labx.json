{
  "format": "lab-experiment",
  "formatVersion": "0.1",
  "id": "molbio15-prophage-genes-from-data",
  "version": "1.0.0",
  "title": "A prophage gene from data: homology search and RNA-seq",
  "language": "en-GB",
  "requires": {
    "framework": ">=0.1",
    "capabilities": [
      {
        "operation": "core:test"
      }
    ]
  },
  "summary": "Decide from a BLASTp hit table and a prophage search whether a bacterium carries a Mu-like prophage with a Gam homologue, then from RNA-seq counts (rich against starvation medium, triplicates) whether that gene is transcribed and whether it belongs to the competence response.",
  "briefing": "BLAST: a homologue needs a small E-value (below 10⁻⁵), more than about 25 % identity, and coverage of most of the query. RNA-seq: normalise to counts per million (library sizes differ), compare log2 fold changes, test with Welch's t-test on log values.",
  "context": {
    "intendedContexts": [
      "practical-session",
      "transferal"
    ],
    "audience": {
      "level": "undergraduate-2",
      "disciplines": [
        "molecular-biology",
        "bioinformatics"
      ]
    },
    "objectives": [
      {
        "id": "o-data",
        "kind": "analysis",
        "statement": "Analyse sequence-search and RNA-seq data",
        "goal": "g-data"
      }
    ]
  },
  "procedure": {
    "fidelity": "prescribed",
    "steps": [
      {
        "id": "query",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "query",
          "value": "phage Mu Gam"
        }
      },
      {
        "id": "hits",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "BLASTp-hits",
          "value": [
            {
              "subject": "Prophage protein PP_3112",
              "identity": 34.6,
              "coverage": 91,
              "evalue": 5e-18
            },
            {
              "subject": "Recombinase RecT",
              "identity": 21.3,
              "coverage": 40,
              "evalue": 0.3
            },
            {
              "subject": "Hypothetical PP_0418",
              "identity": 26.1,
              "coverage": 22,
              "evalue": 2.4
            },
            {
              "subject": "Ku-like protein",
              "identity": 18.9,
              "coverage": 55,
              "evalue": 0.05
            }
          ]
        }
      },
      {
        "id": "region",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "PHASTEST-region",
          "value": {
            "verdict": "intact",
            "kb": 36.1,
            "genes": [
              "muA-like",
              "muB-like",
              "gam-like",
              "tail",
              "portal"
            ]
          }
        }
      },
      {
        "id": "homologues",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "homologues",
          "value": "=map(filter(h in first(recorded('BLASTp-hits')): h.evalue < 1e-5 && h.identity > 25 && h.coverage > 70), it.subject)"
        }
      },
      {
        "id": "homologue",
        "kind": "decision",
        "prompt": "Does the genome encode a homologue of phage Mu Gam?",
        "options": [
          {
            "id": "one",
            "label": "Yes, one: a single hit with E below 10⁻⁵, more than 25 % identity over most of the query's length; the rest are chance matches"
          },
          {
            "id": "none",
            "label": "No homologue"
          },
          {
            "id": "many",
            "label": "Several homologues"
          }
        ],
        "correctWhen": "if(len(first(recorded('homologues'))) == 1, 'one', if(len(first(recorded('homologues'))) == 0, 'none', 'many'))"
      },
      {
        "id": "prophage-region",
        "kind": "decision",
        "prompt": "What does the prophage search say?",
        "options": [
          {
            "id": "intact",
            "label": "An intact Mu-like prophage region, its genes in the order of the phage's own map, the Gam homologue among them"
          },
          {
            "id": "remnant",
            "label": "Only a degraded remnant"
          }
        ],
        "correctWhen": "if(first(recorded('PHASTEST-region')).verdict == 'intact' && first(recorded('PHASTEST-region')).kb > 30, 'intact', 'remnant')"
      },
      {
        "id": "evalue",
        "kind": "decision",
        "prompt": "What does a BLAST E-value mean?",
        "options": [
          {
            "id": "chance",
            "label": "How many hits this good you would expect by chance in a database this size: the smaller, the less likely a chance match"
          },
          {
            "id": "identity",
            "label": "The percentage identity"
          }
        ],
        "correctWhen": "'chance'"
      },
      {
        "id": "libraries",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "samples",
          "value": [
            "t0-1",
            "t0-2",
            "t0-3",
            "t30-1",
            "t30-2",
            "t30-3"
          ]
        }
      },
      {
        "id": "matrix",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "counts",
          "value": {
            "comA": [
              99,
              115,
              110,
              4010,
              5320,
              5499
            ],
            "comE": [
              133,
              137,
              153,
              4957,
              6931,
              5424
            ],
            "pilA": [
              45,
              47,
              70,
              6181,
              6018,
              6610
            ],
            "rec2": [
              65,
              74,
              98,
              2271,
              1797,
              2632
            ],
            "dprA": [
              114,
              146,
              156,
              4178,
              3913,
              4696
            ],
            "sxy": [
              245,
              189,
              266,
              1491,
              1768,
              2097
            ],
            "gyrB": [
              1734,
              1988,
              2444,
              1714,
              2150,
              1928
            ],
            "rpoB": [
              5751,
              4790,
              6998,
              4748,
              5465,
              4827
            ],
            "infA": [
              7714,
              7368,
              10921,
              6734,
              6584,
              6225
            ],
            "muA-like": [
              205,
              215,
              310,
              181,
              209,
              221
            ],
            "muB-like": [
              181,
              195,
              247,
              181,
              177,
              203
            ],
            "gam-like": [
              134,
              161,
              193,
              128,
              129,
              135
            ],
            "(all other genes)": [
              6245478,
              6783437,
              8599087,
              6291476,
              6498745,
              6896427
            ]
          }
        }
      },
      {
        "id": "sizes",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "library-size",
          "value": "=map(j in range(0, 5, 6): sum(g in ['comA', 'comE', 'pilA', 'rec2', 'dprA', 'sxy', 'gyrB', 'rpoB', 'infA', 'muA-like', 'muB-like', 'gam-like', '(all other genes)']: first(recorded('counts'))[g][j]))"
        }
      },
      {
        "id": "gene-coma",
        "kind": "group",
        "title": "comA: counts per million, log2 fold change (t30/t0) and a Welch t-test on log2 CPM",
        "steps": [
          {
            "id": "cpm-coma",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "CPM-comA",
              "value": "=map(j in range(0, 5, 6): first(recorded('counts'))['comA'][j] / first(recorded('library-size'))[j] * 1e6)"
            }
          },
          {
            "id": "lfc-coma",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "log2FC-comA",
              "value": "=ln(mean([first(recorded('CPM-comA'))[3], first(recorded('CPM-comA'))[4], first(recorded('CPM-comA'))[5]]) / mean([first(recorded('CPM-comA'))[0], first(recorded('CPM-comA'))[1], first(recorded('CPM-comA'))[2]])) / ln(2)"
            }
          },
          {
            "id": "t-coma",
            "kind": "operation",
            "ref": "core:test",
            "params": {
              "test": "welch-t",
              "groups": "=[map(j in [0, 1, 2]: ln(first(recorded('CPM-comA'))[j] + 1)), map(j in [3, 4, 5]: ln(first(recorded('CPM-comA'))[j] + 1))]"
            }
          },
          {
            "id": "p-coma",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "p-comA",
              "value": "=t-coma.out.p"
            }
          }
        ]
      },
      {
        "id": "gene-come",
        "kind": "group",
