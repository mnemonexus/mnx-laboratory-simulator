    "concepts": [
      {
        "id": "functional-groups",
        "label": "A functional group reacts the same way whatever molecule it is in"
      }
    ],
    "objectives": [
      {
        "id": "o-test",
        "kind": "skill",
        "statement": "Carry out the test safely, warming in a water bath where needed"
      },
      {
        "id": "o-identify",
        "kind": "outcome",
        "statement": "Tell the compounds apart by their functional groups",
        "goal": "g-identify"
      }
    ],
    "curricula": [
      "A level",
      "IB",
      "AP",
      "T Level"
    ]
  },
  "parameters": {
    "title": {
      "default": "Testing for a C=C double bond with bromine water"
    },
    "summary": {
      "default": "Shake cyclohexene and cyclohexane with bromine water: the alkene decolourises it, the alkane does not."
    },
    "briefing": {
      "default": "Bromine water is orange. Bromine adds across the C=C double bond of an alkene, giving a colourless dibromo compound, so the colour goes at once. An alkane has no double bond and does not react in the dark: the bromine moves into the hydrocarbon layer, which turns orange. Put 1 mL of each hydrocarbon in a tube, add 2 mL of bromine water and shake (fume cupboard)."
    },
    "tubes": {
      "default": "=[['ene','Cyclohexene and bromine water','cyclohexene',[['bromine',2,'bromine']],0,0],['ane','Cyclohexane and bromine water','cyclohexane',[['bromine',2,'bromine']],0,0]]"
    },
    "questions": {
      "default": [
        {
          "id": "identify",
          "kind": "decision",
          "objectives": [
            "o-identify"
          ],
          "prompt": "Which compound is unsaturated?",
          "options": [
            {
              "id": "ene",
              "label": "Cyclohexene"
            },
            {
              "id": "ane",
              "label": "Cyclohexane"
            }
          ],
          "correctWhen": "'ene'"
        }
      ]
    },
    "goals": {
      "default": [
        {
          "id": "g-identify",
          "statement": "The unsaturated compound is identified",
          "check": "decision('identify') == 'ene'"
        }
      ]
    },
    "observations": {
      "default": [
        {
          "id": "e-bromine",
          "statement": "Cyclohexene decolourises bromine water; with cyclohexane an orange layer stays",
          "check": "!mentions(first(recorded('seen-ene')), 'orange') && mentions(first(recorded('seen-ane')), 'orange')",
          "source": "reference-standard"
        }
      ]
    }
  },
