  {
    "id": "micro:incubate-plates",
    "version": 1,
    "status": "experimental",
    "label": "Incubate plates",
    "description": "Put the plates in the incubator upside down and leave them, typically overnight at 37 °C.",
    "purposes": [
      "transform.grow-culture",
      "condition.incubate"
    ],
    "params": {
      "plates": {
        "type": "list",
        "items": {
          "type": "container"
        },
        "required": true
      },
      "temperature": {
        "type": "quantity",
        "dimension": "temperature",
        "default": "37 Cel"
      },
      "duration": {
        "type": "quantity",
        "dimension": "time",
        "default": "20 h"
      }
    },
    "roles": {
      "incubator": {
        "kind": "place",
        "requires": {
          "purpose": "condition.incubate",
          "temperature": "=temperature"
        },
        "prefer": [
          "core:incubator"
        ]
      }
    },
    "steps": [
      {
        "id": "set",
        "kind": "operation",
        "ref": "core:set-environment",
        "when": "adjustable(incubator)",
        "params": {
          "device": "=incubator",
          "temperature": "=temperature"
        }
      },
      {
        "id": "in",
        "kind": "operation",
        "ref": "core:place-in",
        "forEach": {
          "var": "p",
          "in": "=plates"
        },
        "params": {
          "container": "=p",
          "place": "=incubator"
        }
      },
      {
        "id": "wait",
        "kind": "operation",
        "ref": "core:advance-time",
        "params": {
          "duration": "=duration"
        }
      },
      {
        "id": "out",
        "kind": "operation",
        "ref": "core:remove-from",
        "forEach": {
          "var": "p",
          "in": "=plates"
        },
        "params": {
          "container": "=p"
        }
      }
    ],
    "skills": [
      "core:incubate"
    ]
  },
  {
