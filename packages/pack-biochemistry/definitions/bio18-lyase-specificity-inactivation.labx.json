      },
      {
        "id": "kcat-benzyl",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "kcat-benzyl",
          "value": "=fit-benzyl.out.fit.params.vmax / 0.125"
        }
      },
      {
        "id": "spec-benzyl",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "specificity-benzyl",
          "value": "=fit-benzyl.out.fit.params.vmax / 0.125 / fit-benzyl.out.fit.params.km"
        }
      },
      {
        "id": "fit-ethyl",
        "kind": "operation",
