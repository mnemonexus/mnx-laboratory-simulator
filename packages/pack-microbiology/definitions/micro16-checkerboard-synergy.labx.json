{
  "format": "lab-experiment",
  "formatVersion": "0.1",
  "id": "micro16-checkerboard-synergy",
  "version": "1.0.0",
  "title": "Better together? Checkerboards for two antibiotic pairs",
  "language": "en-GB",
  "requires": {
    "framework": ">=0.1",
    "capabilities": [
      {
        "operation": "core:transfer"
      },
      {
        "operation": "core:measure"
      }
    ]
  },
  "summary": "Two broth checkerboards against E. coli: trimethoprim across sulfamethoxazole, and gentamicin across streptomycin. Read the turbidity after a night at 37 °C, find each drug's MIC alone and the fractional inhibitory concentration index (FICI) of each pair, and decide which pair is synergistic.",
  "briefing": "In a checkerboard one drug is halved along the columns and the other down the rows, so every well holds a different pair of concentrations; the first column and the first row hold one drug alone. For each clear well, FIC = a / MIC(a) + b / MIC(b); the FICI is the lowest. 0.5 or less is synergy, above 4 antagonism, and anything between is no interaction (two drugs acting like more of one give 1). Each well gets 50 µL of each drug at four times its final strength and 100 µL of cells; A11 is the growth control and A12 broth alone.",
  "context": {
    "intendedContexts": [
      "practical-session",
      "transferal"
    ],
    "audience": {
      "level": "undergraduate-1",
      "disciplines": [
        "biomedical-science",
        "microbiology",
        "pharmacology"
      ]
    },
    "concepts": [
      {
        "id": "fici",
        "label": "The fractional inhibitory concentration index"
      },
      {
        "id": "synergy",
        "label": "Synergy, additivity and antagonism"
      },
      {
        "id": "sequential-blockade",
        "label": "Sequential blockade of a pathway"
      }
    ],
    "objectives": [
      {
        "id": "o-board",
        "kind": "skill",
        "statement": "Set up a two-drug checkerboard from four-times-strength series",
        "skills": [
          "core:serial-dilution",
          "core:micropipetting"
        ]
      },
      {
        "id": "o-read",
        "kind": "skill",
        "statement": "Read each drug's MIC and compute the FICI",
        "skills": [
          "micro:mic-determination"
        ],
        "goal": "g-read"
      },
      {
        "id": "o-interpret",
        "kind": "reasoning",
        "statement": "Classify each pair's interaction and explain it from their targets",
        "goal": "g-interpret"
      }
    ]
  },
