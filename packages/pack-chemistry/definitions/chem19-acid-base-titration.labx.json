        "analyteConc": "0.080..0.120 mol/L",
        "ratioNote": "Ethanoic acid and sodium hydroxide react 1 : 1.",
        "indicatorReason": "basic-end"
      },
      "keywords": [
        "weak acid",
        "ethanoic acid",
        "acetic acid"
      ],
      "curricula": [
        "A level",
        "IB",
        "AP"
      ]
    },
    {
      "id": "chem19-weak-base-titration",
