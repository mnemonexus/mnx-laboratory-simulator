{
  "format": "lab-experiment",
  "formatVersion": "0.1",
  "id": "molbio14-replication-origins-data",
  "version": "1.0.0",
  "title": "Where does replication start? Origins, forks and the cell cycle from data",
  "language": "en-GB",
  "requires": {
    "framework": ">=0.1",
    "capabilities": [
      {
        "operation": "core:record"
      }
    ]
  },
  "summary": "Work out two microbes' genome structure, origins, fork speed, inter-origin distance and S phase from pulsed-field gels, ARS assays, replication profiles, DNA combing and flow cytometry, and decide which Earth organisms each resembles.",
  "briefing": "DNA fibres are stretched 2 kb per µm; the second (red) pulse lasted as recorded. Fork velocity = red track length / pulse time; inter-origin distance = spacing of neighbouring origins' centres.",
  "context": {
    "intendedContexts": [
      "practical-session",
      "transferal"
    ],
    "audience": {
      "level": "undergraduate-2",
      "disciplines": [
        "molecular-biology"
      ]
    },
    "objectives": [
      {
        "id": "o-rep",
        "kind": "reasoning",
        "statement": "Interpret replication-origin and cell-cycle data",
        "goal": "g-rep"
      }
    ]
  },
  "procedure": {
    "fidelity": "prescribed",
    "steps": [
      {
        "id": "pfge",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "PFGE-bands-Mb",
          "value": {
            "Halo": [],
            "Fung": [
              2.6,
              1.8,
              1.1
            ]
          }
        }
      },
      {
        "id": "genomes",
        "kind": "decision",
        "prompt": "From the pulsed-field gel, what are the two genomes? (A circular chromosome cannot enter the gel; linear ones run as bands by size.)",
        "options": [
          {
            "id": "circular-linear",
            "label": "Halo: one circular chromosome (nothing enters the gel); Fung: several linear chromosomes (separate bands)"
          },
          {
            "id": "linear-circular",
            "label": "Halo: linear; Fung: circular"
          }
        ],
        "correctWhen": "if(len(first(recorded('PFGE-bands-Mb'))['Halo']) == 0 && len(first(recorded('PFGE-bands-Mb'))['Fung']) > 1, 'circular-linear', 'linear-circular')"
      },
      {
        "id": "ars-len-halo",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "ARS-length-kb-Halo",
          "value": [
            0.7,
            3.6,
            0.9,
            3.1,
            0.4,
            2.7
          ]
        }
      },
      {
        "id": "ars-act-halo",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "ARS-active-Halo",
          "value": [
            0,
            1,
            0,
            1,
            0,
            1
          ]
        }
      },
      {
        "id": "ars-len-fung",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "ARS-length-kb-Fung",
          "value": [
            0.5,
            2.8,
            0.4,
            3.3,
            1.9,
            2.0
          ]
        }
      },
      {
        "id": "ars-act-fung",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "ARS-active-Fung",
          "value": [
            1,
            1,
            0,
            1,
            0,
            1
          ]
        }
      },
      {
        "id": "ars",
        "kind": "decision",
        "prompt": "What do the ARS assays say about each organism's origins?",
        "options": [
          {
            "id": "long-short",
            "label": "Halo: only long fragments replicate (the origin is a large region, cut by short clones); Fung: activity has nothing to do with length (a short sequence motif suffices)"
          },
          {
            "id": "short-long",
            "label": "Halo: a short motif; Fung: a large region"
          }
        ],
        "correctWhen": "if(mean([first(recorded('ARS-length-kb-Halo'))[1], first(recorded('ARS-length-kb-Halo'))[3], first(recorded('ARS-length-kb-Halo'))[5]]) > 1.8 * mean([first(recorded('ARS-length-kb-Halo'))[0], first(recorded('ARS-length-kb-Halo'))[2], first(recorded('ARS-length-kb-Halo'))[4]]) && abs(mean([first(recorded('ARS-length-kb-Fung'))[0], first(recorded('ARS-length-kb-Fung'))[1], first(recorded('ARS-length-kb-Fung'))[3], first(recorded('ARS-length-kb-Fung'))[5]]) - mean([first(recorded('ARS-length-kb-Fung'))[2], first(recorded('ARS-length-kb-Fung'))[4]])) < 0.5 * mean([first(recorded('ARS-length-kb-Fung'))[0], first(recorded('ARS-length-kb-Fung'))[1], first(recorded('ARS-length-kb-Fung'))[3], first(recorded('ARS-length-kb-Fung'))[5]]), 'long-short', 'short-long')"
      },
      {
        "id": "peaks-halo",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "profile-peaks-Mb-Halo",
          "value": [
            1.4
          ]
        }
      },
      {
        "id": "peaks-fung",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "profile-peaks-Mb-Fung",
          "value": [
            0.2,
            0.7,
            1.3,
            1.6,
            2.2,
            2.9,
            3.3,
            3.8
          ]
        }
      },
      {
        "id": "origins",
        "kind": "decision",
        "prompt": "From the replication profiles, how many origins does each genome use, and how does termination differ?",
        "options": [
          {
            "id": "one-many",
            "label": "Halo: one origin and a sharp valley opposite it, so termination at a defined place; Fung: many origins of varying activity, no true valleys, so termination wherever forks meet"
          },
          {
            "id": "many-one",
            "label": "Halo: many; Fung: one"
          }
        ],
        "correctWhen": "if(len(first(recorded('profile-peaks-Mb-Halo'))) == 1 && len(first(recorded('profile-peaks-Mb-Fung'))) > 5, 'one-many', 'many-one')"
      },
      {
        "id": "pulse",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "pulse-min",
          "value": 15
        }
      },
      {
        "id": "stretch",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "kb-per-um",
          "value": 2.0
        }
      },
      {
        "id": "tracks",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "red-track-um",
          "value": [
            9.8,
            10.6,
            11.1,
            10.2,
            9.5
          ]
        }
      },
      {
        "id": "centres",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "origin-centres-um",
          "value": [
            8.0,
            39.0,
            66.5,
            101.0
          ]
        }
      },
      {
        "id": "velocity",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "fork-kb-per-min",
          "value": "=mean([first(recorded('red-track-um'))[0], first(recorded('red-track-um'))[1], first(recorded('red-track-um'))[2], first(recorded('red-track-um'))[3], first(recorded('red-track-um'))[4]]) * first(recorded('kb-per-um')) / first(recorded('pulse-min'))"
        }
      },
      {
        "id": "iod",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "inter-origin-kb",
          "value": "=mean([(first(recorded('origin-centres-um'))[1] - first(recorded('origin-centres-um'))[0]), (first(recorded('origin-centres-um'))[2] - first(recorded('origin-centres-um'))[1]), (first(recorded('origin-centres-um'))[3] - first(recorded('origin-centres-um'))[2])]) * first(recorded('kb-per-um'))"
        }
      },
      {
        "id": "fibres",
        "kind": "decision",
        "prompt": "On a fibre, a green (first pulse) stretch flanked by red (second pulse) on both sides. What happened?",
        "options": [
          {
            "id": "fired-first",
            "label": "An origin fired during the first pulse and two forks moved out from it in both directions"
          },
          {
            "id": "fired-second",
            "label": "It fired during the second pulse"
          },
          {
            "id": "stalled",
            "label": "The forks stalled"
          }
        ],
        "correctWhen": "'fired-first'"
      },
      {
        "id": "flow-halo",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "flow-2C-fraction-Halo",
          "value": [
            0.38,
            0.37,
            0.39,
            0.38,
            0.36,
            0.38,
            0.37,
            0.38
          ]
        }
      },
      {
        "id": "flow-fung",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "flow-2C-fraction-Fung",
          "value": [
            0.03,
            0.06,
            0.22,
            0.55,
            0.82,
            0.94,
            0.97,
            0.99
          ]
        }
      },
      {
        "id": "times",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "flow-times-min",
          "value": [
            0,
            10,
            20,
            30,
            40,
            50,
            60,
            90
          ]
        }
      },
      {
        "id": "s-phase",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "S-phase-min-Fung",
          "value": "=first(recorded('flow-times-min'))[first(filter(i in range(0, 7, 8): first(recorded('flow-2C-fraction-Fung'))[i] > 0.9))] - first(recorded('flow-times-min'))[first(filter(i in range(0, 7, 8): first(recorded('flow-2C-fraction-Fung'))[i] > 0.1))]"
        }
      },
      {
        "id": "sync",
        "kind": "decision",
        "prompt": "Did synchronisation work, and how long is S phase?",
        "options": [
          {
            "id": "b-only",
            "label": "Only Fung: it started with all cells at 1C and moved together to 2C over S phase; Halo did not respond to the arrest"
          },
          {
            "id": "both",
            "label": "Both"
          },
          {
            "id": "a-only",
            "label": "Only Halo"
          }
        ],
        "correctWhen": "if(first(recorded('flow-2C-fraction-Fung'))[0] < 0.1 && first(recorded('flow-2C-fraction-Fung'))[7] > 0.9 && abs(first(recorded('flow-2C-fraction-Halo'))[0] - first(recorded('flow-2C-fraction-Halo'))[7]) < 0.1, 'b-only', 'both')"
      },
      {
        "id": "earth",
        "kind": "decision",
        "prompt": "Which group of Earth organisms is each most like?",
        "options": [
          {
            "id": "bacteria-eukaryote",
            "label": "Halo: bacteria (a circular chromosome, a single origin, defined termination); Fung: eukaryotes or archaea (linear chromosomes, many short-motif origins, dispersed termination)"
          },
          {
            "id": "eukaryote-bacteria",
            "label": "Halo: eukaryotes; Fung: bacteria"
          }
        ],
        "correctWhen": "if(decision('genomes') == 'circular-linear' && decision('origins') == 'one-many', 'bacteria-eukaryote', 'eukaryote-bacteria')"
      }
    ]
  },
  "goals": {
    "predicates": [
      {
        "id": "g-rep",
        "statement": "Every judgement follows from the data, and fork speed is worked out",
        "check": "decision('genomes') == 'circular-linear' && decision('ars') == 'long-short' && decision('origins') == 'one-many' && decision('fibres') == 'fired-first' && decision('sync') == 'b-only' && decision('earth') == 'bacteria-eukaryote' && first(recorded('fork-kb-per-min')) > 1"
      }
    ]
  },
  "variation": {
    "noise": "ideal"
  },
  "provenance": {
    "defaultClass": "reference-standard",
    "review": {
      "status": "draft"
    },
    "annotations": [
      {
        "path": "/procedure",
        "class": "simulation-derived",
        "note": "Illustrative data: Halo bacterial-like, Fung eukaryote-like; forks about 1.4 kb/min."
      }
    ]
  }
}
