  {
    "id": "core:incubate",
    "version": 1,
    "status": "experimental",
    "label": "Incubate",
    "purposes": [
      "condition.incubate",
      "condition.hold-temperature"
    ],
    "params": {
      "container": {
        "type": "container",
        "required": true
      },
      "temperature": {
        "type": "quantity",
        "dimension": "temperature",
        "required": true
      },
      "duration": {
        "type": "quantity",
        "dimension": "time",
        "required": true
      }
    },
    "roles": {
      "place": {
        "kind": "place",
        "requires": {
          "purpose": "condition.incubate",
          "temperature": "=temperature"
        }
      }
