{
  "format": "lab-experiment",
  "formatVersion": "0.1",
  "id": "chem24-calorimetry",
  "version": "1.0.0",
  "title": "Calorimetry: the enthalpy of displacement",
  "language": "en-GB",
  "requires": {
    "framework": ">=0.1",
    "capabilities": [
      {
        "operation": "core:measure"
      }
    ]
  },
  "summary": "Add zinc powder to copper(II) sulfate in a polystyrene cup, follow the temperature, correct for heat loss by extrapolating the cooling line, and calculate the enthalpy change of the reaction.",
  "briefing": "Zinc displaces copper from copper(II) sulfate: Zn + CuSO₄ → ZnSO₄ + Cu. The heat given out warms the solution: q = m c ΔT, with m the mass of solution (taken as its volume of water) and c = 4.18 J g⁻¹ K⁻¹. The cup loses heat while the reaction runs, so the peak underestimates ΔT: extrapolate the cooling line back to the moment the zinc went in. ΔH = −q / n, per mole of the limiting reagent.",
  "context": {
    "intendedContexts": [
      "practical-session",
      "lecture-introduction",
      "assessment"
    ],
    "audience": {
      "level": "{{level}}",
      "disciplines": [
        "chemistry"
      ]
    },
    "keywords": "{{keywords}}",
    "topics": [
      "Energetics",
      "Thermochemistry"
    ],
    "curricula": [
      "GCSE",
      "A level",
      "IB",
      "BTEC"
    ],
    "concepts": [
      {
        "id": "calorimetry",
        "label": "q = m c ΔT and the enthalpy change per mole"
      },
      {
        "id": "heat-loss",
        "label": "Correcting for heat loss by extrapolation"
      }
    ],
    "objectives": "{{objectives}}"
  },
  "parameters": {
    "runs": {
      "default": "=[['zn1', 'Zinc and copper(II) sulfate (1)', 'cuso4', 25, 'zn', 1.5, 'solid', 0, 0.0125], ['zn2', 'Zinc and copper(II) sulfate (2)', 'cuso4', 25, 'zn', 1.5, 'solid', 0, 0.0125]]"
    },
    "supplies": {
      "default": [
        {
          "id": "cuso4",
          "label": "Copper(II) sulfate, 0.50 M",
          "contains": [
            {
              "substance": "aq:copper-ii-sulfate",
              "conc": "0.50 mol/L"
            }
          ],
          "solvent": "core:water",
          "amount": "250 mL",
          "container": "core:reagent-bottle-1l"
        },
        {
          "id": "zn",
          "label": "Zinc powder",
          "contains": [
            {
              "substance": "aq:zinc-powder",
              "purity": "99 %"
            }
          ],
          "amount": "50 g",
          "container": "core:weighing-bottle"
        }
      ]
    },
    "analysis": {
      "default": [
        {
          "id": "mean-dh",
          "kind": "operation",
          "ref": "core:compute",
          "params": {
            "expression": "(a + b) / 2",
            "values": {
              "a": "=first(recorded('dH-zn1'))",
              "b": "=first(recorded('dH-zn2'))"
            },
            "field": "dH-mean"
          }
        },
        {
          "id": "why-excess",
          "kind": "decision",
          "objectives": [
            "o-explain"
          ],
          "prompt": "Why is the zinc in excess, and ΔH worked out per mole of copper(II) sulfate?",
          "options": [
            {
              "id": "limiting",
              "label": "So that all the copper ions react: the copper sulfate is the limiting reagent and fixes the amount reacting"
            },
            {
              "id": "faster",
              "label": "Only to make it faster"
            },
            {
              "id": "zinc-limiting",
              "label": "Because zinc is the limiting reagent"
            }
          ],
          "correctWhen": "choice == 'limiting'"
        }
      ]
    },
    "goals": {
      "default": {
        "predicates": [
          {
            "id": "g-dh",
            "statement": "ΔH for Zn + CuSO₄ is within 15 % of −217 kJ/mol",
            "check": "within(first(recorded('dH-mean')), -217, 15%)"
          },
          {
            "id": "g-explain",
            "statement": "The limiting reagent is identified",
            "check": "decision(why-excess) == 'limiting'"
          }
        ],
        "expectedObservations": [
          {
            "id": "e-rise",
            "statement": "The temperature rises by over 20 K",
            "check": "first(recorded('dT-zn1')) > 20",
            "source": "reference-standard"
          },
          {
            "id": "e-repeat",
            "statement": "The two runs agree within 5 %",
            "check": "within(first(recorded('dH-zn1')), first(recorded('dH-zn2')), 5%)",
            "source": "simulation-derived"
          }
        ]
      }
    },
    "objectives": {
      "default": [
        {
          "id": "o-measure",
          "kind": "skill",
          "statement": "Measure a temperature change in a calorimeter, correcting for heat loss"
        },
        {
          "id": "o-dh",
          "kind": "analysis",
          "statement": "Calculate the enthalpy change of displacement",
          "goal": "g-dh"
        },
        {
          "id": "o-explain",
          "kind": "reasoning",
          "statement": "Explain the choice of reagent in excess",
          "goal": "g-explain"
        }
      ]
    },
    "level": {
      "default": "ages-16-19"
    },
    "keywords": {
      "default": [
        "calorimetry",
        "enthalpy",
        "displacement",
        "zinc",
        "copper sulfate",
        "exothermic",
        "heat loss",
        "extrapolation"
      ]
    }
  },
  "materials": {
    "supplies": "{{supplies}}"
  },
  "equipment": {
    "roles": [
      {
        "id": "thermo",
        "requires": {
          "class": "core:thermometer-digital"
        }
      },
      {
        "id": "balance",
        "requires": {
          "class": "core:balance-2dp"
        }
      }
    ]
  },
  "procedure": {
    "fidelity": "prescribed-tolerant",
    "steps": [
      {
        "id": "runs",
        "kind": "group",
        "title": "Each run",
        "objectives": [
          "o-measure"
        ],
        "forEach": {
          "var": "r",
          "in": "{{runs}}"
        },
        "let": {
          "cup": "='cup-' + r[0]"
        },
        "steps": [
          {
            "id": "cup",
            "kind": "operation",
            "ref": "core:fetch",
            "params": {
              "equipment": "core:calorimeter-cup",
              "id": "=cup",
              "label": "=r[1]"
            }
          },
          {
            "id": "liquid-in",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "=r[2]",
              "destination": "=cup",
              "volume": "=quantity(text(r[3]) + ' mL')",
              "tool": "pour"
            }
          },
          {
            "id": "before",
            "kind": "group",
            "forEach": {
              "var": "k",
              "in": "=range(0, 5, 6)"
            },
            "steps": [
              {
                "id": "wait-before",
                "kind": "operation",
                "ref": "core:advance-time",
                "params": {
                  "duration": "30 s"
                },
                "when": "k > 0"
              },
              {
                "id": "read-before",
                "kind": "operation",
                "ref": "core:measure",
                "params": {
                  "instrument": "thermo",
                  "subject": "=cup"
                }
              },
              {
                "id": "note-temp-before",
                "kind": "operation",
                "ref": "core:record",
                "params": {
                  "field": "='T-' + r[0]",
                  "value": "=read-before.out.value"
                }
              },
              {
                "id": "note-t-before",
                "kind": "operation",
                "ref": "core:record",
                "params": {
                  "field": "='t-' + r[0]",
                  "value": "=k * 30"
                }
              }
            ]
          },
          {
            "id": "to-mixing",
            "kind": "operation",
            "ref": "core:advance-time",
            "params": {
              "duration": "30 s"
            }
          },
          {
            "id": "weigh",
            "kind": "technique",
            "ref": "core:weigh-by-difference",
            "params": {
              "source": "=r[4]",
              "destination": "=cup",
              "mass": "=quantity(text(r[5]) + ' g')"
            },
            "bind": {
              "balance": "balance"
            },
            "when": "r[6] == 'solid'"
          },
          {
            "id": "note-mass",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "='mass-' + r[0]",
              "value": "=weigh.out.delivered"
            },
            "when": "r[6] == 'solid'"
          },
          {
            "id": "pour-in",
            "kind": "operation",
            "ref": "core:transfer",
            "params": {
              "source": "=r[4]",
              "destination": "=cup",
              "volume": "=quantity(text(r[5]) + ' mL')",
              "tool": "pour"
            },
            "when": "r[6] == 'liquid'"
          },
          {
            "id": "stir",
            "kind": "operation",
            "ref": "core:mix",
            "params": {
              "container": "=cup",
              "method": "swirl",
              "cycles": 3
            }
          },
          {
            "id": "after",
            "kind": "group",
            "forEach": {
              "var": "k",
              "in": "=range(7, 20, 14)"
            },
            "steps": [
              {
                "id": "wait-after",
                "kind": "operation",
                "ref": "core:advance-time",
                "params": {
                  "duration": "30 s"
                }
              },
              {
                "id": "stir-after",
                "kind": "operation",
                "ref": "core:mix",
                "params": {
                  "container": "=cup",
                  "method": "swirl",
                  "cycles": 1
                }
              },
              {
                "id": "read-after",
                "kind": "operation",
                "ref": "core:measure",
                "params": {
                  "instrument": "thermo",
                  "subject": "=cup"
                }
              },
              {
                "id": "note-temp-after",
                "kind": "operation",
                "ref": "core:record",
                "params": {
                  "field": "='T-' + r[0]",
                  "value": "=read-after.out.value"
                }
              },
              {
                "id": "note-t-after",
                "kind": "operation",
                "ref": "core:record",
                "params": {
                  "field": "='t-' + r[0]",
                  "value": "=k * 30"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "per-run",
        "kind": "group",
        "title": "Temperature change and ΔH",
        "objectives": [
          "o-dh"
        ],
        "forEach": {
          "var": "r",
          "in": "{{runs}}"
        },
        "let": {
          "T": "=recorded('T-' + r[0])",
          "t": "=recorded('t-' + r[0])",
          "late": "=filter(range(0, len(recorded('t-' + r[0])) - 1, len(recorded('t-' + r[0]))), recorded('t-' + r[0])[it] >= 300)"
        },
        "steps": [
          {
            "id": "cooling",
            "kind": "operation",
            "ref": "core:fit",
            "params": {
              "x": "=map(late, t[it])",
              "y": "=map(late, T[it])",
              "model": "linear",
              "xLabel": "time / s"
            }
          },
          {
            "id": "rise",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "='dT-' + r[0]",
              "value": "=cooling.out.fit.params.intercept + cooling.out.fit.params.slope * 180 - mean(map(range(0, 5, 6), T[it]))"
            }
          },
          {
            "id": "amount",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "='n-' + r[0]",
              "value": "=if(r[6] == 'solid' && r[7] > 0, value(first(recorded('mass-' + r[0])), 'g') / r[7], r[8])"
            }
          },
          {
            "id": "dh",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "='dH-' + r[0]",
              "value": "=-((r[3] + if(r[6] == 'liquid', r[5], 0)) * 4.18 * first(recorded('dT-' + r[0]))) / first(recorded('n-' + r[0])) / 1000"
            }
          }
        ]
      },
      {
        "id": "analysis",
        "kind": "group",
        "title": "Conclusions",
        "steps": "{{analysis}}"
      }
    ]
  },
  "goals": "{{goals}}",
  "variation": {
    "noise": "default"
  },
  "provenance": {
    "defaultClass": "general-knowledge",
    "review": {
      "status": "draft"
    }
  },
  "variants": [
    {
      "id": "chem24-enthalpy-of-solution",
