                0.6054,
                0.7679,
                0.9754,
                1.2265,
                1.5279,
                1.9118,
                2.408
              ]
            }
          },
          {
            "id": "fit-s16k",
            "kind": "data",
            "ref": "core:fit",
            "params": {
              "x": "=map(filter(i in range(0, 25, 26): first(recorded('A-s16k'))[i] > 0.05 && first(recorded('A-s16k'))[i] < 1.4), first(recorded('r-cm-s16k'))[it] ^ 2 / 2)",
              "y": "=map(filter(i in range(0, 25, 26): first(recorded('A-s16k'))[i] > 0.05 && first(recorded('A-s16k'))[i] < 1.4), ln(first(recorded('A-s16k'))[it]))",
              "model": "linear"
            }
          },
          {
            "id": "m-s16k",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "M-s16k",
              "value": "=fit-s16k.out.fit.params.slope * 1e4 * 8.3145 * 293.15 / ((1 - 0.73 * 1.003) * (16000 * 2 * 3.14159265 / 60) ^ 2) * 1000"
            }
          }
        ],
        "objectives": [
          "o-auc"
        ]
      },
      {
        "id": "mean-s",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "M-mean-s",
          "value": "=mean([first(recorded('M-s8k')), first(recorded('M-s12k')), first(recorded('M-s16k'))])"
        },
        "objectives": [
          "o-auc"
        ]
      },
      {
        "id": "state",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "subunits",
          "value": "=round(first(recorded('M-mean-s')) / 52000)"
        },
        "objectives": [
          "o-auc"
        ]
      },
      {
        "id": "sec-mw",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "SEC-kDa",
          "value": "=exp((12.82 - 39.4) / -2.23) / 1000"
        },
        "objectives": [
          "o-auc"
        ]
      },
      {
        "id": "oligomer",
        "kind": "decision",
        "objectives": [
          "o-auc"
        ],
        "prompt": "The subunit is 52 kDa by SDS-PAGE. What is the protein in solution?",
        "options": [
          {
            "id": "dimer",
            "label": "A dimer: seAUC gives about 104 kDa at every speed; SEC's larger figure (about 150 kDa) is the shape, not the mass"
          },
          {
            "id": "monomer",
            "label": "A monomer"
          },
          {
            "id": "tetramer",
            "label": "A tetramer"
          }
        ],
        "correctWhen": "if(first(recorded('subunits')) == 2, 'dimer', if(first(recorded('subunits')) == 1, 'monomer', 'tetramer'))"
      },
      {
        "id": "speeds",
        "kind": "decision",
        "objectives": [
          "o-auc"
        ],
        "prompt": "Why record at several speeds?",
        "options": [
          {
            "id": "consistency",
            "label": "A single, non-associating species gives the same M at every speed; a drift with speed would point to a mixture or self-association"
          },
          {
            "id": "average",
            "label": "Only to average the noise"
          }
        ],
        "correctWhen": "if(abs(first(recorded('M-s8k')) - first(recorded('M-s16k'))) < 0.05 * first(recorded('M-mean-s')), 'consistency', 'average')"
      },
      {
        "id": "why-shape",
        "kind": "decision",
        "objectives": [
          "o-auc"
        ],
        "prompt": "SEC puts the protein near 150 kDa, seAUC at 104 kDa. Why the difference?",
        "options": [
          {
            "id": "shape",
            "label": "SEC separates by hydrodynamic size, so an elongated protein runs larger than its mass; sedimentation equilibrium depends on mass (and v̄), not shape"
          },
          {
            "id": "none",
            "label": "One of them is simply wrong"
          }
        ],
        "correctWhen": "if(first(recorded('SEC-kDa')) > 1.25 * first(recorded('M-mean-s')) / 1000, 'shape', 'none')"
      }
    ]
  },
  "goals": {
    "predicates": [
      {
        "id": "g-auc",
        "statement": "M is found within 5 % at each speed and the state read correctly",
        "check": "within(first(recorded('M-s8k')), 104000, 5%) && within(first(recorded('M-s12k')), 104000, 5%) && within(first(recorded('M-s16k')), 104000, 5%) && decision('oligomer') == 'dimer' && decision('speeds') == 'consistency' && decision('why-shape') == 'shape'"
      }
    ],
    "expectedObservations": [
      {
        "id": "e-sec",
        "statement": "SEC overestimates it (an elongated dimer), near 150 kDa",
        "check": "between(first(recorded('SEC-kDa')), 135, 165)",
        "source": "simulation-derived"
      }
    ]
  },
  "variation": {
    "noise": "ideal"
  },
  "provenance": {
    "defaultClass": "reference-standard",
    "review": {
      "status": "draft"
    },
    "annotations": [
      {
        "path": "/procedure",
        "class": "simulation-derived",
        "note": "Scans generated for a 104 kDa species (v̄ 0.73, ρ 1.003, 20 °C), mean absorbance 0.45, 1 % proportional and 0.003 AU noise."
      }
    ]
  }
