          "buffer": "wash",
          "volume": "300 uL",
          "cycles": 3
        }
      },
      {
        "id": "diluent",
        "kind": "technique",
        "ref": "core:dispense-reagent",
        "params": {
          "reagent": "assay",
          "volume": "100 uL",
          "into": "=['plate/A1', 'plate/A2', 'plate/A3', 'plate/A4', 'plate/A5', 'plate/A6', 'plate/A7', 'plate/A8', 'plate/A9', 'plate/A12', 'plate/B1', 'plate/B2', 'plate/B3', 'plate/B4', 'plate/B5', 'plate/B6', 'plate/B7', 'plate/B8', 'plate/B9', 'plate/B12', 'plate/C1', 'plate/C2', 'plate/C3', 'plate/C4', 'plate/C5', 'plate/C6', 'plate/C7', 'plate/C8', 'plate/C9', 'plate/C12', 'plate/D1', 'plate/D2', 'plate/D3', 'plate/D4', 'plate/D5', 'plate/D6', 'plate/D7', 'plate/D8', 'plate/D9', 'plate/D12', 'plate/E1', 'plate/E2', 'plate/E3', 'plate/E4', 'plate/E5', 'plate/E6', 'plate/E7', 'plate/E8', 'plate/E9', 'plate/E12', 'plate/F1', 'plate/F2', 'plate/F3', 'plate/F4', 'plate/F5', 'plate/F6', 'plate/F7', 'plate/F8', 'plate/F9', 'plate/F12', 'plate/G1', 'plate/G2', 'plate/G3', 'plate/G4', 'plate/G5', 'plate/G6', 'plate/G7', 'plate/G8', 'plate/G9', 'plate/G12', 'plate/H1', 'plate/H2', 'plate/H3', 'plate/H4', 'plate/H5', 'plate/H6', 'plate/H7', 'plate/H8', 'plate/H9', 'plate/H12']"
