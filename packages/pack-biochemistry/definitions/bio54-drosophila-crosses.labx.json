{
  "format": "lab-experiment",
  "formatVersion": "0.1",
  "version": "1.0.0",
  "language": "en-GB",
  "requires": {
    "framework": ">=0.1"
  },
  "variation": {
    "noise": "default"
  },
  "provenance": {
    "defaultClass": "general-knowledge",
    "review": {
      "status": "draft"
    }
  },
  "id": "bio54-drosophila-crosses",
  "title": "{{title}}",
  "summary": "{{summary}}",
  "briefing": "{{briefing}}",
  "context": {
    "intendedContexts": [
      "practical-session",
      "assessment"
    ],
    "audience": {
      "level": "ages-16-19",
      "disciplines": [
        "biology",
        "genetics"
      ]
    },
    "keywords": [
      "Drosophila",
      "monohybrid cross",
      "Mendel",
      "chi-squared test",
      "dominant",
      "recessive"
    ],
    "topics": [
      "Inheritance"
    ],
    "concepts": [
      {
        "id": "segregation",
        "label": "Each parent passes on one of its two alleles at random, so an F2 of a monohybrid cross shows 3 : 1"
      }
    ],
    "objectives": [
      {
        "id": "o-cross",
        "kind": "skill",
        "statement": "Set up crosses of fruit flies and score the offspring"
      },
      {
        "id": "o-ratio",
        "kind": "analysis",
        "statement": "{{ratioObjective}}",
        "goal": "g-ratio"
      },
      {
        "id": "o-explain",
        "kind": "reasoning",
        "statement": "Interpret the chi-squared test",
        "goal": "g-explain"
      }
    ],
    "curricula": [
      "A level",
      "IB",
      "AP"
    ]
  },
  "parameters": {
    "title": {
      "default": "Fruit fly crosses: a monohybrid cross and the chi-squared test"
    },
    "summary": {
      "default": "Cross vestigial-winged females with wild-type males, score the F1, cross F1 flies together, score the F2, and test the 3 : 1 ratio with chi-squared."
    },
    "briefing": {
      "default": "Put five virgin vestigial-winged females and five wild-type males in a vial at 25 °C; clear the parents after a week. After about ten days etherise the F1 and score them. Put 10 F1 females and 10 F1 males in a fresh vial, and score the F2 ten days later. χ² = Σ(O − E)²/E with one degree of freedom: below 3.84, the difference from 3 : 1 is not significant (p > 0.05)."
    },
    "ratioObjective": {
      "default": "Test the F2 against 3 : 1"
    },
    "strains": {
      "default": "bio:dros-vestigial"
    },
    "analysis": {
      "default": {
        "id": "analysis",
        "kind": "group",
        "title": "Analyse the F2",
        "steps": [
          {
            "id": "n-wt",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "F2 wild type",
              "value": "=coalesce(f2.out.counts['wild type'], 0)"
            }
          },
          {
            "id": "n-vg",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "F2 vestigial",
              "value": "=coalesce(f2.out.counts['vestigial wings'], 0)"
            }
          },
          {
            "id": "chi",
            "kind": "operation",
            "ref": "core:record",
            "params": {
              "field": "chi-squared",
              "value": "=(first(recorded('F2 wild type')) - 0.75 * (first(recorded('F2 wild type')) + first(recorded('F2 vestigial')))) * (first(recorded('F2 wild type')) - 0.75 * (first(recorded('F2 wild type')) + first(recorded('F2 vestigial')))) / (0.75 * (first(recorded('F2 wild type')) + first(recorded('F2 vestigial')))) + (first(recorded('F2 vestigial')) - 0.25 * (first(recorded('F2 wild type')) + first(recorded('F2 vestigial')))) * (first(recorded('F2 vestigial')) - 0.25 * (first(recorded('F2 wild type')) + first(recorded('F2 vestigial')))) / (0.25 * (first(recorded('F2 wild type')) + first(recorded('F2 vestigial'))))"
            },
            "objectives": [
              "o-ratio"
            ]
          },
          {
            "id": "why",
            "kind": "decision",
            "objectives": [
              "o-explain"
            ],
            "prompt": "Does the F2 fit a 3 : 1 ratio?",
            "options": [
              {
                "id": "fits",
                "label": "Yes: χ² is below 3.84, so the difference from 3 : 1 is due to chance"
              },
              {
                "id": "differs",
                "label": "No: χ² is above 3.84, so the difference is significant"
              }
            ],
            "correctWhen": "choice == if(first(recorded('chi-squared')) < 3.84, 'fits', 'differs')"
          }
        ]
      }
    },
    "goals": {
      "default": {
        "predicates": [
          {
            "id": "g-ratio",
            "statement": "The F1 are all wild type and the F2 close to 3 : 1",
            "check": "first(recorded('F1')) == 'wild type' && first(recorded('F2 wild type')) / first(recorded('F2 vestigial')) > 2.4 && first(recorded('F2 wild type')) / first(recorded('F2 vestigial')) < 3.8"
          },
          {
            "id": "g-explain",
            "statement": "The chi-squared test is read correctly",
            "check": "decision('why') == if(first(recorded('chi-squared')) < 3.84, 'fits', 'differs')"
          }
        ],
        "expectedObservations": [
          {
            "id": "e-chi",
            "statement": "The F2 usually fits 3 : 1 (χ² < 3.84)",
            "check": "first(recorded('chi-squared')) < 3.84",
            "source": "reference-standard"
          }
        ]
      }
    }
  },
  "equipment": {
    "roles": [
      {
        "id": "lens",
        "requires": {
          "class": "core:hand-lens"
        }
      },
      {
        "id": "incubator",
        "requires": {
          "class": "core:incubator",
          "temperature": "25 Cel"
        }
      }
    ]
  },
  "procedure": {
    "fidelity": "prescribed-tolerant",
    "steps": [
      {
        "id": "warm",
        "kind": "operation",
        "ref": "core:set-environment",
        "params": {
          "device": "incubator",
          "temperature": "25 Cel"
        }
      },
      {
        "id": "v-p",
        "kind": "operation",
        "ref": "core:fetch",
        "params": {
          "equipment": "core:fly-vial",
          "id": "p",
          "label": "Parents (P)"
        }
      },
      {
        "id": "in-p",
        "kind": "operation",
        "ref": "core:place-in",
        "params": {
          "container": "p",
          "place": "incubator"
        }
      },
      {
        "id": "mothers",
        "kind": "operation",
        "ref": "core:add-flies",
        "params": {
          "strain": "{{strains}}",
          "destination": "p",
          "females": 5
        },
        "objectives": [
          "o-cross"
        ]
      },
      {
        "id": "fathers",
        "kind": "operation",
        "ref": "core:add-flies",
        "params": {
          "strain": "bio:dros-wild-type",
          "destination": "p",
          "males": 5
        },
        "objectives": [
          "o-cross"
        ]
      },
      {
        "id": "gen-f1",
        "kind": "operation",
        "ref": "core:advance-time",
        "params": {
          "duration": "11 d"
        }
      },
      {
        "id": "f1",
        "kind": "operation",
        "ref": "core:measure",
        "params": {
          "instrument": "lens",
          "subject": "p"
        },
        "objectives": [
          "o-cross"
        ]
      },
      {
        "id": "n-f1",
        "kind": "operation",
        "ref": "core:record",
        "params": {
          "field": "F1",
          "value": "=if(coalesce(f1.out.counts['wild type'], 0) == f1.out.total, 'wild type', 'mixed')"
        }
      },
      {
        "id": "v-x",
        "kind": "operation",
        "ref": "core:fetch",
        "params": {
          "equipment": "core:fly-vial",
          "id": "x",
          "label": "F1 × F1"
        }
      },
      {
        "id": "in-x",
        "kind": "operation",
        "ref": "core:place-in",
        "params": {
          "container": "x",
          "place": "incubator"
        }
      },
      {
        "id": "f1-cross",
        "kind": "operation",
        "ref": "core:transfer-flies",
        "params": {
          "source": "p",
          "destination": "x",
          "females": 10,
          "males": 10
        },
        "objectives": [
          "o-cross"
        ]
      },
      {
        "id": "gen-f2",
        "kind": "operation",
        "ref": "core:advance-time",
        "params": {
          "duration": "11 d"
        }
      },
      {
        "id": "f2",
        "kind": "operation",
        "ref": "core:measure",
        "params": {
          "instrument": "lens",
          "subject": "x"
        },
        "objectives": [
          "o-cross"
        ]
      },
      "{{analysis}}"
    ]
  },
  "goals": "{{goals}}",
  "variants": [
    {
      "id": "bio54-drosophila-dihybrid",
      "title": "Fruit fly crosses: a dihybrid cross",
      "summary": "Cross vestigial-winged, ebony-bodied females with wild-type males, interbreed the F1, and test the F2 against 9 : 3 : 3 : 1.",
      "briefing": "As for the monohybrid cross, with females that are both vestigial (chromosome 2) and ebony (chromosome 3). Genes on different chromosomes assort independently, so the F2 should be 9 wild type : 3 vestigial : 3 ebony : 1 vestigial ebony. χ² has three degrees of freedom: the critical value at p = 0.05 is 7.81.",
      "values": {
        "ratioObjective": "Test the F2 against 9 : 3 : 3 : 1",
        "strains": "bio:dros-vestigial-ebony",
        "analysis": {
          "id": "analysis",
          "kind": "group",
          "title": "Analyse the F2",
          "steps": [
            {
              "id": "n-wt",
              "kind": "operation",
              "ref": "core:record",
              "params": {
                "field": "F2 wild type",
                "value": "=coalesce(f2.out.counts['wild type'], 0)"
              }
            },
            {
              "id": "n-vg",
              "kind": "operation",
              "ref": "core:record",
              "params": {
                "field": "F2 vestigial",
                "value": "=coalesce(f2.out.counts['vestigial wings'], 0)"
              }
            },
            {
              "id": "n-e",
              "kind": "operation",
              "ref": "core:record",
              "params": {
                "field": "F2 ebony",
                "value": "=coalesce(f2.out.counts['ebony body'], 0)"
              }
            },
            {
              "id": "n-vge",
              "kind": "operation",
              "ref": "core:record",
              "params": {
                "field": "F2 vestigial ebony",
                "value": "=coalesce(f2.out.counts['vestigial wings, ebony body'], 0)"
              }
            },
            {
              "id": "total",
              "kind": "operation",
              "ref": "core:record",
              "params": {
                "field": "F2 total",
                "value": "=first(recorded('F2 wild type')) + first(recorded('F2 vestigial')) + first(recorded('F2 ebony')) + first(recorded('F2 vestigial ebony'))"
              }
            },
            {
              "id": "chi",
              "kind": "operation",
              "ref": "core:record",
              "params": {
                "field": "chi-squared",
                "value": "=(first(recorded('F2 wild type')) - first(recorded('F2 total')) * 9 / 16) * (first(recorded('F2 wild type')) - first(recorded('F2 total')) * 9 / 16) / (first(recorded('F2 total')) * 9 / 16) + (first(recorded('F2 vestigial')) - first(recorded('F2 total')) * 3 / 16) * (first(recorded('F2 vestigial')) - first(recorded('F2 total')) * 3 / 16) / (first(recorded('F2 total')) * 3 / 16) + (first(recorded('F2 ebony')) - first(recorded('F2 total')) * 3 / 16) * (first(recorded('F2 ebony')) - first(recorded('F2 total')) * 3 / 16) / (first(recorded('F2 total')) * 3 / 16) + (first(recorded('F2 vestigial ebony')) - first(recorded('F2 total')) / 16) * (first(recorded('F2 vestigial ebony')) - first(recorded('F2 total')) / 16) / (first(recorded('F2 total')) / 16)"
              },
              "objectives": [
                "o-ratio"
              ]
            },
            {
              "id": "why",
              "kind": "decision",
              "objectives": [
                "o-explain"
              ],
              "prompt": "Does the F2 fit 9 : 3 : 3 : 1?",
              "options": [
                {
                  "id": "fits",
                  "label": "Yes: χ² is below 7.81 (three degrees of freedom), so the genes assort independently"
                },
                {
                  "id": "differs",
                  "label": "No: χ² is above 7.81"
                }
              ],
              "correctWhen": "choice == if(first(recorded('chi-squared')) < 7.81, 'fits', 'differs')"
            }
          ]
        },
        "goals": {
          "predicates": [
            {
              "id": "g-ratio",
              "statement": "The F2 shows all four classes, wild type most and vestigial ebony fewest",
              "check": "first(recorded('F2 wild type')) > first(recorded('F2 vestigial')) && first(recorded('F2 wild type')) > first(recorded('F2 ebony')) && first(recorded('F2 vestigial ebony')) > 0 && first(recorded('F2 vestigial ebony')) < first(recorded('F2 vestigial')) && first(recorded('F2 vestigial ebony')) < first(recorded('F2 ebony'))"
            },
            {
              "id": "g-explain",
              "statement": "The chi-squared test is read correctly",
              "check": "decision('why') == if(first(recorded('chi-squared')) < 7.81, 'fits', 'differs')"
            }
          ],
          "expectedObservations": [
            {
              "id": "e-chi",
              "statement": "The F2 usually fits 9 : 3 : 3 : 1 (χ² < 7.81)",
              "check": "first(recorded('chi-squared')) < 7.81",
              "source": "reference-standard"
            }
          ]
        }
      },
      "keywords": [
        "dihybrid cross",
        "independent assortment",
        "9 : 3 : 3 : 1"
      ]
    },
    {
      "id": "bio54-drosophila-sex-linked",
      "title": "Fruit fly crosses: a sex-linked gene",
      "summary": "Cross white-eyed females with red-eyed (wild-type) males and score the F1 and F2 by sex: white eyes follow the X chromosome.",
      "briefing": "As for the monohybrid cross, with white-eyed females. The white gene is on the X chromosome: sons get their only X from their mother, so in the F1 every son is white-eyed and every daughter red-eyed. Score each generation by sex.",
      "values": {
        "ratioObjective": "Explain the F1 and F2 by sex linkage",
        "strains": "bio:dros-white",
        "analysis": {
          "id": "analysis",
          "kind": "group",
          "title": "Analyse the F2",
          "steps": [
            {
              "id": "n-wf",
              "kind": "operation",
              "ref": "core:record",
              "params": {
                "field": "F2 white-eyed females",
                "value": "=coalesce(f2.out.females['white eyes'], 0)"
              }
            },
            {
              "id": "n-rf",
              "kind": "operation",
              "ref": "core:record",
              "params": {
                "field": "F2 red-eyed females",
                "value": "=coalesce(f2.out.females['wild type'], 0)"
              }
            },
            {
              "id": "n-wm",
              "kind": "operation",
              "ref": "core:record",
              "params": {
                "field": "F2 white-eyed males",
                "value": "=coalesce(f2.out.males['white eyes'], 0)"
              }
            },
            {
              "id": "n-rm",
              "kind": "operation",
              "ref": "core:record",
              "params": {
                "field": "F2 red-eyed males",
                "value": "=coalesce(f2.out.males['wild type'], 0)"
              }
            },
            {
              "id": "n-f1m",
              "kind": "operation",
              "ref": "core:record",
              "params": {
                "field": "F1 males",
                "value": "=if(coalesce(f1.out.males['wild type'], 0) == 0, 'white eyes', 'mixed')"
              }
            },
            {
              "id": "n-f1f",
              "kind": "operation",
              "ref": "core:record",
              "params": {
                "field": "F1 females",
                "value": "=if(coalesce(f1.out.females['white eyes'], 0) == 0, 'wild type', 'mixed')"
              }
            },
            {
              "id": "why",
              "kind": "decision",
              "objectives": [
                "o-explain"
              ],
              "prompt": "Why are all the F1 sons white-eyed but none of the daughters?",
              "options": [
                {
                  "id": "x",
                  "label": "Sons get their one X from their white-eyed mother; daughters also get a normal X from their father, and the white allele is recessive"
                },
                {
                  "id": "sex",
                  "label": "White eyes are only possible in males"
                },
                {
                  "id": "chance",
                  "label": "It happened by chance"
                }
              ],
              "correctWhen": "choice == 'x'"
            }
          ]
        },
        "goals": {
          "predicates": [
            {
              "id": "g-ratio",
              "statement": "F1: sons white-eyed, daughters red-eyed; F2: about half of each sex white-eyed",
              "check": "first(recorded('F1 males')) == 'white eyes' && first(recorded('F1 females')) == 'wild type' && abs(first(recorded('F2 white-eyed females')) / (first(recorded('F2 white-eyed females')) + first(recorded('F2 red-eyed females'))) - 0.5) < 0.1 && abs(first(recorded('F2 white-eyed males')) / (first(recorded('F2 white-eyed males')) + first(recorded('F2 red-eyed males'))) - 0.5) < 0.1"
            },
            {
              "id": "g-explain",
              "statement": "Sex linkage is explained",
              "check": "decision('why') == 'x'"
            }
          ],
          "expectedObservations": [
            {
              "id": "e-f1",
              "statement": "No white-eyed daughters in the F1",
              "check": "first(recorded('F1 females')) == 'wild type'",
              "source": "reference-standard"
            }
          ]
        }
      },
      "keywords": [
        "sex linkage",
        "X chromosome",
        "white eyes",
        "reciprocal cross"
      ]
    }
  ]
}
